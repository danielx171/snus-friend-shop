{
  "name": "snus-friend-shop",
  "private": true,
  "version": "1.6.1",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "astro dev --port 8080",
    "og:gen": "bun run scripts/generate-og-images.ts",
    "build": "bun run og:gen && astro build",
    "build:astro": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "bash scripts/smoke-check.sh",
    "audit:ga4": "bun run scripts/google-ga4-report.ts",
    "audit:gsc": "bun run scripts/google-search-console-report.ts",
    "audit:gsc:sync": "bun run scripts/google-search-console-sync.ts",
    "audit:preflight": "bun run scripts/measurement-preflight.ts",
    "audit:pagespeed": "bun run scripts/pagespeed-audit.ts",
    "audit:pagespeed:sync": "bun run scripts/pagespeed-sync.ts",
    "audit:measurement:smoke": "bun run scripts/measurement-smoke.ts",
    "audit:rank": "bun run scripts/rank-audit.ts",
    "indexnow": "bun run scripts/indexnow-ping.ts",
    "indexnow:dry": "bun run scripts/indexnow-ping.ts --dry-run",
    "sitemap": "bun run scripts/generate-sitemap.ts",
    "images:download": "bun run scripts/download-product-images.ts",
    "images:upload": "bun run scripts/upload-images-to-supabase.ts",
    "init": "bun install && bunx vercel env pull .env.local --yes && bun run build"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.3",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.1",
    "@astrojs/vercel": "^10.0.4",
    "@nanostores/persistent": "^1.3.3",
    "@nanostores/react": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.3",
    "@tailwindcss/vite": "4.1.8",
    "@tanstack/react-query": "^5.83.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^6.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.462.0",
    "nanostores": "^1.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "satori": "^0.26.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "4.1.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@eslint/js": "^9.32.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22.16.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^29.0.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
