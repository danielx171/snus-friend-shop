---
interface Props {
  data?: unknown;
  items?: unknown[];
}

const { data, items = [] } = Astro.props;

const schemas = [
  ...items,
  ...(data == null ? [] : Array.isArray(data) ? data : [data]),
];
---

{schemas.map((schema) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
