---
export const prerender = false;

import Shop from '@/layouts/Shop.astro';
import Breadcrumb from '@/components/astro/Breadcrumb.astro';
import { tenant } from '@/config/tenant';

// Auth check — redirect to login if not signed in
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login?redirect=/suggestions');
}

const supabase = Astro.locals.supabase;

let formError = '';
let formSuccess = '';

// Handle POST actions (submit suggestion or vote)
if (Astro.request.method === 'POST' && supabase) {
  const formData = await Astro.request.formData();
  const action = formData.get('_action') as string;

  if (action === 'submit') {
    const title = (formData.get('title') as string ?? '').trim();
    const description = (formData.get('description') as string ?? '').trim();

    if (title.length < 5 || title.length > 100) {
      formError = 'Title must be between 5 and 100 characters.';
    } else if (description && description.length > 500) {
      formError = 'Description must be under 500 characters.';
    } else {
      const { error } = await supabase.from('feature_suggestions').insert({
        user_id: user.id,
        title,
        description: description || null,
      });
      if (error) {
        console.error('suggestion insert error', error);
        formError = 'Something went wrong. Please try again.';
      } else {
        formSuccess = 'Your suggestion has been submitted!';
      }
    }
  } else if (action === 'vote') {
    const suggestionId = formData.get('suggestion_id') as string;
    if (suggestionId) {
      // Check if already voted
      const { data: existingVote } = await supabase
        .from('suggestion_votes')
        .select('suggestion_id')
        .eq('user_id', user.id)
        .eq('suggestion_id', suggestionId)
        .maybeSingle();

      if (existingVote) {
        // Remove vote
        await supabase
          .from('suggestion_votes')
          .delete()
          .eq('user_id', user.id)
          .eq('suggestion_id', suggestionId);
        // Decrement count
        const { data: current } = await supabase
          .from('feature_suggestions')
          .select('votes')
          .eq('id', suggestionId)
          .single();
        if (current) {
          await supabase
            .from('feature_suggestions')
            .update({ votes: Math.max(0, current.votes - 1) })
            .eq('id', suggestionId);
        }
      } else {
        // Add vote
        await supabase
          .from('suggestion_votes')
          .insert({ user_id: user.id, suggestion_id: suggestionId });
        // Increment count
        const { data: current } = await supabase
          .from('feature_suggestions')
          .select('votes')
          .eq('id', suggestionId)
          .single();
        if (current) {
          await supabase
            .from('feature_suggestions')
            .update({ votes: current.votes + 1 })
            .eq('id', suggestionId);
        }
      }
    }
  }
}

// Fetch suggestions
let suggestions: Array<{
  id: string;
  title: string;
  description: string | null;
  votes: number;
  status: string;
  created_at: string;
}> = [];

let userVotedIds: Set<string> = new Set();

if (supabase) {
  const { data } = await supabase
    .from('feature_suggestions')
    .select('id, title, description, votes, status, created_at')
    .order('votes', { ascending: false })
    .order('created_at', { ascending: false })
    .limit(30);
  suggestions = data ?? [];

  // Get user's votes
  if (suggestions.length > 0) {
    const { data: votes } = await supabase
      .from('suggestion_votes')
      .select('suggestion_id')
      .eq('user_id', user.id);
    if (votes) {
      userVotedIds = new Set(votes.map((v: { suggestion_id: string }) => v.suggestion_id));
    }
  }
}

function timeAgo(dateStr: string): string {
  const now = Date.now();
  const then = new Date(dateStr).getTime();
  const diff = now - then;
  const minutes = Math.floor(diff / 60000);
  if (minutes < 1) return 'just now';
  if (minutes < 60) return `${minutes}m ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  if (days < 30) return `${days}d ago`;
  const months = Math.floor(days / 30);
  return `${months}mo ago`;
}

const statusColors: Record<string, { bg: string; text: string; label: string }> = {
  open: { bg: 'bg-blue-500/15', text: 'text-blue-400', label: 'Open' },
  planned: { bg: 'bg-amber-500/15', text: 'text-amber-400', label: 'Planned' },
  shipped: { bg: 'bg-emerald-500/15', text: 'text-emerald-400', label: 'Shipped' },
  declined: { bg: 'bg-red-500/15', text: 'text-red-400', label: 'Declined' },
};
---

<Shop
  title={`Suggest a Feature | Help Us Build ${tenant.name}`}
  description="Submit your ideas for new features, products, and improvements. The best suggestions earn SnusPoints and the Pioneer badge."
  canonical="/suggestions"
>
  <Breadcrumb items={[
    { label: 'Community', href: '/community' },
    { label: 'Suggestions' }
  ]} />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">

    <!-- Hero -->
    <div class="relative mb-10 overflow-hidden rounded-2xl px-6 py-10 sm:px-10 sm:py-14" style="background: linear-gradient(135deg, hsl(var(--card)) 0%, hsl(var(--background)) 100%); border: 1px solid hsl(var(--border));">
      <div class="relative z-10 max-w-2xl">
        <span class="mb-3 inline-block rounded-full bg-primary/15 px-3 py-1 text-xs font-semibold text-primary border border-primary/25">
          Community-Driven
        </span>
        <h1 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
          Build SnusFriend With Us
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
          Got an idea that would make this place better? Drop it here. The best suggestions get built -- and you get the credit.
        </p>
      </div>
    </div>

    <!-- How it works -->
    <section class="mb-12">
      <h2 class="mb-6 text-2xl font-bold text-foreground">How It Works</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-border bg-card/50 p-5 backdrop-blur">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-primary/15 text-primary font-bold text-lg">1</div>
          <h3 class="mb-1 font-semibold text-foreground">Submit Your Idea</h3>
          <p class="text-sm text-muted-foreground">Describe what you want and why it matters -- one sentence is enough, but detail helps.</p>
        </div>
        <div class="rounded-xl border border-border bg-card/50 p-5 backdrop-blur">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-primary/15 text-primary font-bold text-lg">2</div>
          <h3 class="mb-1 font-semibold text-foreground">The Community Votes</h3>
          <p class="text-sm text-muted-foreground">Other members upvote the suggestions they want most. Popular ideas rise to the top.</p>
        </div>
        <div class="rounded-xl border border-border bg-card/50 p-5 backdrop-blur">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-primary/15 text-primary font-bold text-lg">3</div>
          <h3 class="mb-1 font-semibold text-foreground">We Build It</h3>
          <p class="text-sm text-muted-foreground">Our team reviews the most-requested ideas each month and ships the best ones.</p>
        </div>
        <div class="rounded-xl border border-border bg-card/50 p-5 backdrop-blur">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-primary/15 text-primary font-bold text-lg">4</div>
          <h3 class="mb-1 font-semibold text-foreground">You Get Rewarded</h3>
          <p class="text-sm text-muted-foreground">If your suggestion ships, you earn the exclusive Pioneer badge and 200 SnusPoints.</p>
        </div>
      </div>
    </section>

    <!-- Guidelines -->
    <section class="mb-12">
      <h2 class="mb-6 text-2xl font-bold text-foreground">Guidelines</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-border bg-card/50 p-5 backdrop-blur">
          <h3 class="mb-3 font-semibold text-foreground">What makes a great suggestion</h3>
          <ul class="space-y-2 text-sm text-muted-foreground">
            <li>Be specific. "Add a flavour comparison tool" is better than "make the site better."</li>
            <li>Focus on something that would help you or other pouch users. Features, content, tools, UX improvements -- all fair game.</li>
            <li>Check existing suggestions first. If someone already posted your idea, upvote theirs instead of duplicating it.</li>
            <li>One idea per submission. If you have three ideas, submit three times.</li>
            <li>Keep it constructive. Criticism is welcome when it comes with a solution.</li>
          </ul>
        </div>
        <div class="rounded-xl border border-border bg-card/50 p-5 backdrop-blur">
          <h3 class="mb-3 font-semibold text-foreground">What is out of scope</h3>
          <ul class="space-y-2 text-sm text-muted-foreground">
            <li>Requests for specific product stock or pricing changes (that is a purchasing decision, not a feature)</li>
            <li>Anything that requires us to break our own policies (age verification, legal compliance, etc.)</li>
            <li>Personal support tickets -- use the <a href="/contact" class="text-primary underline hover:text-foreground">contact page</a> for order issues</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Suggestion form -->
    <section class="mb-12">
      <h2 class="mb-6 text-2xl font-bold text-foreground">Submit a Suggestion</h2>

      {formError && (
        <div class="mb-4 mx-auto max-w-xl rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400">
          {formError}
        </div>
      )}
      {formSuccess && (
        <div class="mb-4 mx-auto max-w-xl rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-400">
          {formSuccess}
        </div>
      )}

      <form
        method="POST"
        class="mx-auto max-w-xl space-y-4 rounded-2xl border border-border bg-card/50 p-6 backdrop-blur sm:p-8"
      >
        <input type="hidden" name="_action" value="submit" />
        <div>
          <label for="suggestion-title" class="mb-1.5 block text-sm font-medium text-foreground">
            Your idea in one sentence
          </label>
          <input
            id="suggestion-title"
            name="title"
            type="text"
            placeholder="e.g. Add a price drop alert for my favourite products"
            minlength="5"
            maxlength="100"
            required
            class="w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/60 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          />
        </div>
        <div>
          <label for="suggestion-description" class="mb-1.5 block text-sm font-medium text-foreground">
            Tell us more <span class="text-muted-foreground">(optional)</span>
          </label>
          <textarea
            id="suggestion-description"
            name="description"
            placeholder="Why would this be useful? How would it work?"
            maxlength="500"
            rows="4"
            class="w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/60 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary resize-y"
          ></textarea>
        </div>
        <button
          type="submit"
          class="w-full rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition hover:brightness-110 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background"
        >
          Submit Suggestion
        </button>
      </form>
    </section>

    <!-- Suggestions list -->
    {suggestions.length > 0 && (
      <section class="mb-12">
        <h2 class="mb-6 text-2xl font-bold text-foreground">
          Community Suggestions
          <span class="ml-2 text-base font-normal text-muted-foreground">({suggestions.length})</span>
        </h2>
        <div class="space-y-3">
          {suggestions.map((s) => {
            const voted = userVotedIds.has(s.id);
            const status = statusColors[s.status] ?? statusColors.open;
            return (
              <div class="flex items-start gap-4 rounded-xl border border-border bg-card/50 p-4 backdrop-blur sm:p-5">
                {/* Vote button */}
                <form method="POST" class="shrink-0">
                  <input type="hidden" name="_action" value="vote" />
                  <input type="hidden" name="suggestion_id" value={s.id} />
                  <button
                    type="submit"
                    aria-label={voted ? `Remove vote from "${s.title}"` : `Vote for "${s.title}"`}
                    class:list={[
                      'flex flex-col items-center gap-0.5 rounded-lg border px-3 py-2 text-sm font-semibold transition',
                      voted
                        ? 'border-primary/40 bg-primary/15 text-primary'
                        : 'border-border bg-background text-muted-foreground hover:border-primary/30 hover:text-primary',
                    ]}
                  >
                    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M10 17a.75.75 0 01-.75-.75V5.612L5.29 9.77a.75.75 0 01-1.08-1.04l5.25-5.5a.75.75 0 011.08 0l5.25 5.5a.75.75 0 11-1.08 1.04l-3.96-4.158V16.25A.75.75 0 0110 17z" clip-rule="evenodd" />
                    </svg>
                    <span>{s.votes}</span>
                  </button>
                </form>

                {/* Content */}
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="font-semibold text-foreground">{s.title}</h3>
                    <span class:list={['inline-flex rounded-full px-2 py-0.5 text-xs font-medium', status.bg, status.text]}>
                      {status.label}
                    </span>
                  </div>
                  {s.description && (
                    <p class="mt-1.5 text-sm text-muted-foreground line-clamp-2">{s.description}</p>
                  )}
                  <p class="mt-2 text-xs text-muted-foreground/60">{timeAgo(s.created_at)}</p>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- Reward info -->
    <div class="mb-12 rounded-2xl border border-amber-500/20 bg-amber-500/5 px-6 py-6 sm:px-10">
      <div class="flex items-start gap-4">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-500/15">
          <svg class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        </div>
        <div>
          <h3 class="text-base font-semibold text-foreground">Pioneer Rewards</h3>
          <p class="mt-1 text-sm text-muted-foreground">
            The <strong class="text-amber-400">Pioneer badge</strong> is exclusive to users whose suggestions become real features. You cannot buy it, grind for it, or earn it any other way. When we ship a feature that came from your suggestion, you get:
          </p>
          <ul class="mt-2 space-y-1 text-sm text-muted-foreground">
            <li>The Pioneer badge on your profile (permanent, visible on leaderboards)</li>
            <li><strong class="text-amber-400">200 SnusPoints</strong> credited to your account</li>
            <li>A shoutout in our monthly changelog</li>
          </ul>
          <p class="mt-2 text-sm text-muted-foreground">Your idea. Your badge. Simple as that.</p>
        </div>
      </div>
    </div>

    <!-- Link to community -->
    <div class="text-center">
      <p class="text-muted-foreground">
        Want to see what others are building and talking about?
      </p>
      <a
        href="/community"
        class="mt-3 inline-flex items-center gap-2 rounded-xl border border-border px-6 py-3 text-sm font-medium text-foreground transition hover:border-primary/30 hover:bg-primary/5"
      >
        Visit the Community Hub
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>

  </div>
</Shop>
