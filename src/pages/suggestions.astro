---
export const prerender = false;

import Shop from '@/layouts/Shop.astro';
import Breadcrumb from '@/components/astro/Breadcrumb.astro';
import { tenant } from '@/config/tenant';

// Auth check — redirect to login if not signed in
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login?redirect=/suggestions');
}
---

<Shop
  title={`Suggest a Feature | Help Us Build ${tenant.name}`}
  description="Submit your ideas for new features, products, and improvements. The best suggestions earn SnusPoints and the Pioneer badge."
  canonical="/suggestions"
>
  <Breadcrumb items={[
    { label: 'Community', href: '/community' },
    { label: 'Suggestions' }
  ]} />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">

    <!-- Hero -->
    <div class="relative mb-10 overflow-hidden rounded-2xl px-6 py-10 sm:px-10 sm:py-14" style="background: linear-gradient(135deg, hsl(var(--card)) 0%, hsl(var(--background)) 100%); border: 1px solid hsl(var(--border));">
      <div class="relative z-10 max-w-2xl">
        <span class="mb-3 inline-block rounded-full bg-primary/15 px-3 py-1 text-xs font-semibold text-primary border border-primary/25">
          Community-Driven
        </span>
        <h1 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
          Help Us Build SnusFriend
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
          This shop is built for you — so tell us what you want next. Submit ideas, vote on others, and earn rewards when your suggestion ships.
        </p>
      </div>
    </div>

    <!-- How it works -->
    <section class="mb-12">
      <h2 class="mb-6 text-2xl font-bold text-foreground">How It Works</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-border bg-card/50 p-5 backdrop-blur">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-primary/15 text-primary font-bold text-lg">1</div>
          <h3 class="mb-1 font-semibold text-foreground">Submit Your Idea</h3>
          <p class="text-sm text-muted-foreground">Describe a feature, product, or improvement you want to see on SnusFriend.</p>
        </div>
        <div class="rounded-xl border border-border bg-card/50 p-5 backdrop-blur">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-primary/15 text-primary font-bold text-lg">2</div>
          <h3 class="mb-1 font-semibold text-foreground">Community Votes</h3>
          <p class="text-sm text-muted-foreground">Other members upvote the ideas they care about most, so the best ones rise to the top.</p>
        </div>
        <div class="rounded-xl border border-border bg-card/50 p-5 backdrop-blur">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-primary/15 text-primary font-bold text-lg">3</div>
          <h3 class="mb-1 font-semibold text-foreground">We Build It</h3>
          <p class="text-sm text-muted-foreground">Top-voted suggestions go into our roadmap and get built into the site.</p>
        </div>
        <div class="rounded-xl border border-border bg-card/50 p-5 backdrop-blur">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-primary/15 text-primary font-bold text-lg">4</div>
          <h3 class="mb-1 font-semibold text-foreground">You Earn Rewards</h3>
          <p class="text-sm text-muted-foreground">When your suggestion ships, you earn the Pioneer badge and 200 SnusPoints.</p>
        </div>
      </div>
    </section>

    <!-- Suggestion form -->
    <section class="mb-12">
      <h2 class="mb-6 text-2xl font-bold text-foreground">Submit a Suggestion</h2>
      <form
        action="/api/suggest"
        method="POST"
        class="mx-auto max-w-xl space-y-4 rounded-2xl border border-border bg-card/50 p-6 backdrop-blur sm:p-8"
      >
        <div>
          <label for="suggestion-title" class="mb-1.5 block text-sm font-medium text-foreground">
            Your idea in one sentence
          </label>
          <input
            id="suggestion-title"
            name="title"
            type="text"
            placeholder="e.g. Add a price drop alert for my favourite products"
            maxlength="100"
            required
            class="w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/60 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          />
        </div>
        <div>
          <label for="suggestion-description" class="mb-1.5 block text-sm font-medium text-foreground">
            Tell us more <span class="text-muted-foreground">(optional)</span>
          </label>
          <textarea
            id="suggestion-description"
            name="description"
            placeholder="Why would this be useful? How would it work?"
            maxlength="500"
            rows="4"
            class="w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/60 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary resize-y"
          ></textarea>
        </div>
        <button
          type="submit"
          class="w-full rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition hover:brightness-110 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background"
        >
          Submit Suggestion
        </button>
      </form>
    </section>

    <!-- Reward info -->
    <div class="mb-12 rounded-2xl border border-amber-500/20 bg-amber-500/5 px-6 py-6 sm:px-10">
      <div class="flex items-start gap-4">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-500/15">
          <svg class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        </div>
        <div>
          <h3 class="text-base font-semibold text-foreground">Pioneer Rewards</h3>
          <p class="mt-1 text-sm text-muted-foreground">
            When your suggestion gets built and shipped, you earn the <strong class="text-amber-400">Pioneer badge</strong> on your profile and <strong class="text-amber-400">200 SnusPoints</strong> added to your balance. The more ideas you contribute, the more you shape the future of SnusFriend.
          </p>
        </div>
      </div>
    </div>

    <!-- Link to community -->
    <div class="text-center">
      <p class="text-muted-foreground">
        Want to see what others are building and talking about?
      </p>
      <a
        href="/community"
        class="mt-3 inline-flex items-center gap-2 rounded-xl border border-border px-6 py-3 text-sm font-medium text-foreground transition hover:border-primary/30 hover:bg-primary/5"
      >
        Visit the Community Hub
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>

  </div>
</Shop>
