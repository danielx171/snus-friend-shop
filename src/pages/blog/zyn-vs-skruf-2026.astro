        "mainEntity": [
          { "@type": "Question", "name": "Is ZYN stronger than Skruf?", "acceptedAnswer": { "@type": "Answer", "text": "Not necessarily. ZYN's strength range spans 1.5\u201316.5mg, while Skruf focuses on 6\u201312mg." } },
          { "@type": "Question", "name": "Which brand is more popular in Sweden?", "acceptedAnswer": { "@type": "Answer", "text": "ZYN is the global #1 by market share, but Skruf has a devoted local following in Sweden." } },
          { "@type": "Question", "name": "Are ZYN and Skruf safe?", "acceptedAnswer": { "@type": "Answer", "text": "Both are regulated nicotine products legal in the EU. They don't contain tobacco leaf. Nicotine is addictive regardless of brand." } },
