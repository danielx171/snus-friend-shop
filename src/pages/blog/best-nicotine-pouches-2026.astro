---
export const prerender = true;
import Shop from '@/layouts/Shop.astro';
import Breadcrumb from '@/components/astro/Breadcrumb.astro';
import BlogHero from '@/components/astro/BlogHero.astro';
import BlogNewsletterCta from '@/components/astro/BlogNewsletterCta.astro';
import BlogProductCard from '@/components/astro/BlogProductCard.astro';
import { tenant } from '@/config/tenant';
import { getCollection } from 'astro:content';
import { getEditorialFacts } from '@/data/editorial-facts';
import { brandFacts } from '@/data/brand-facts';

const facts = await getEditorialFacts();

const allProducts = await getCollection('products');
function findProduct(brandSlug: string, nameFragment?: string) {
  return allProducts.find((p) =>
    p.data.brandSlug === brandSlug &&
    (!nameFragment || p.data.name.toLowerCase().includes(nameFragment.toLowerCase()))
  );
}

const find = (slug: string) => allProducts.find(p => p.id === slug);

const zynCoolMint = findProduct('zyn', 'cool mint');
const veloBeginner = findProduct('velo', 'spearmint');
const zynMenthol = findProduct('zyn', 'menthol ice');
const siberia = findProduct('siberia', 'red');
const loopValue = findProduct('loop', 'mint');
const veloVariety = findProduct('velo');
const kellyPremium = findProduct('kelly', 'white');
const zynFact = brandFacts.zyn;
const veloFact = brandFacts.velo;
const zynCatalogCount = allProducts.filter((product) => product.data.brandSlug === 'zyn').length;
const veloCatalogCount = allProducts.filter((product) => product.data.brandSlug === 'velo').length;
---

<Shop
  title="Best Nicotine Pouches 2026: 10 Editor-Tested Picks by Type"
  description={`We reviewed ${facts.productCountLabel} nicotine pouches from ${facts.brandCountLabel} brands and narrowed them to 10 editor-tested picks for flavour, strength, comfort, and value.`}
  canonical="/blog/best-nicotine-pouches-2026"
