---
export const prerender = true;
import Shop from '@/layouts/Shop.astro';
import Breadcrumb from '@/components/astro/Breadcrumb.astro';
import JsonLd from '@/components/astro/JsonLd.astro';
import { tenant } from '@/config/tenant';
import { getEditorialFacts } from '@/data/editorial-facts';
import { blogArticles, getReadTime } from '@/data/blog-registry';
import { buildCollectionPageSchema, editorialTeamLabel } from '@/lib/blog-schema';
import { formatDisplayDate } from '@/lib/dates';
import fs from 'node:fs';
import path from 'node:path';

// Validate registry matches filesystem
const blogDir = path.resolve('./src/pages/blog');
const astroFiles = fs.readdirSync(blogDir)
  .filter((f: string) => f.endsWith('.astro') && f !== 'index.astro')
  .map((f: string) => f.replace('.astro', ''));
const registrySlugs = new Set(blogArticles.map(a => a.slug));
const missing = astroFiles.filter(f => !registrySlugs.has(f));
if (missing.length > 0) {
  console.warn(`⚠️ Blog registry missing entries for: ${missing.join(', ')}. Add them to src/data/blog-registry.ts`);
}

const articles = blogArticles;
const facts = await getEditorialFacts();

const tagColors: Record<string, string> = {
  'Brand Spotlight': '#2E7D32',
  'Comparison': '#1565C0',
  'Buying Guide': '#BF360C',
  'Guide': '#2E7D32',
  'Ranking': '#6A1B9A',
  'Flavour Guide': '#00838F',
  'FAQ': '#37474F',
  'Data Report': '#B71C1C',
  'Safety & Health': '#C62828',
};

const categoryOrder = [
  'Comparison',
  'Brand Spotlight',
  'Buying Guide',
  'Ranking',
  'Flavour Guide',
  'Guide',
  'Safety & Health',
  'FAQ',
  'Data Report',
];

const categoryDescriptions: Record<string, string> = {
  'Comparison': 'Head-to-head brand comparisons to help you choose.',
  'Brand Spotlight': 'Deep-dive guides into every major pouch brand.',
  'Buying Guide': 'Best-of lists and recommendations for every need.',
  'Ranking': 'Data-driven rankings across categories.',
  'Flavour Guide': 'Explore every flavour category in detail.',
  'Guide': 'Practical how-to guides and reference articles.',
  'Safety & Health': 'Evidence-based health and safety information.',
  'FAQ': 'Quick answers to common questions.',
  'Data Report': 'Live data from our product catalog.',
};

const featuredSlugs = [
  'best-nicotine-pouches-germany-2026',
  'best-nicotine-pouches-netherlands-2026',
  'best-nicotine-pouches-sensitive-gums',
  'zyn-vs-nordic-spirit',
];

const featured = featuredSlugs
  .map(slug => articles.find(a => a.slug === slug))
  .filter(Boolean);

const grouped = categoryOrder.map(cat => ({
  category: cat,
  description: categoryDescriptions[cat] ?? '',
  items: articles.filter(a => a.tag === cat && !featuredSlugs.includes(a.slug)),
})).filter(g => g.items.length > 0);

const blogJsonLd = buildCollectionPageSchema({
  name: 'Nicotine Pouch Guides & Reviews',
  description: `Guides, reviews, and news about nicotine pouches from ${tenant.name}.`,
  path: '/blog',
  items: articles.map((article, index) => ({
    position: index + 1,
    path: `/blog/${article.slug}`,
    name: article.title,
  })),
});

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What are the side effects of nicotine pouches?", "acceptedAnswer": { "@type": "Answer", "text": "Common side effects include a tingling or burning sensation under the lip, hiccups, and mild nausea — especially for new users or when using a higher strength than your tolerance allows. These effects are typically temporary and subside as you adjust." } },
    { "@type": "Question", "name": "Are nicotine pouches legal in Europe?", "acceptedAnswer": { "@type": "Answer", "text": "Nicotine pouches are legal to buy and use in most European countries, including Sweden, Germany, the UK, Spain, Italy, and Poland. However, France banned commercial sales in February 2025, the Netherlands introduced a retail ban the same month. The EU's Tobacco Products Directive 3 (TPD3), expected in draft form by mid-2026, will introduce harmonised regulation across member states." } },
    { "@type": "Question", "name": "How do I switch from cigarettes to nicotine pouches?", "acceptedAnswer": { "@type": "Answer", "text": "Start by matching your cigarette intake to an appropriate pouch strength: light smokers (under 10 per day) should try 4-6 mg pouches, moderate smokers (10-20 per day) should start at 6-10 mg. Use a pouch whenever you feel a craving. Most people adjust within one to two weeks." } },
    { "@type": "Question", "name": "Which nicotine pouch flavour is best for beginners?", "acceptedAnswer": { "@type": "Answer", "text": "Mint is the most popular starting flavour — it accounts for an estimated 45-60% of all nicotine pouch sales and offers a familiar, refreshing taste. Spearmint and peppermint are milder options, while menthol provides more cooling. If you dislike mint, citrus flavours are the next most popular choice for newcomers." } },
    { "@type": "Question", "name": "How should I store nicotine pouches?", "acceptedAnswer": { "@type": "Answer", "text": "Store nicotine pouches in a cool, dry place away from direct sunlight. An unopened can typically stays fresh for 12 to 14 months from the production date. Once opened, the pouches are best used within a week or two, as they will gradually dry out and lose flavour intensity." } }
  ]
};
---

<Shop
  title={`Nicotine Pouch Guides & Reviews | ${tenant.name}`}
  description={`Guides, reviews, and news about nicotine pouches from ${tenant.name}. Learn about strengths, flavours, brands, and more.`}
  canonical="/blog"
>
  <JsonLd items={[blogJsonLd, faqJsonLd]} />
  <section class="bg-background text-foreground">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <Breadcrumb items={[{ label: 'Blog' }]} />

      <h1 class="text-4xl font-bold tracking-tight mb-3">Nicotine Pouch Guides & Reviews</h1>
      <p class="mb-8 max-w-2xl text-base leading-relaxed text-muted-foreground">
        Fact-checked guides, brand comparisons, and buying advice — written by our editorial team and updated whenever the market moves.
        Whether you're choosing your <a href="/blog/best-nicotine-pouches-for-beginners-2026" class="underline hover:text-foreground">first pouch</a>,
        comparing <a href="/blog/zyn-vs-velo-2026" class="underline hover:text-foreground">ZYN vs VELO</a>,
        or researching <a href="/blog/nicotine-pouch-side-effects" class="underline hover:text-foreground">side effects</a> — no filler, no upsell.
      </p>

      {/* Featured Articles — magazine-style thumbnails (OG images as hero art) */}
      <section class="mb-14">
        <h2 class="text-2xl font-bold tracking-tight mb-1">Featured</h2>
        <p class="text-sm text-muted-foreground mb-6">Freshly prioritized guides we want Google and readers to find first.</p>
        <div class="grid gap-6 sm:grid-cols-2">
          {featured.map((article) => {
            const accent = tagColors[article.tag] ?? '#2E7D32';
            return (
              <a href={`/blog/${article.slug}`} class="blog-card group relative rounded-2xl border border-border bg-card/80 overflow-hidden flex flex-col transition duration-300 hover:border-primary/40 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-primary/5">
                <div class="relative aspect-[1200/630] w-full overflow-hidden bg-muted/30">
                  <img
                    src={`/og/article-${article.slug}.png`}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                    onerror="this.style.display='none'"
                  />
                  <span
                    class="absolute top-3 left-3 inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold backdrop-blur-sm shadow-sm"
                    style={`background: ${accent}dd; color: white;`}
                  >
                    {article.tag}
                  </span>
                </div>
                <div class="p-6 flex flex-col flex-1 gap-2">
                  <h2 class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors leading-snug">{article.title}</h2>
                  <span class="text-xs text-muted-foreground">{getReadTime(article.slug)}</span>
                  <p class="text-sm text-muted-foreground leading-relaxed flex-1 line-clamp-3">
                    {article.excerpt}
                  </p>
                  <div class="flex items-center justify-between pt-4 border-t border-border/60 text-xs text-muted-foreground">
                    <div class="flex items-center gap-2">
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-primary/15 text-[10px] font-bold text-primary">SF</span>
                      <span>{editorialTeamLabel}</span>
                    </div>
                    {article.date && (
                      <time datetime={article.date} class="tabular-nums">
                        {formatDisplayDate(article.date)}
                      </time>
                    )}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>

      {/* Category Sections */}
      {grouped.map((group) => {
        const accent = tagColors[group.category] ?? '#2E7D32';
        return (
          <section class="mb-14">
            <div class="flex items-baseline gap-3 mb-1">
              <span class="h-6 w-1 rounded-full" style={`background: ${accent};`} />
              <h2 class="text-2xl font-bold tracking-tight">{group.category}</h2>
            </div>
            <p class="text-sm text-muted-foreground mb-6 ml-4">{group.description}</p>
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {group.items.map((article) => (
                <a href={`/blog/${article.slug}`} class="blog-card group rounded-2xl border border-border bg-card/80 overflow-hidden flex flex-col transition duration-300 hover:border-primary/30 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary/5">
                  <div class="relative aspect-[1200/630] w-full overflow-hidden bg-muted/30">
                    <img
                      src={`/og/article-${article.slug}.png`}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                      onerror="this.style.display='none'"
                    />
                    <span
                      class="absolute top-2 left-2 inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold backdrop-blur-sm shadow-sm"
                      style={`background: ${accent}dd; color: white;`}
                    >
                      {article.tag}
                    </span>
                  </div>
                  <div class="p-5 flex flex-col flex-1 gap-1.5">
                    <h3 class="text-base font-semibold text-foreground group-hover:text-primary transition-colors leading-snug">{article.title}</h3>
                    <span class="text-xs text-muted-foreground">{getReadTime(article.slug)}</span>
                    <p class="text-sm text-muted-foreground leading-relaxed flex-1 line-clamp-2">
                      {article.excerpt}
                    </p>
                    {article.date && (
                      <p class="text-xs text-muted-foreground pt-2 mt-1 border-t border-border/60">
                        <time datetime={article.date}>
                          {formatDisplayDate(article.date)}
                        </time>
                        <span class="mx-1.5">&middot;</span>
                        {editorialTeamLabel}
                      </p>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </section>
        );
      })}

      <div class="mt-12 rounded-xl border border-border bg-card/80 p-8 text-center">
        <h2 class="text-xl font-semibold mb-2">Explore More</h2>
        <p class="text-muted-foreground text-sm max-w-md mx-auto mb-6">
          Browse our full catalogue of nicotine pouches from {facts.brandCountLabel} European brands.
        </p>
        <a href="/products" class="inline-flex items-center justify-center rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90">
          Shop All Products
        </a>
      </div>
    </div>
  </section>
  <JsonLd data={faqJsonLd} />
</Shop>
