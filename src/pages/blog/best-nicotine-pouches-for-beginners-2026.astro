---
export const prerender = true;
import Shop from '@/layouts/Shop.astro';
import Breadcrumb from '@/components/astro/Breadcrumb.astro';
import BlogHero from '@/components/astro/BlogHero.astro';
import BlogProductCard from '@/components/astro/BlogProductCard.astro';
import { tenant } from '@/config/tenant';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products');
function findProduct(brandSlug: string, nameFragment?: string) {
  return allProducts.find((p) =>
    p.data.brandSlug === brandSlug &&
    (!nameFragment || p.data.name.toLowerCase().includes(nameFragment.toLowerCase()))
  );
}

const find = (slug: string) => allProducts.find(p => p.id === slug);

const zynMini = findProduct('zyn', 'mini');
const veloEasy = findProduct('velo', 'easy mint');
const helwit = findProduct('helwit');
const onMini = findProduct('on', 'mini');
const kellyWhite = findProduct('kelly', 'white');
const aceQuick = findProduct('ace', 'quick');
const loopFreeJalapeno = findProduct('loop', 'jalapeno');

const publishDate = '2026-03-28';
const title = 'Best Nicotine Pouches for Beginners (2026)';
const description = 'Overwhelmed by pouch options? Here\'s exactly which low-strength brands to try first, what strength to start with, and what to expect in your first week.';
---

