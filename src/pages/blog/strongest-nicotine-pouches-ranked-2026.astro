            <tr><td>12</td><td>RUSH</td><td>Strong variants</td><td>21.0</td><td>Strong</td><td>9</td></tr>
            <tr><td>13</td><td><a href="/brands/77-pouches">77 Pouches</a></td><td>Strong variants</td><td>20.0</td><td>Strong</td><td>23</td></tr>
            <tr><td>14</td><td><a href="/brands/clew">CLEW</a></td><td>Strong variants</td><td>20.0</td><td>Strong</td><td>19</td></tr>
