const allProducts = await getCollection('products');
const find = (slug: string) => allProducts.find(p => p.id === slug);

const publishDate = '2026-04-08';
const title = 'Best Nicotine Pouches Under \u20AC2 (2026 Value Guide)';
const description = 'Find the best nicotine pouches under \u20AC2 per can. We ranked 10 budget-friendly options by flavour, strength, and value.';
---

<Shop title={title} description={description} ogType="article">
