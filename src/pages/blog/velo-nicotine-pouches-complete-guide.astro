---
export const prerender = true;
import Shop from '@/layouts/Shop.astro';
import Breadcrumb from '@/components/astro/Breadcrumb.astro';
import BlogHero from '@/components/astro/BlogHero.astro';
import BlogProductCard from '@/components/astro/BlogProductCard.astro';
import { tenant } from '@/config/tenant';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products');
function findProduct(brandSlug: string, nameFragment?: string) {
  return allProducts.find((p) =>
    p.data.brandSlug === brandSlug &&
    (!nameFragment || p.data.name.toLowerCase().includes(nameFragment.toLowerCase()))
  );
}

const find = (slug: string) => allProducts.find(p => p.id === slug);

const veloCrispyPeppermint = findProduct('velo', 'crispy peppermint');
const veloIceCool = findProduct('velo', 'ice cool');
const veloRubyBerry = findProduct('velo', 'ruby berry');
const veloFreeze = findProduct('velo', 'freeze');

const publishDate = '2026-03-27';
const title = 'VELO Nicotine Pouches: Complete Brand Guide';
const description = 'Discover VELO by BAT — the global nicotine pouch leader. Explore 53 products across all strengths, from Mighty Peppermint to Tropical Mango.';
---

<Shop
  title={title}
  description={description}
  ogType="article"
  ogImage="/images/og/og-brand.svg"
>
  <article class="bg-background text-foreground">
    <div class="max-w-3xl mx-auto px-4 py-12">
      <Breadcrumb items={[
        { label: 'Blog', href: '/blog' },
        { label: 'VELO Guide' },
      ]} />

      <BlogHero
        category="Brand Spotlight"
        title={title}
        description={description}
        date="March 27, 2026"
        readTime="9 min read"
      />

      <div class="prose prose-invert max-w-none space-y-6 text-base leading-relaxed text-muted-foreground [&_h2]:text-foreground [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-10 [&_h2]:mb-4 [&_h3]:text-foreground [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-8 [&_h3]:mb-3 [&_strong]:text-foreground [&_a]:text-primary [&_a]:underline [&_a:hover]:text-foreground">

        <h2>About VELO</h2>

        <details style="margin-top: 12px; padding: 16px; background: hsl(var(--muted)); border-radius: 8px;">
          <summary style="font-weight: 600; cursor: pointer;">Who owns VELO?</summary>
          <p style="margin-top: 12px;">VELO is owned by R.J. Reynolds Tobacco Company, a major global tobacco corporation headquartered in North Carolina, USA. RJ Reynolds invests heavily in nicotine innovation and brought VELO to market to compete with Swedish snus and newer nicotine pouch brands.</p>
        </details>

        <details style="margin-top: 12px; padding: 16px; background: hsl(var(--muted)); border-radius: 8px;">
          <summary style="font-weight: 600; cursor: pointer;">Is VELO the same as Lyft?</summary>
          <p style="margin-top: 12px;">VELO and Lyft are distinct brands; both are owned by RJ Reynolds, but they target different markets—VELO dominates in Europe and prestige segments, while Lyft focuses on the USA and emerging markets. <a href="/blog/velo-nicotine-pouches-complete-guide" style="color: hsl(var(--primary));">VELO and Lyft</a> share similar formulations but differ in positioning and regional availability.</p>
        </details>

        <details style="margin-top: 12px; padding: 16px; background: hsl(var(--muted)); border-radius: 8px;">
          <summary style="font-weight: 600; cursor: pointer;">What is the strongest VELO pouch?</summary>
          <p style="margin-top: 12px;">VELO's strongest offering is typically 14 mg/g in select markets, positioning VELO as a mid-to-premium strength brand rather than an extreme-strength competitor. <a href="/blog/pablo-nicotine-pouches-complete-guide" style="color: hsl(var(--primary));">For maximum nicotine</a>, users seeking ultra-strong pouches move to brands like Pablo or Iceberg instead.</p>
        </details>

        <p>
          <a href="/brands/velo">VELO</a> is the flagship nicotine pouch brand from British American Tobacco (BAT),
          one of the world's largest tobacco companies. Originally launched in Scandinavia under the names EPOK and
          LYFT, the global rebrand to VELO was announced in 2019 and completed in 2022, giving BAT a single, recognisable
          identity for their tobacco-free nicotine pouch range (BAT, 2022).
        </p>
        <p>
          Today, VELO is manufactured at BAT's dedicated production facility in Pecs, Hungary, and is sold in over
          50 markets worldwide. <strong>VELO is the second-best-selling nicotine pouch brand globally</strong>, behind only <a href="/blog/zyn-nicotine-pouches-complete-guide">ZYN</a> by
          Swedish Match. In several European and African markets, VELO holds the number one position.
        </p>
        <p>
          What sets VELO apart is scale and consistency. With the full backing of a multinational corporation, VELO
          can invest heavily in product development, quality control, and flavour innovation. Their catalogue has
          grown to <strong>53 products</strong> across multiple formats, strengths, and flavour families — making
          them one of the most diverse brands on the market.
        </p>

        <div class="not-prose grid grid-cols-1 sm:grid-cols-2 gap-3 my-8">
          {find('velo-crispy-peppermint-es') && <BlogProductCard product={find('velo-crispy-peppermint-es')} />}
          {find('velo-blue-raspberry') && <BlogProductCard product={find('velo-blue-raspberry')} />}
          {find('velo-lime-flame') && <BlogProductCard product={find('velo-lime-flame')} />}
          {find('velo-bright-spearmint-mini-es') && <BlogProductCard product={find('velo-bright-spearmint-mini-es')} />}
        </div>

        <h2>VELO Product Overview</h2>
        <p style="font-size: 13px; color: hsl(var(--muted-foreground)); margin-bottom: 12px;">Product availability and specifications may vary by market. Last verified: April 2026.</p>
        <div style="overflow-x: auto; margin: 32px 0;">
          <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
            <thead>
              <tr style="border-bottom: 2px solid hsl(var(--border));">
                <th style="text-align: left; padding: 12px 16px; color: hsl(var(--muted-foreground)); font-weight: 600;">Product</th>
                <th style="text-align: left; padding: 12px 16px; color: hsl(var(--muted-foreground)); font-weight: 600;">Format</th>
                <th style="text-align: left; padding: 12px 16px; color: hsl(var(--muted-foreground)); font-weight: 600;">Strength (mg/pouch)</th>
                <th style="text-align: left; padding: 12px 16px; color: hsl(var(--muted-foreground)); font-weight: 600;">Flavour</th>
                <th style="text-align: left; padding: 12px 16px; color: hsl(var(--muted-foreground)); font-weight: 600;">Pouches/Can</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid hsl(var(--border) / 0.5);"><td style="padding: 10px 16px;">VELO Mighty Peppermint</td><td style="padding: 10px 16px;">Slim</td><td style="padding: 10px 16px;">9.8</td><td style="padding: 10px 16px;">Mint</td><td style="padding: 10px 16px;">20</td></tr>
              <tr style="border-bottom: 1px solid hsl(var(--border) / 0.5);"><td style="padding: 10px 16px;">VELO Mighty Peppermint Max</td><td style="padding: 10px 16px;">Slim</td><td style="padding: 10px 16px;">17</td><td style="padding: 10px 16px;">Mint</td><td style="padding: 10px 16px;">20</td></tr>
              <tr style="border-bottom: 1px solid hsl(var(--border) / 0.5);"><td style="padding: 10px 16px;">VELO Crispy Peppermint</td><td style="padding: 10px 16px;">Slim</td><td style="padding: 10px 16px;">9.8</td><td style="padding: 10px 16px;">Mint</td><td style="padding: 10px 16px;">20</td></tr>
              <tr style="border-bottom: 1px solid hsl(var(--border) / 0.5);"><td style="padding: 10px 16px;">VELO Bright Spearmint</td><td style="padding: 10px 16px;">Slim</td><td style="padding: 10px 16px;">4</td><td style="padding: 10px 16px;">Mint</td><td style="padding: 10px 16px;">20</td></tr>
              <tr style="border-bottom: 1px solid hsl(var(--border) / 0.5);"><td style="padding: 10px 16px;">VELO Berry Frost</td><td style="padding: 10px 16px;">Slim</td><td style="padding: 10px 16px;">9.8</td><td style="padding: 10px 16px;">Berry</td><td style="padding: 10px 16px;">20</td></tr>
              <tr style="border-bottom: 1px solid hsl(var(--border) / 0.5);"><td style="padding: 10px 16px;">VELO Berry Frost Max</td><td style="padding: 10px 16px;">Slim</td><td style="padding: 10px 16px;">17</td><td style="padding: 10px 16px;">Berry</td><td style="padding: 10px 16px;">20</td></tr>
              <tr style="border-bottom: 1px solid hsl(var(--border) / 0.5);"><td style="padding: 10px 16px;">VELO Tropical Mango</td><td style="padding: 10px 16px;">Slim</td><td style="padding: 10px 16px;">6</td><td style="padding: 10px 16px;">Fruit</td><td style="padding: 10px 16px;">20</td></tr>
              <tr style="border-bottom: 1px solid hsl(var(--border) / 0.5);"><td style="padding: 10px 16px;">VELO Orange Spark</td><td style="padding: 10px 16px;">Slim</td><td style="padding: 10px 16px;">6</td><td style="padding: 10px 16px;">Citrus</td><td style="padding: 10px 16px;">20</td></tr>
              <tr style="border-bottom: 1px solid hsl(var(--border) / 0.5);"><td style="padding: 10px 16px;">VELO Lime Flame</td><td style="padding: 10px 16px;">Slim</td><td style="padding: 10px 16px;">9.8</td><td style="padding: 10px 16px;">Citrus</td><td style="padding: 10px 16px;">20</td></tr>
              <tr style="border-bottom: 1px solid hsl(var(--border) / 0.5);"><td style="padding: 10px 16px;">VELO Arctic Grapefruit</td><td style="padding: 10px 16px;">Slim</td><td style="padding: 10px 16px;">6</td><td style="padding: 10px 16px;">Citrus</td><td style="padding: 10px 16px;">20</td></tr>
              <tr style="border-bottom: 1px solid hsl(var(--border) / 0.5);"><td style="padding: 10px 16px;">VELO Ruby Berry</td><td style="padding: 10px 16px;">Slim</td><td style="padding: 10px 16px;">6</td><td style="padding: 10px 16px;">Berry</td><td style="padding: 10px 16px;">20</td></tr>
              <tr style="border-bottom: 1px solid hsl(var(--border) / 0.5);"><td style="padding: 10px 16px;">VELO Elderflower Spritz</td><td style="padding: 10px 16px;">Slim</td><td style="padding: 10px 16px;">6</td><td style="padding: 10px 16px;">Fruit</td><td style="padding: 10px 16px;">20</td></tr>
              <tr style="border-bottom: 1px solid hsl(var(--border) / 0.5);"><td style="padding: 10px 16px;">VELO Royal Purple</td><td style="padding: 10px 16px;">Slim</td><td style="padding: 10px 16px;">9.8</td><td style="padding: 10px 16px;">Berry</td><td style="padding: 10px 16px;">20</td></tr>
              <tr style="border-bottom: 1px solid hsl(var(--border) / 0.5);"><td style="padding: 10px 16px;">VELO Ice Cool</td><td style="padding: 10px 16px;">Slim</td><td style="padding: 10px 16px;">9.8</td><td style="padding: 10px 16px;">Mint</td><td style="padding: 10px 16px;">20</td></tr>
              <tr style="border-bottom: 1px solid hsl(var(--border) / 0.5);"><td style="padding: 10px 16px;">VELO Easy Mint</td><td style="padding: 10px 16px;">Mini</td><td style="padding: 10px 16px;">4</td><td style="padding: 10px 16px;">Mint</td><td style="padding: 10px 16px;">20</td></tr>
              <tr style="border-bottom: 1px solid hsl(var(--border) / 0.5);"><td style="padding: 10px 16px;">VELO Freeze</td><td style="padding: 10px 16px;">Slim</td><td style="padding: 10px 16px;">11</td><td style="padding: 10px 16px;">Mint</td><td style="padding: 10px 16px;">20</td></tr>
            </tbody>
          </table>
        </div>

        <h2>VELO Formats: Mini vs Slim</h2>
        <p>
          VELO offers two pouch formats, each designed for a different use case:
        </p>
        <p>
          <strong>Mini</strong> pouches are the smaller of the two. They are compact, lightweight, and virtually
          invisible under the lip. Mini format is ideal if you value discretion — during meetings, on public
          transport, or in any situation where you prefer nobody notices. The trade-off is a slightly shorter
          flavour duration compared to slim pouches, typically lasting 20 to 30 minutes.
        </p>
        <p>
          <strong>Slim</strong> pouches are longer and flatter, sitting comfortably along the gum line. They offer
          a larger surface area, which means more consistent nicotine release and longer-lasting flavour — usually
          30 to 45 minutes. Slim is the most popular format in the VELO range and is what most users reach for as
          their daily choice.
        </p>
        <p>
          Neither format is objectively better. If discretion is your priority, go mini. If flavour longevity and
          comfort matter more, go slim. Many VELO users keep both formats on hand for different occasions.
        </p>

        <h2>VELO Strength Range</h2>
        <p>
          VELO covers the full nicotine spectrum, from zero-nicotine pouches all the way up to ultra-strong
          options. This makes the brand suitable for everyone — from curious first-timers to experienced users
          who need a serious nicotine hit.
        </p>

        <div class="overflow-x-auto my-6">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="border-b border-border text-foreground">
                <th class="text-left py-3 pr-4 font-semibold">Strength Level</th>
                <th class="text-left py-3 pr-4 font-semibold">Nicotine Range</th>
                <th class="text-left py-3 font-semibold">Best For</th>
              </tr>
            </thead>
            <tbody class="text-muted-foreground">
              <tr class="border-b border-border/50">
                <td class="py-3 pr-4"><strong>Zero</strong></td>
                <td class="py-3 pr-4">0 mg</td>
                <td class="py-3">Flavour-only experience, stepping down from nicotine</td>
              </tr>
              <tr class="border-b border-border/50">
                <td class="py-3 pr-4"><strong>Normal</strong></td>
                <td class="py-3 pr-4">4 mg</td>
                <td class="py-3">Beginners, light users, all-day comfort</td>
              </tr>
              <tr class="border-b border-border/50">
                <td class="py-3 pr-4"><strong>Strong</strong></td>
                <td class="py-3 pr-4">6 - 10 mg</td>
                <td class="py-3">Regular users, former smokers transitioning</td>
              </tr>
              <tr class="border-b border-border/50">
                <td class="py-3 pr-4"><strong>Extra Strong</strong></td>
                <td class="py-3 pr-4">10 - 14 mg</td>
                <td class="py-3">Experienced users who want a noticeable kick</td>
              </tr>
              <tr>
                <td class="py-3 pr-4"><strong>Ultra Strong</strong></td>
                <td class="py-3 pr-4">14 - 17 mg</td>
                <td class="py-3">High-tolerance users, maximum intensity</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p>
          If you are <a href="/blog/what-are-nicotine-pouches">new to nicotine pouches</a>, start with <strong>Normal</strong> (4 mg) and work upward only
          if you feel you need more. Most daily users settle comfortably in the <strong>Strong</strong> range.
          Read our <a href="/blog/how-to-choose-your-strength">strength guide</a> for a deeper breakdown of
          how to find your ideal level.
        </p>

        <h2>VELO Flavour Guide</h2>
        <p>
          <strong>VELO's flavour range is one of the broadest in the industry</strong>, spanning five major flavour families.
          For a complete flavour comparison across all brands, see our <a href="/blog/nicotine-pouch-flavour-guide">complete flavour guide</a>.
          Here is what to expect from each VELO flavour family:
        </p>

        <h3>Mint</h3>
        <p>
          <a href="/products/flavor/mint">Mint</a> is the cornerstone of the VELO lineup and includes their
          best-selling products. You will find everything from crisp peppermint to smooth spearmint to icy
          menthol blends. If you only ever try one VELO flavour, make it a mint.
        </p>

        <h3>Berry</h3>
        <p>
          The <a href="/products/flavor/berry">berry</a> range leans sweet and fruity, featuring blueberry,
          raspberry, and mixed berry blends. These are popular with users who find mint too sharp or who simply
          prefer a sweeter, more dessert-like experience. Berry pairs particularly well with lower strengths.
        </p>

        <h3>Citrus</h3>
        <p>
          <a href="/products/flavor/citrus">Citrus</a> flavours deliver a bright, zesty punch. Expect notes
          of lemon, orange, and grapefruit. Citrus pouches tend to feel crisp and refreshing — a good
          alternative to mint when you want freshness without the menthol cooling sensation.
        </p>

        <h3>Fruit</h3>
        <p>
          The <a href="/products/flavor/fruit">fruit</a> category goes beyond berries and citrus into tropical
          territory — mango, passion fruit, and watermelon. These are VELO's most adventurous flavours and
          appeal to users who want something genuinely different from the traditional mint-and-tobacco world.
        </p>

        <h3>Licorice</h3>
        <p>
          <a href="/products/flavor/licorice">Licorice</a> is a distinctly Scandinavian flavour that pays
          homage to the brand's Nordic roots. It is earthy, slightly sweet, and deeply satisfying for fans
          of traditional snus flavour profiles. Not for everyone, but beloved by those who appreciate it.
        </p>

        <h2>Spotlight: VELO Mighty Peppermint</h2>
        <p>
          If there is one product that defines VELO, it is <strong>Mighty Peppermint</strong>. This is the
          brand's signature pouch — the one that outsells everything else in the range by a wide margin and
          the product most people picture when they think of VELO.
        </p>
        <p>
          Mighty Peppermint delivers an intense, cooling peppermint flavour that hits immediately when you
          place the pouch under your lip. The mint is bold without being artificial, and the cooling sensation
          lingers well beyond the 30-minute mark. It is available across multiple strengths, from Normal
          (4 mg) all the way up to Ultra Strong (17 mg), so you can enjoy the same great flavour at whatever
          intensity suits you.
        </p>
        <p>
          For many users, Mighty Peppermint is not just their favourite VELO product — it is their daily
          driver, the pouch they reach for first thing in the morning and keep coming back to throughout the
          day. If you want to understand what VELO does best, start here.
        </p>

        <div class="my-8">
          <h3 class="text-lg font-semibold text-foreground mb-4">Featured VELO Products</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {veloCrispyPeppermint && <BlogProductCard {...veloCrispyPeppermint.data} />}
            {veloIceCool && <BlogProductCard {...veloIceCool.data} />}
            {veloRubyBerry && <BlogProductCard {...veloRubyBerry.data} />}
            {veloFreeze && <BlogProductCard {...veloFreeze.data} />}
          </div>
        </div>

        <h2>Who Should Choose VELO?</h2>
        <p>
          VELO is built for the mainstream market. It is not trying to be the most extreme brand or the most
          niche — it is trying to be the most reliable, most accessible, and most widely available. That
          positioning makes it an excellent choice for several types of users:
        </p>
        <ul class="list-disc pl-6 space-y-2">
          <li><strong>Smokers looking to switch:</strong> <a href="/blog/switching-from-cigarettes-to-nicotine-pouches">VELO's wide strength range means you can match your current nicotine intake</a> and step down gradually if desired. The familiar mint and tobacco-adjacent flavours ease the transition.</li>
          <li><strong>New nicotine pouch users:</strong> See our <a href="/blog/best-nicotine-pouches-for-beginners-2026">beginner's guide</a> for VELO's ranking. The Normal (4 mg) strength is genuinely gentle, and the slim format is comfortable even if you have never used a pouch before. VELO is forgiving for beginners.</li>
          <li><strong>Daily users who value consistency:</strong> Because VELO is manufactured at industrial scale with strict quality control, every can tastes the same. No batch variation, no surprises — just the same product every time.</li>
          <li><strong>Users who want variety:</strong> With 53 products spanning five flavour families and five strength levels, you can explore extensively without ever leaving the brand. Many users rotate between three or four VELO flavours throughout the week.</li>
        </ul>
        <p>
          If you prefer extreme nicotine strength (above 17 mg), niche artisanal brands like <a href="/blog/siberia-nicotine-pouches-complete-guide">Siberia</a>, or unusual flavour
          experiments, VELO may feel too safe. But for most users, that reliability and breadth of choice is
          exactly what they want.
        </p>

        <h2>Browse the Full VELO Range</h2>
        <p>
          Ready to explore? Visit our <a href="/brands/velo">complete VELO collection</a> to see all 53
          products with detailed descriptions, pricing, and strength indicators. You can filter by format,
          strength, and flavour to find exactly what you are looking for.
        </p>

        <h2>How Does VELO Compare?</h2>
        <p>See how VELO compares to other top brands:</p>
        <ul class="list-disc pl-6 space-y-2">
          <li><a href="/blog/zyn-vs-velo-2026">ZYN vs VELO: The Definitive 2026 Comparison</a></li>
          <li><a href="/blog/velo-vs-loop-2026">VELO vs LOOP: Which Is Better in 2026?</a></li>
          <li><a href="/blog/velo-vs-nordic-spirit">VELO vs Nordic Spirit</a></li>
          <li><a href="/blog/velo-vs-on-nicotine-pouches">VELO vs ON!</a></li>
        </ul>

        <hr class="my-10" />

        <h2>Further Reading</h2>
        <p>Want to learn more about VELO and how it compares? Check these guides:</p>
        <ul class="list-disc pl-6 space-y-2">
          <li><a href="/blog/zyn-vs-velo-2026">ZYN vs VELO 2026</a> — comprehensive comparison of the two market leaders</li>
          <li><a href="/blog/best-nicotine-pouches-2026">Best nicotine pouches overall</a> — see where VELO ranks across all brands</li>
          <li><a href="/blog/velo-flavours-complete-guide">VELO flavours guide</a> — deep dive into all 5 flavour families</li>
          <li><a href="/blog/best-mint-nicotine-pouches-2026">Best mint nicotine pouches</a> — VELO Mighty Peppermint vs the competition</li>
          <li><a href="/blog/nicotine-pouch-side-effects">Nicotine pouch side effects</a> — safety and health information</li>
        </ul>
      </div>

      <div class="mt-12 space-y-8">
        <div>
          <h3 class="text-lg font-semibold text-foreground mb-4">Browse by Flavour</h3>
          <div class="flex flex-wrap gap-3">
            <a href="/products/flavor/mint" class="rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition hover:bg-primary/90">Mint</a>
            <a href="/products/flavor/berry" class="rounded-lg border border-border bg-card px-6 py-3 text-sm font-medium text-foreground transition hover:border-primary/40 hover:bg-primary/5">Berry</a>
