import BlogProductCard from '@/components/astro/BlogProductCard.astro';
import { tenant } from '@/config/tenant';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products');
const find = (slug: string) => allProducts.find(p => p.id === slug);

const publishDate = '2026-04-09';
const title = 'Best Value Nicotine Pouches 2026: Quality ÷ Price Rankings';
const description = 'We ranked nicotine pouches by value — not just price. See which brands deliver the best quality per euro with our price-per-pouch analysis.';
