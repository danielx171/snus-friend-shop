          "logo": { "@type": "ImageObject", "url": `https://${tenant.domain}/og-image.jpg` }
        },
        "mainEntityOfPage": { "@type": "WebPage", "@id": `https://${tenant.domain}/blog/best-nicotine-pouches-by-occasion` },
