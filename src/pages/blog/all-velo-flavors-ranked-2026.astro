    "mainEntity": [
      { "@type": "Question", "name": "What is the best VELO flavour?", "acceptedAnswer": { "@type": "Answer", "text": "Freezing Peppermint (10 mg) is the top-ranked VELO flavour for its intense cooling effect and clean peppermint taste that lasts 40+ minutes. For a less intense option, Ruby Berry (6 mg) is the best fruit flavour on the market." } },
