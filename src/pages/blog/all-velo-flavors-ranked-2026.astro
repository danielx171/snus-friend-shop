const description = 'All 30+ VELO nicotine pouch flavours ranked. From Freezing Peppermint to Ruby Berry and the new VELO Shift collection — find your best match.';
---

<Shop
  title={title}
  description={description}
  canonical="/blog/all-velo-flavors-ranked-2026"
