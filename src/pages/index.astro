  <!-- Beginner mode: hide strong products from static sections -->
  <script is:inline>
  (function() {
    // Beginner mode filter
    try {
      var raw = localStorage.getItem('snusfriend_beginner');
      if (raw === 'true') {
        var cards = document.querySelectorAll('[data-nicotine-mg]');
        for (var i = 0; i < cards.length; i++) {
          var mg = parseFloat(cards[i].getAttribute('data-nicotine-mg'));
          if (mg > 6) cards[i].style.display = 'none';
        }
      }
    } catch(e) {}

    // Animated stat counters
    document.querySelectorAll('[data-count-to]').forEach(function(el) {
      var target = parseInt(el.getAttribute('data-count-to') || '0');
      var duration = 1500;
      var start = performance.now();
      function step(now) {
        var progress = Math.min((now - start) / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3); // ease-out cubic
        el.textContent = Math.round(target * eased) + (progress >= 1 ? '+' : '');
        if (progress < 1) requestAnimationFrame(step);
      }
      // Only animate if in viewport
      var observer = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting) {
          observer.disconnect();
          start = performance.now();
          requestAnimationFrame(step);
        }
      });
      observer.observe(el);
    });
  })();
  </script>

