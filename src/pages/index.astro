---
export const prerender = true;
import Shop from '@/layouts/Shop.astro';
import { tenant } from '@/config/tenant';
import { getCollection } from 'astro:content';
import ProductCard from '@/components/astro/ProductCard.astro';
import RecentlyViewedIsland from '@/components/react/RecentlyViewedIsland';
import RecommendationsIsland from '@/components/react/RecommendationsIsland';
import { brandColors, defaultBrandColor } from '@/data/brand-colors';

const allProducts = await getCollection('products');
const allBrands = await getCollection('brands');

// Best sellers: products tagged "popular" by Nyehandel (real sales data),
// with brand diversity (max 1 per brand) so the grid showcases variety.
// Secondary sort by name for stable ordering when badges are equal.
const sortedByPopularity = [...allProducts]
  .filter((p) => p.data.imageUrl)
  .sort((a, b) => {
    const aPopular = a.data.badgeKeys.includes('popular') ? 1 : 0;
    const bPopular = b.data.badgeKeys.includes('popular') ? 1 : 0;
    if (bPopular !== aPopular) return bPopular - aPopular;
    return a.data.name.localeCompare(b.data.name);
  });
const bestSellers: typeof sortedByPopularity = [];
const brandCount: Record<string, number> = {};
for (const p of sortedByPopularity) {
  if (bestSellers.length >= 8) break;
  const b = p.data.brand;
  if ((brandCount[b] ?? 0) >= 1) continue;
  brandCount[b] = (brandCount[b] ?? 0) + 1;
  bestSellers.push(p);
}

// Brands sorted alphabetically — only those with at least one product
const brandSlugsWithProducts = new Set(allProducts.map((p) => p.data.brandSlug));
const activeBrands = allBrands.filter((b) => brandSlugsWithProducts.has(b.id));
const brands = [...activeBrands].sort((a, b) => a.data.name.localeCompare(b.data.name));
const heroDescription = `${allProducts.length}+ pouches from ${brands.length} premium brands. EU warehouse, next-day shipping, secure checkout. Real reviews from real customers.`;

// New Arrivals: products with 'new' badge or most recently updated (must have images)
const newArrivals = allProducts
  .filter((p) => p.data.imageUrl && (p.data.badgeKeys.includes('new') || p.data.badgeKeys.includes('NewPrice')))
  .sort((a, b) => (b.data.updatedAt ?? '').localeCompare(a.data.updatedAt ?? ''))
  .slice(0, 4);

// Staff Picks: curated top-rated products across diverse brands (1 per brand)
const staffPickBrands = ['zyn', 'velo', 'loop', 'skruf'];
const staffPicks = staffPickBrands
  .map((slug) => {
    const brandProducts = sortedByPopularity.filter((p) => p.data.brandSlug === slug && p.data.imageUrl);
    return brandProducts[0];
  })
  .filter(Boolean);

// Popular Brands: top brands by product count (GSC internal linking signal)
const brandProductCounts = new Map<string, number>();
for (const p of allProducts) {
  brandProductCounts.set(p.data.brandSlug, (brandProductCounts.get(p.data.brandSlug) ?? 0) + 1);
}
const popularBrands = [...activeBrands]
  .sort((a, b) => (brandProductCounts.get(b.id) ?? 0) - (brandProductCounts.get(a.id) ?? 0))
  .slice(0, 8);

// For each popular brand, pick the top-rated product with an image as the showcase
const popularBrandShowcase = popularBrands.map((brand) => {
  const topProduct = allProducts
    .filter((p) => p.data.brandSlug === brand.id && p.data.imageUrl)
    .sort((a, b) => (b.data.ratings || 0) - (a.data.ratings || 0))[0];
  return { brand, productCount: brandProductCounts.get(brand.id) ?? 0, topProduct };
});

// Pick 10 hero products with diverse brands for the 3D showcase
const heroBrandTargets = ['zyn', 'velo', 'siberia', 'loop', 'skruf', 'nordic-spirit', 'pablo', 'iceberg', 'white-fox', 'killa'];
const heroProducts = heroBrandTargets
  .map((slug) => allProducts.find((p) => p.data.brandSlug === slug && p.data.imageUrl && p.data.stock > 0))
  .filter(Boolean)
  .slice(0, 10);

// Fallback: fill up to 10 with popular products from other brands
if (heroProducts.length < 10) {
  for (const p of sortedByPopularity) {
    if (heroProducts.length >= 10) break;
    if (p.data.imageUrl && !heroProducts.some((h) => h!.data.brandSlug === p.data.brandSlug)) {
      heroProducts.push(p);
    }
  }
}

// Brand logo images for the marquee
const topBrandNames = brands.slice(0, 12).map(b => b.data.name);

const liveBrandNames = brands.slice(0, 20).map(b => b.data.name.toUpperCase());
---

<Shop
  title={tenant.seo.defaultTitle}
  description={heroDescription}
  ogImage={tenant.seo.ogImage}
>
  <!-- Hero — Immersive 3D product showcase -->
  <section class="relative overflow-hidden border-b border-border" style={`background: hsl(var(--hero-bg));`}>

    <!-- Background gradient -->
    <div class="absolute inset-0" style={`background: linear-gradient(to bottom right, hsl(var(--hero-gradient-from)), hsl(var(--hero-gradient-via)), hsl(var(--hero-gradient-to)));`} />

    <!-- Ambient glow orbs -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="hero-glow-1 absolute w-96 h-96 rounded-full opacity-20" style="background: radial-gradient(circle, hsl(var(--primary) / 0.4) 0%, transparent 70%); top: -10%; right: 10%;" />
      <div class="hero-glow-2 absolute w-80 h-80 rounded-full opacity-15" style="background: radial-gradient(circle, hsl(153 55% 30% / 0.3) 0%, transparent 70%); bottom: -5%; left: 15%;" />
    </div>

    <div class="relative mx-auto flex max-w-7xl flex-col items-center gap-8 px-6 py-16 sm:py-20 lg:py-28 lg:flex-row lg:gap-16 lg:px-8">

      <!-- Left: text with staggered reveal -->
      <div class="flex-1 text-center lg:text-left z-10">
        <p class="hero-reveal mb-3 text-sm font-medium uppercase tracking-widest" style={`color: hsl(var(--hero-muted)); animation: heroSlideUp 0.6s ease-out both;`}>
          Europe's #1 Nicotine Pouch Shop
        </p>
        <h1 class="hero-reveal text-4xl font-bold tracking-tight sm:text-5xl lg:text-[3.5rem] lg:leading-[1.1]" style={`color: hsl(var(--hero-text)); font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif; animation: heroSlideUp 0.6s ease-out 0.1s both;`}>
          Europe's Largest Nicotine<br class="hidden sm:block" /> Pouch Selection
        </h1>
        <p class="hero-reveal mx-auto mt-4 max-w-xl text-lg lg:mx-0" style={`color: hsl(var(--hero-muted)); animation: heroSlideUp 0.6s ease-out 0.2s both;`}>
          {heroDescription}
        </p>

        <!-- Animated stats row -->
        <div class="hero-reveal mt-8 flex justify-center gap-8 lg:justify-start" style="animation: heroSlideUp 0.6s ease-out 0.3s both;">
          <div>
            <div class="text-3xl font-bold tabular-nums" style={`color: hsl(var(--hero-text));`} data-count-to={allProducts.length}>{allProducts.length}</div>
            <div class="text-xs" style={`color: hsl(var(--hero-muted));`}>Products</div>
          </div>
          <div class="h-10 w-px" style={`background: hsl(var(--hero-divider) / 0.15);`} />
          <div>
            <div class="text-3xl font-bold tabular-nums" style={`color: hsl(var(--hero-text));`} data-count-to={brands.length}>{brands.length}</div>
            <div class="text-xs" style={`color: hsl(var(--hero-muted));`}>Brands</div>
          </div>
          <div class="h-10 w-px" style={`background: hsl(var(--hero-divider) / 0.15);`} />
          <div>
            <div class="text-3xl font-bold" style={`color: hsl(var(--primary));`}>4.8★</div>
            <div class="text-xs" style={`color: hsl(var(--hero-muted));`}>Verified Reviews</div>
          </div>
        </div>

        <!-- CTAs -->
        <div class="hero-reveal mt-8 flex flex-col items-center gap-3 sm:flex-row lg:justify-start" style="animation: heroSlideUp 0.6s ease-out 0.4s both;">
          <a
            href="/nicotine-pouches"
            class="inline-flex h-12 items-center rounded-lg px-8 text-base font-semibold shadow-lg shadow-primary/20 transition hover:shadow-xl hover:shadow-primary/30 hover:scale-[1.02]"
            style={`background: hsl(var(--hero-cta-bg)); color: hsl(var(--hero-cta-text));`}
          >
            Shop All Pouches
          </a>
          <a
            href="/flavor-quiz"
            class="inline-flex h-12 items-center rounded-lg border px-8 text-base font-semibold transition hover:bg-white/5"
            style={`border-color: hsl(var(--hero-text) / 0.2); color: hsl(var(--hero-text));`}
          >
            Take the Flavour Quiz
          </a>
        </div>
      </div>

      <!-- Right: 3D orbital product showcase (desktop) -->
      <div class="hidden flex-1 items-center justify-center lg:flex">
        <div class="hero-orbit relative" style="width: 420px; height: 420px; perspective: 800px;">
          <!-- Orbital ring of products -->
          <div class="hero-orbit-ring absolute inset-0" style="transform-style: preserve-3d; animation: heroOrbit 30s linear infinite;">
            {heroProducts.slice(0, 8).map((p, i) => {
              if (!p) return null;
              const angle = (i / 8) * 360;
              const radius = 160;
              return (
                <img
                  src={p.data.imageUrl}
                  alt={p.data.name}
                  width="100"
                  height="100"
                  class="hero-orbit-item absolute rounded-xl"
                  style={`
                    left: 50%; top: 50%;
                    width: 100px; height: 100px;
                    margin: -50px 0 0 -50px;
                    transform: rotateY(${angle}deg) translateZ(${radius}px);
                    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.4));
                    backface-visibility: hidden;
                  `}
                  loading="eager"
                />
              );
            })}
          </div>

          <!-- Center featured product (larger, floating) -->
          {heroProducts[0] && (
            <div class="absolute inset-0 flex items-center justify-center z-10 pointer-events-none">
              <img
                src={heroProducts[0]!.data.imageUrl}
                alt={heroProducts[0]!.data.name}
                width="180"
                height="180"
                class="hero-center-can rounded-2xl"
                style="animation: heroCenterFloat 4s ease-in-out infinite; filter: drop-shadow(0 20px 40px rgba(0,0,0,0.5)) drop-shadow(0 0 20px hsl(var(--primary) / 0.15));"
                loading="eager"
              />
            </div>
          )}

          <!-- Glow ring behind orbit -->
          <div class="absolute inset-8 rounded-full opacity-20" style="background: conic-gradient(from 0deg, hsl(var(--primary) / 0.3), transparent 30%, hsl(153 55% 30% / 0.2) 50%, transparent 70%, hsl(var(--primary) / 0.3)); animation: heroOrbit 20s linear infinite reverse; filter: blur(20px);" />
        </div>
      </div>

      <!-- Mobile: scrolling product strip with 3D -->
      <div class="flex gap-4 overflow-x-auto pb-2 lg:hidden snap-x snap-mandatory px-1" style="perspective: 400px;">
        {heroProducts.slice(0, 6).map((p, i) => p && (
          <img
            src={p.data.imageUrl}
            alt={p.data.name}
            width="112"
            height="112"
            class="flex-shrink-0 snap-center rounded-xl w-24 h-24 sm:w-28 sm:h-28 hero-can"
            style={`animation: heroFloat${(i % 4) + 1} ${6 + i * 0.5}s ease-in-out infinite ${i * 0.3}s; filter: drop-shadow(0 12px 20px rgba(0,0,0,0.3));`}
            loading="eager"
          />
        ))}
      </div>
    </div>

    <!-- Live brand ticker (bottom) -->
    <div class="relative z-20 overflow-hidden" style="background: rgba(0,0,0,0.52); border-top: 1px solid rgba(255,255,255,0.05);">
      <div class="flex items-stretch" style="height: 30px;">
        <div class="flex-shrink-0 flex items-center gap-2 px-3 border-r" style="background: hsl(var(--primary) / 0.82); border-color: rgba(255,255,255,0.1); min-width: max-content;">
          <span class="relative flex h-1.5 w-1.5 flex-shrink-0">
            <span class="live-ping absolute inline-flex h-full w-full rounded-full opacity-75" style="background: #86efac;"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full" style="background: white;"></span>
          </span>
          <span class="text-white text-[9px] font-black tracking-[0.22em] uppercase whitespace-nowrap">Live</span>
        </div>
        <div class="overflow-hidden flex-1">
          <div class="live-ticker flex items-center h-full whitespace-nowrap" style="animation: liveTicker 28s linear infinite;">
            {[...liveBrandNames, ...liveBrandNames].map((name) => (
              <span class="inline-flex items-center flex-shrink-0">
                <span class="text-[10px] font-bold tracking-[0.14em] px-5" style="color: rgba(255,255,255,0.28);">{name}</span>
                <span class="flex-shrink-0" style="color: hsl(var(--primary) / 0.38); font-size: 7px;">◆</span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Beginner CTA strip -->
  <section class="border-b border-primary/20 bg-primary/5">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/15 text-lg">
            🌱
          </div>
          <div>
            <p class="text-sm font-semibold text-foreground">New to nicotine pouches?</p>
            <p class="text-xs text-muted-foreground">We'll help you pick a safe, gentle starting point. No pressure.</p>
          </div>
        </div>
        <div class="flex gap-2">
          <a href="/flavor-quiz" class="rounded-lg bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground hover:bg-primary/90 transition">
            Take the Quiz
          </a>
          <a href="/beginners" class="rounded-lg border border-primary/30 px-4 py-2 text-xs font-medium text-foreground hover:bg-primary/10 transition">
            Beginner Guide
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Rewards strip — above the fold gamification visibility -->
  <section class="border-b border-border bg-card/30">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between gap-4 py-3 overflow-x-auto">
        <a href="/rewards" class="flex items-center gap-2 whitespace-nowrap text-sm font-medium text-foreground hover:text-primary transition-colors" data-astro-prefetch>
          <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-primary/15 text-primary" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
          </span>
          Earn SnusCoins
        </a>
        <span class="hidden sm:block h-4 w-px bg-border" aria-hidden="true" />
        <a href="/rewards#spin" class="flex items-center gap-2 whitespace-nowrap text-sm font-medium text-foreground hover:text-primary transition-colors" data-astro-prefetch>
          <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-amber-500/15 text-amber-500" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m16 12-4-4-4 4"/><path d="M12 16V8"/></svg>
          </span>
          Daily Drop
        </a>
        <span class="hidden sm:block h-4 w-px bg-border" aria-hidden="true" />
        <a href="/rewards#missions" class="flex items-center gap-2 whitespace-nowrap text-sm font-medium text-foreground hover:text-primary transition-colors" data-astro-prefetch>
          <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-500" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
          </span>
          Missions
        </a>
        <span class="hidden sm:block h-4 w-px bg-border" aria-hidden="true" />
        <a href="/community" class="flex items-center gap-2 whitespace-nowrap text-sm font-medium text-foreground hover:text-primary transition-colors" data-astro-prefetch>
          <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-purple-500/15 text-purple-500" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </span>
          The Board
        </a>
        <span class="hidden sm:block h-4 w-px bg-border" aria-hidden="true" />
        <a href="/rewards" class="hidden md:inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-1.5 text-xs font-semibold text-primary-foreground transition hover:bg-primary/90 whitespace-nowrap" data-astro-prefetch>
          Free to join. Coins on every order &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Purchase-based recommendations (logged-in users only) -->
  <RecommendationsIsland
    client:idle
    productsJson={JSON.stringify(allProducts.slice(0, 200).map((p) => ({
      slug: p.id,
      name: p.data.name,
      brand: p.data.brand,
      brandSlug: p.data.brandSlug,
      flavorKey: p.data.flavorKey,
      imageUrl: p.data.imageUrl,
      ratings: p.data.ratings,
      prices: { pack1: p.data.prices.pack1 },
    })))}
  />

  <!-- Recently Viewed (client-side, shows only if user has browsing history) -->
  <RecentlyViewedIsland
    client:idle
    productsJson={JSON.stringify(allProducts.slice(0, 200).map((p) => ({
      slug: p.id,
      name: p.data.name,
      brand: p.data.brand,
      imageUrl: p.data.imageUrl,
      prices: { pack1: p.data.prices.pack1 },
    })))}
  />

  <!-- Trust bar -->
  <section class="border-b border-border bg-background py-4">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-8 gap-y-2 px-4 sm:px-6 lg:px-8 text-muted-foreground">
      <div class="flex items-center gap-1.5">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <span class="text-xs font-medium">Free shipping &euro;{tenant.freeShippingThreshold}+</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
        <span class="text-xs font-medium">Ships from EU warehouse</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
        <span class="text-xs font-medium">Secure checkout</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        <span class="text-xs font-medium">Same-day dispatch</span>
      </div>
    </div>
  </section>

  <!-- Best Sellers -->
  <section id="best-sellers" class="border-b border-border bg-background py-16 sm:py-20 lg:py-24 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 flex items-end justify-between">
        <div>
          <h2 class="text-2xl font-bold text-foreground sm:text-3xl">Best Sellers</h2>
          <p class="mt-2 text-muted-foreground">Our most popular nicotine pouches this week</p>
        </div>
        <a href="/products" class="hidden text-sm font-medium text-primary hover:underline sm:block">
          View all &rarr;
        </a>
      </div>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-5 xl:gap-6">
        {bestSellers.length > 0 ? (
          bestSellers.map((product) => (
            <ProductCard
              slug={product.id}
              name={product.data.name}
              brand={product.data.brand}
              brandSlug={product.data.brandSlug}
              imageUrl={product.data.imageUrl}
              prices={product.data.prices}
              stock={product.data.stock}
              nicotineContent={product.data.nicotineContent}
              strengthKey={product.data.strengthKey}
              flavorKey={product.data.flavorKey}
              ratings={product.data.ratings}
              badgeKeys={product.data.badgeKeys}
            />
          ))
        ) : (
          <div role="status" aria-label="Loading cans" class="col-span-full grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-5 xl:gap-6">
            {Array.from({ length: 8 }).map(() => (
              <div class="group rounded-xl border border-border bg-card/50 p-4 backdrop-blur">
                <div class="mb-3 aspect-square rounded-lg bg-muted/30 animate-pulse" />
                <div class="mb-2 h-4 w-3/4 rounded bg-muted/30 animate-pulse" />
                <div class="h-3 w-1/2 rounded bg-muted/30 animate-pulse" />
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Staff Picks -->
  {staffPicks.length > 0 && (
    <section id="staff-picks" class="border-b border-border bg-card/30 py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10">
          <h2 class="text-2xl font-bold text-foreground sm:text-3xl">Staff Picks</h2>
          <p class="mt-2 text-muted-foreground">Curated by our editorial team — one standout from each top brand</p>
        </div>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 xl:gap-6">
          {staffPicks.map((product) => product && (
            <ProductCard
              slug={product.id}
              name={product.data.name}
              brand={product.data.brand}
              brandSlug={product.data.brandSlug}
              imageUrl={product.data.imageUrl}
              prices={product.data.prices}
              stock={product.data.stock}
              nicotineContent={product.data.nicotineContent}
              strengthKey={product.data.strengthKey}
