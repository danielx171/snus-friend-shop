---
export const prerender = true;
import { Image } from 'astro:assets';
import Shop from '@/layouts/Shop.astro';
import Breadcrumb from '@/components/astro/Breadcrumb.astro';
import ProductCard from '@/components/astro/ProductCard.astro';
import { getCollection } from 'astro:content';
import { brandColors, defaultBrandColor } from '@/data/brand-colors';
import { brandDescriptions } from '@/data/brand-descriptions';
import { brandFaqs } from '@/data/brand-faqs';
import { brandMeta } from '@/data/brand-meta';

export async function getStaticPaths() {
  const brands = await getCollection('brands');
  const products = await getCollection('products');

  return brands.map((brand) => ({
    params: { slug: brand.id },
    props: {
      brand,
      products: products.filter((p) => p.data.brandSlug === brand.id),
    },
  }));
}

const { brand, products } = Astro.props;
const b = brand.data;

// Strength dots mapping (same as products/index.astro)
const strengthDots: Record<string, number> = {
  light: 1,
  normal: 2,
  strong: 3,
  'extra-strong': 4,
  'super-strong': 5,
};

const countryNames: Record<string, string> = {
  SE: 'Sweden',
  DK: 'Denmark',
  NO: 'Norway',
  US: 'United States',
  UK: 'United Kingdom',
  DE: 'Germany',
  FI: 'Finland',
  CH: 'Switzerland',
};

const countryLabel = b.countryCode ? (countryNames[b.countryCode] ?? b.countryCode) : '';
const bColor = brandColors[brand.id] ?? defaultBrandColor;

const nicotineValues = products.map((p) => p.data.nicotineContent).filter(Boolean);
const minMg = nicotineValues.length ? Math.min(...nicotineValues) : 0;
const maxMg = nicotineValues.length ? Math.max(...nicotineValues) : 0;

// New arrivals: updated in last 60 days or has 'new' badge
const sixtyDaysAgo = new Date(Date.now() - 60 * 86400000).toISOString();
const newProducts = products
  .filter(p => (p.data.updatedAt && p.data.updatedAt > sixtyDaysAgo) || p.data.badgeKeys?.includes('new'))
  .sort((a, b) => (b.data.updatedAt || '').localeCompare(a.data.updatedAt || ''))
  .slice(0, 6);

// Mosaic: first 5 products with images
const mosaicProducts = products.filter((p) => p.data.imageUrl).slice(0, 5);

// Mosaic grid positions: first cell spans 2 rows (hero), then 4 small cells
const mosaicPositions = [
  { gridColumn: '1 / 2', gridRow: '1 / 3', size: 'lg' },
  { gridColumn: '2 / 3', gridRow: '1 / 2', size: 'sm' },
  { gridColumn: '3 / 4', gridRow: '1 / 2', size: 'sm' },
  { gridColumn: '2 / 3', gridRow: '2 / 3', size: 'sm' },
  { gridColumn: '3 / 4', gridRow: '2 / 3', size: 'sm' },
];

const meta = brandMeta[brand.id];
const metaTitle = meta?.title || `${b.name} Nicotine Pouches | SnusFriend`;
const metaDescription = meta?.description || `Shop ${b.name} nicotine pouches at SnusFriend. Browse the full range with free EU shipping.`;
const faqs = brandFaqs[brand.id];
---

<Shop
  title={metaTitle}
  description={metaDescription}
  canonical={`/brands/${brand.id}`}
>
  {faqs && faqs.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": { "@type": "Answer", "text": f.answer },
      })),
    })} />
  )}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": `${b.name} Nicotine Pouches`,
    "description": metaDescription,
    "url": `https://snusfriends.com/brands/${brand.id}`,
    "numberOfItems": products.length,
    "provider": {
      "@type": "Organization",
      "name": "SnusFriend",
      "url": "https://snusfriends.com"
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Brand",
    "name": b.name,
    ...(b.logoUrl && { "logo": b.logoUrl }),
    "description": metaDescription,
    "url": `https://snusfriends.com/brands/${brand.id}`,
    ...(b.manufacturer && { "manufacturer": { "@type": "Organization", "name": b.manufacturer } })
  })} />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={[
      { label: 'Brands', href: '/brands' },
      { label: b.name },
    ]} />

    <!-- Brand Mosaic Header -->
    <div class="relative mb-8 overflow-hidden rounded-2xl" style="background: #0c1018; min-height: 220px;">

      <!-- Brand color ambient glow — subtle, anchored to top-left -->
      <div class="absolute inset-0" style={`background: radial-gradient(ellipse at 10% 30%, ${bColor}25 0%, transparent 50%), radial-gradient(ellipse at 90% 80%, ${bColor}10 0%, transparent 40%);`}></div>

      <!-- Brand-colored radial glow behind mosaic -->
      <div class="absolute right-0 top-0 bottom-0 w-2/3 pointer-events-none" style={`background: radial-gradient(ellipse at 70% 50%, ${bColor}15 0%, transparent 70%);`} />

      <!-- Product mosaic grid — right side, fades in from right -->
      {mosaicProducts.length > 0 && (
        <div
          class="absolute top-0 right-0 bottom-0 hidden sm:grid"
          style="width: 65%; grid-template-columns: 1fr 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 2px; mask-image: linear-gradient(to right, transparent 0%, black 30%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 30%);"
        >
          {mosaicProducts.map((p, i) => {
            const pos = mosaicPositions[i];
            const imgSize = pos.size === 'lg' ? 200 : 120;
            return (
              <div
                class="relative overflow-hidden flex items-center justify-center"
                style={`grid-column: ${pos.gridColumn}; grid-row: ${pos.gridRow}; background: radial-gradient(circle at 50% 50%, ${bColor}15 0%, transparent 70%);`}
              >
                <img
                  src={p.data.imageUrl}
                  alt={`${b.name} product ${i + 1}`}
                  width={imgSize}
                  height={imgSize}
                  loading="lazy"
                  class="object-contain rounded-full"
                  style={`width: ${imgSize}px; height: ${imgSize}px; filter: drop-shadow(0 4px 12px rgba(0,0,0,0.4)); opacity: 0.75;`}
                />
              </div>
            );
          })}
        </div>
      )}

      <!-- Mobile product strip — visible only on small screens -->
      {mosaicProducts.length > 0 && (
        <div class="absolute bottom-0 right-0 left-0 flex items-end justify-end gap-1 p-3 sm:hidden" style="mask-image: linear-gradient(to right, transparent 0%, black 40%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 40%);">
          {mosaicProducts.slice(0, 3).map((p, i) => (
            <img
              src={p.data.imageUrl}
              alt={`${b.name} product`}
              width="60"
              height="60"
              loading="lazy"
              class="rounded-lg object-contain"
              style={`width: 52px; height: 52px; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.4)); opacity: ${0.9 - i * 0.15};`}
            />
          ))}
        </div>
      )}

      <!-- Dark overlay gradient: full opacity left → semi-transparent right (text readability) -->
      <div class="absolute inset-0" style="background: linear-gradient(90deg, #0c1018 0%, #0c1018dd 40%, #0c101888 70%, #0c101866 100%);"></div>

      <!-- Top accent line — brand color -->
      <div class="absolute top-0 left-0 right-0 h-[3px] z-10" style={`background: linear-gradient(90deg, ${bColor}, ${bColor}88, transparent 80%);`}></div>

      <!-- Content -->
      <div class="relative z-10 flex flex-col items-start gap-5 p-6 sm:flex-row sm:items-center sm:p-8">

        <!-- Logo or initials badge -->
        {b.logoUrl ? (
          <div
            class="flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-xl"
            style={`background: linear-gradient(135deg, ${bColor}30, ${bColor}15); border: 1px solid ${bColor}25; backdrop-filter: blur(12px);`}
          >
            <Image
              src={b.logoUrl}
              alt={`${b.name} logo`}
              width={80}
              height={80}
              loading="eager"
              format="webp"
              class="h-full w-full object-contain"
            />
          </div>
        ) : (
          <span class="text-3xl font-extrabold tracking-tight" style={`color: ${bColor}`}>
            {b.name}
          </span>
        )}

        <!-- Brand info -->
        <div class="flex-1 min-w-0">
          <h1
            class="text-3xl font-extrabold tracking-tight sm:text-4xl"
            style="color: #f1f5f9; font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif;"
          >
            {b.name}
          </h1>

          <!-- Metadata chips -->
          <div class="mt-3 flex flex-wrap items-center gap-2">
            {countryLabel && (
              <span
                class="rounded-full px-3 py-1 text-xs font-medium"
                style="background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.7); border: 1px solid rgba(255,255,255,0.08);"
              >
                {countryLabel}
              </span>
            )}
            {b.manufacturer && (
              <span
                class="rounded-full px-3 py-1 text-xs font-medium"
                style="background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.7); border: 1px solid rgba(255,255,255,0.08);"
              >
                by {b.manufacturer}
              </span>
            )}
            <span
              class="rounded-full px-3 py-1 text-xs font-medium"
              style={`background: ${bColor}15; color: ${bColor}; border: 1px solid ${bColor}25;`}
            >
              {products.length} cans
            </span>
            {minMg > 0 && (
              <span
                class="rounded-full px-3 py-1 text-xs font-medium"
                style="background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.7); border: 1px solid rgba(255,255,255,0.08);"
              >
                {minMg}–{maxMg} mg
              </span>
            )}
          </div>
        </div>
      </div>
    </div>

    {/* Sub-page navigation */}
    <div class="mb-6 flex flex-wrap gap-2">
      <a href={`/brands/${brand.id}`} class="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground">All Products</a>
      <a href={`/brands/${brand.id}/flavours`} class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground hover:border-primary/30 transition">Flavours</a>
      <a href={`/brands/${brand.id}/strengths`} class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground hover:border-primary/30 transition">Strengths</a>
      <a href={`/brands/${brand.id}/review`} class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground hover:border-primary/30 transition">Review</a>
    </div>

    {/* Brand description — always visible */}
    <div class="mb-8 max-w-3xl">
      <h2 class="text-lg font-semibold text-foreground mb-3">About {b.name}</h2>
      <p class="text-sm leading-relaxed text-muted-foreground">
        {brandDescriptions[brand.id] || b.description || `${b.name} nicotine pouches are available on SnusFriend with fast EU-wide delivery.`}
      </p>
    </div>

    <!-- New on Brand section -->
    {newProducts.length > 0 && (
      <section class="mb-8">
        <div class="mb-4 flex items-center gap-2">
          <h2 class="text-xl font-semibold text-foreground">New on {b.name}</h2>
          <span
            class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-semibold"
            style={`background: ${bColor}15; color: ${bColor}; border: 1px solid ${bColor}25;`}
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            Fresh
          </span>
        </div>
        <div
          class="flex gap-4 overflow-x-auto pb-4 scrollbar-thin sm:grid sm:grid-cols-3 sm:overflow-visible sm:pb-0 lg:grid-cols-4 xl:grid-cols-6"
          style="-webkit-overflow-scrolling: touch;"
        >
          {newProducts.map((product) => (
            <div class="min-w-[200px] shrink-0 sm:min-w-0" style={`border-radius: 1rem; box-shadow: 0 0 0 1px ${bColor}20, 0 2px 12px ${bColor}08;`}>
              <ProductCard
                slug={product.id}
                name={product.data.name}
                brand={product.data.brand}
                brandSlug={product.data.brandSlug}
                imageUrl={product.data.imageUrl}
                prices={product.data.prices}
                stock={product.data.stock}
                nicotineContent={product.data.nicotineContent}
                strengthKey={product.data.strengthKey}
                flavorKey={product.data.flavorKey}
                ratings={product.data.ratings}
                comparePrice={product.data.comparePrice}
                portionsPerCan={product.data.portionsPerCan}
                badgeKeys={product.data.badgeKeys}
              />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Products section -->
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-xl font-semibold text-foreground">
        {products.length > 0 ? `${b.name} Products` : 'Products'}
      </h2>
      <p class="text-sm text-muted-foreground">
        {products.length} {products.length === 1 ? 'can' : 'cans'}
      </p>
    </div>

    <!-- Product grid (matches products/index.astro style) -->
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-5 xl:gap-6">
      {products.map((product) => {
        const dots = strengthDots[product.data.strengthKey] ?? 2;
        const price = product.data.prices?.pack1;
        return (
          <a
            href={`/products/${product.id}`}
            class="group rounded-xl border border-border bg-card/70 p-3 transition hover:border-primary/30 hover:shadow-lg hover:shadow-primary/5 sm:p-4"
          >
            {/* Product image */}
            {product.data.imageUrl ? (
              <div class="mb-3 aspect-square overflow-hidden rounded-lg bg-muted/20">
                <Image
                  src={product.data.imageUrl}
                  alt={product.data.name}
                  width={300}
                  height={300}
                  loading="lazy"
                  format="webp"
                  quality={80}
                  class="h-full w-full object-contain transition group-hover:scale-105"
                />
              </div>
            ) : (
              <div class="mb-3 flex aspect-square items-center justify-center rounded-lg bg-muted/20">
                <svg
                  class="h-10 w-10 text-muted-foreground/30"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1"
                >
                  <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
              </div>
            )}

            {/* Brand */}
            <p class="mb-0.5 truncate text-xs text-muted-foreground">
              {product.data.brand}
            </p>

            {/* Product name */}
            <h3 class="mb-1.5 line-clamp-2 text-sm font-semibold leading-snug text-foreground group-hover:text-primary">
              {product.data.name}
            </h3>

            {/* Strength dots */}
            <div class="mb-2 flex items-center gap-1" role="img" aria-label={`Strength: ${product.data.strengthKey}`}>
              {Array.from({ length: 5 }).map((_, i) => (
                <span
                  class={`inline-block h-1.5 w-1.5 rounded-full ${
                    i < dots ? 'bg-primary' : 'bg-muted-foreground/20'
                  }`}
                />
              ))}
              <span class="ml-1 text-xs text-muted-foreground">
                {product.data.nicotineContent > 0 ? `${product.data.nicotineContent}mg` : ''}
              </span>
            </div>

            {/* Price */}
            {price != null && (
              <div class="flex items-baseline gap-1.5">
                <span class="text-base font-bold text-foreground">
                  &euro;{price.toFixed(2)}
                </span>
                {product.data.comparePrice != null && product.data.comparePrice > price && (
                  <span class="text-xs text-muted-foreground line-through">
                    &euro;{product.data.comparePrice.toFixed(2)}
                  </span>
                )}
              </div>
            )}
          </a>
        );
      })}

      {/* Empty state */}
      {products.length === 0 && (
        <div class="col-span-full py-20 text-center">
          <p class="text-lg text-muted-foreground">
            No products found for {b.name} yet. Check back soon.
          </p>
        </div>
      )}
    </div>

    {/* Brand FAQ section */}
    {faqs && faqs.length > 0 && (
      <section class="mt-12 max-w-3xl">
        <h2 class="text-xl font-bold text-foreground mb-6">{b.name} FAQ</h2>
        {faqs.map(faq => (
          <details class="mb-3 rounded-lg border border-border bg-card/40 px-4 py-3">
            <summary class="cursor-pointer font-medium text-foreground">{faq.question}</summary>
            <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </section>
    )}
  </div>
</Shop>
