---
export const prerender = true;
import Shop from '@/layouts/Shop.astro';
import Breadcrumb from '@/components/astro/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { ensureProductsJson } from '@/lib/product-json';
import { tenant } from '@/config/tenant';

const products = await getCollection('products');
ensureProductsJson(products);

const strengthLabels: Record<string, string> = {
  normal: 'Normal', strong: 'Strong', 'extra-strong': 'Extra Strong', 'super-strong': 'Super Strong',
};
const flavorLabels: Record<string, string> = {
  mint: 'Mint', berry: 'Berry', citrus: 'Citrus', fruit: 'Fruit', coffee: 'Coffee',
  cola: 'Cola', menthol: 'Menthol', tropical: 'Tropical', ice: 'Ice',
  original: 'Original', tobacco: 'Tobacco', licorice: 'Licorice', vanilla: 'Vanilla',
};
---

<Shop
  title="Compare Nicotine Pouches Side by Side | SnusFriend"
  description="Compare nicotine pouches side by side — strength, flavour, price, format, and brand. Select 2-4 products and see how they stack up."
  canonical="/compare"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Compare Nicotine Pouches",
    "description": "Compare nicotine pouches side by side — strength, flavour, price, format, and brand.",
    "url": "https://snusfriends.com/compare",
  })} />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={[{ label: 'Compare' }]} />

    <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-3">
      Compare Nicotine Pouches
    </h1>
    <p class="text-base text-muted-foreground mb-8 max-w-2xl">
      Select 2-4 products to compare side by side. See how they stack up on strength, flavour, price per can, and format.
    </p>

    <!-- Search input -->
    <div class="mb-6 max-w-md">
      <label for="compare-search" class="block text-sm font-medium text-foreground mb-1.5">
        Add a product
      </label>
      <input
        id="compare-search"
        type="text"
        placeholder="Type a product name or brand..."
        autocomplete="off"
        class="w-full rounded-lg border border-border bg-background px-4 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
      />
      <div id="compare-results" class="hidden mt-1 max-h-52 overflow-y-auto rounded-lg border border-border bg-card shadow-lg"></div>
    </div>

    <!-- Selected products chips -->
    <div id="compare-chips" class="flex flex-wrap gap-2 mb-6"></div>

    <!-- Comparison table -->
    <div id="compare-table" class="mb-8"></div>

    <!-- Empty state -->
    <div id="compare-empty" class="rounded-xl border border-border bg-card/80 p-12 text-center">
      <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
        </svg>
      </div>
      <h2 class="text-lg font-semibold text-foreground mb-2">Compare Products</h2>
      <p class="text-sm text-muted-foreground mb-4">Search and select 2-4 nicotine pouches above to see a detailed side-by-side comparison.</p>
      <div class="flex flex-wrap gap-2 justify-center text-xs text-muted-foreground">
        <span>Compare by: strength</span>
        <span class="text-border">|</span>
        <span>flavour</span>
        <span class="text-border">|</span>
        <span>price</span>
        <span class="text-border">|</span>
        <span>format</span>
        <span class="text-border">|</span>
        <span>nicotine content</span>
        <span class="text-border">|</span>
        <span>rating</span>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ strengthLabels, flavorLabels, currencyCode: tenant.currencyCode }}>
  document.addEventListener('astro:page-load', function() {
    function escapeHtml(str) {
      var div = document.createElement('div');
      div.textContent = String(str);
      return div.innerHTML;
    }

    var allProducts = [];
    var selected = [];
    var input = document.getElementById('compare-search');
    var results = document.getElementById('compare-results');
    var chips = document.getElementById('compare-chips');
    var table = document.getElementById('compare-table');
    var empty = document.getElementById('compare-empty');
    if (!input || !results || !chips || !table || !empty) return;

    // Load products
    fetch('/data/products.json').then(function(r) { return r.json(); }).then(function(products) {
      allProducts = products;
      var params = new URLSearchParams(window.location.search);
      var initial = params.get('products');
      if (initial) {
        selected = initial.split(',').filter(Boolean).slice(0, 4);
      } else {
        // Pre-select two popular products so the page isn't empty
        var popular = products
          .filter(function(p) { return p.imageUrl && p.stock > 0 && p.prices && p.prices.pack1 > 0; })
          .sort(function(a, b) { return (b.ratings || 0) - (a.ratings || 0); });
        // Pick two from different brands
        if (popular.length >= 2) {
          selected.push(popular[0].slug);
          var second = popular.find(function(p) { return p.brand !== popular[0].brand; });
          if (second) selected.push(second.slug);
          else selected.push(popular[1].slug);
        }
      }
      render();
    });

    function getProduct(slug) {
      return allProducts.find(function(p) { return p.slug === slug; });
    }

    function updateURL() {
      var url = new URL(window.location.href);
      if (selected.length > 0) url.searchParams.set('products', selected.join(','));
      else url.searchParams.delete('products');
      history.replaceState(null, '', url.toString());
    }

    function render() {
      updateURL();
      var selectedProducts = selected.map(getProduct).filter(Boolean);

      // Chips
      if (selected.length > 0) {
        chips.innerHTML = selectedProducts.map(function(p) {
          return '<span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-card/60 px-3 py-1.5 text-xs font-medium text-foreground">' +
            (p.imageUrl ? '<img src="' + escapeHtml(p.imageUrl) + '" alt="" class="w-5 h-5 rounded-full object-cover" />' : '') +
            escapeHtml(p.name) +
            '<button data-remove-slug="' + escapeHtml(p.slug) + '" class="ml-0.5 text-muted-foreground hover:text-foreground transition compare-remove-btn" aria-label="Remove ' + escapeHtml(p.name) + '">&times;</button>' +
          '</span>';
        }).join('') +
        '<button class="rounded-full border border-border px-3 py-1.5 text-xs text-muted-foreground hover:text-foreground hover:bg-muted/50 transition compare-clear-btn">Clear all</button>';
      chips.querySelectorAll('.compare-remove-btn').forEach(function(btn) {
        btn.addEventListener('click', function() { window.__removeCompare(btn.getAttribute('data-remove-slug')); });
      });
      var clearBtn = chips.querySelector('.compare-clear-btn');
      if (clearBtn) clearBtn.addEventListener('click', function() { window.__clearCompare(); });
      } else {
        chips.innerHTML = '';
      }

      // Table
      if (selectedProducts.length >= 2) {
        empty.classList.add('hidden');
        var rows = [
          { label: 'Image', render: function(p) { return p.imageUrl ? '<img src="' + escapeHtml(p.imageUrl) + '" alt="' + escapeHtml(p.name) + '" class="w-16 h-16 rounded-lg object-contain mx-auto" />' : '<div class="w-16 h-16 rounded-lg bg-muted/30 flex items-center justify-center text-muted-foreground/40 mx-auto">-</div>'; } },
          { label: 'Brand', render: function(p) { return '<a href="/brands/' + escapeHtml(p.brandSlug) + '" class="text-primary hover:underline">' + escapeHtml(p.brand) + '</a>'; } },
          { label: 'Nicotine', render: function(p) { return '<span class="font-semibold">' + escapeHtml(p.nicotineContent) + ' mg</span>/pouch'; } },
          { label: 'Strength', render: function(p) { return escapeHtml(strengthLabels[p.strengthKey] || p.strengthKey || 'Normal'); } },
          { label: 'Flavour', render: function(p) { return escapeHtml(flavorLabels[p.flavorKey] || p.flavorKey || '-'); } },
          { label: 'Format', render: function(p) { var f = p.formatKey || 'slim'; return escapeHtml(f.charAt(0).toUpperCase() + f.slice(1)); } },
          { label: 'Portions', render: function(p) { return escapeHtml((p.portionsPerCan || 20) + '/can'); } },
          { label: 'Price (1 can)', render: function(p) { return '<span class="font-bold text-foreground">' + escapeHtml(currencyCode) + ' ' + escapeHtml(p.prices && p.prices.pack1 ? p.prices.pack1.toFixed(2) : '-') + '</span>'; } },
          { label: 'Rating', render: function(p) { return p.ratings > 0 ? escapeHtml(p.ratings.toFixed(1) + '/5') : 'No reviews'; } },
          { label: 'Stock', render: function(p) { return p.stock > 0 ? '<span class="text-primary font-medium">In Stock</span>' : '<span class="text-destructive">Out of Stock</span>'; } },
          { label: '', render: function(p) { return '<a href="/products/' + escapeHtml(p.slug) + '" class="inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground hover:bg-primary/90 transition">View Product</a>'; } },
        ];

        table.innerHTML = '<div class="overflow-x-auto rounded-xl border border-border"><table class="w-full text-sm">' +
          '<thead><tr class="border-b border-border bg-card/60"><th class="text-left px-4 py-3 text-muted-foreground font-medium w-28"></th>' +
          selectedProducts.map(function(p) {
            return '<th class="text-center px-4 py-3 font-semibold text-foreground min-w-[140px]">' + escapeHtml(p.name) + '</th>';
          }).join('') + '</tr></thead><tbody>' +
          rows.map(function(row, i) {
            return '<tr class="' + (i < rows.length - 1 ? 'border-b border-border' : '') + '">' +
              '<td class="px-4 py-3 text-muted-foreground font-medium text-xs">' + row.label + '</td>' +
              selectedProducts.map(function(p) {
                return '<td class="px-4 py-3 text-center text-foreground">' + row.render(p) + '</td>';
              }).join('') + '</tr>';
          }).join('') +
          '</tbody></table></div>' +
          '<p class="text-center text-xs text-muted-foreground mt-4">Share this comparison: <a href="/compare?products=' + encodeURIComponent(selected.join(',')) + '" class="text-primary hover:underline">snusfriends.com/compare?products=' + escapeHtml(selected.join(',')) + '</a></p>';

        // Suggestions: similar products based on flavour, strength, or price
        if (selected.length < 4) {
          var selectedFlavors = selectedProducts.map(function(p) { return p.flavorKey; });
          var selectedStrengths = selectedProducts.map(function(p) { return p.strengthKey; });
          var avgPrice = selectedProducts.reduce(function(s, p) { return s + (p.prices?.pack1 || 0); }, 0) / selectedProducts.length;

          var suggestions = allProducts
            .filter(function(p) {
              if (selected.includes(p.slug)) return false;
              if (!p.imageUrl || p.stock <= 0) return false;
              // Match by flavour, strength, or similar price (within 30%)
              var flavorMatch = selectedFlavors.indexOf(p.flavorKey) !== -1;
              var strengthMatch = selectedStrengths.indexOf(p.strengthKey) !== -1;
              var price = p.prices?.pack1 || 0;
              var priceMatch = price > 0 && Math.abs(price - avgPrice) / avgPrice < 0.3;
              return flavorMatch || strengthMatch || priceMatch;
            })
            .sort(function(a, b) { return (b.ratings || 0) - (a.ratings || 0); })
            .slice(0, 6);

          if (suggestions.length > 0) {
            table.innerHTML += '<div class="mt-8"><h3 class="text-sm font-semibold text-foreground mb-3">You might also want to compare</h3>' +
              '<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">' +
              suggestions.map(function(p) {
                return '<button type="button" data-add-slug="' + escapeHtml(p.slug) + '" class="compare-add-btn flex flex-col items-center gap-2 rounded-xl border border-border bg-card/60 p-3 text-center hover:border-primary/30 hover:bg-primary/5 transition cursor-pointer">' +
                  (p.imageUrl ? '<img src="' + escapeHtml(p.imageUrl) + '" alt="' + escapeHtml(p.name) + '" class="w-12 h-12 rounded-lg object-contain" />' : '') +
                  '<div><p class="text-xs font-medium text-foreground line-clamp-2">' + escapeHtml(p.name) + '</p>' +
                  '<p class="text-[10px] text-muted-foreground">' + escapeHtml(p.brand) + ' · ' + escapeHtml(p.nicotineContent) + 'mg</p></div>' +
                  '<span class="text-[10px] text-primary font-medium">+ Add to compare</span>' +
                '</button>';
              }).join('') +
              '</div></div>';
            table.querySelectorAll('.compare-add-btn').forEach(function(btn) {
              btn.addEventListener('click', function() { window.__addCompare(btn.getAttribute('data-add-slug')); });
            });
          }
        }
      } else if (selected.length === 1) {
        empty.classList.remove('hidden');
        empty.querySelector('p').textContent = 'Add at least one more product to start comparing.';
        table.innerHTML = '';
      } else {
        empty.classList.remove('hidden');
        empty.querySelector('p').textContent = 'Search and select 2-4 nicotine pouches above to see a detailed side-by-side comparison.';
        table.innerHTML = '';
      }

      // Disable input if 4 selected
      input.disabled = selected.length >= 4;
      if (selected.length >= 4) input.placeholder = 'Maximum 4 products selected';
      else input.placeholder = 'Type a product name or brand...';
    }

    // Search
    input.addEventListener('input', function() {
      var q = input.value.toLowerCase().trim();
      if (q.length < 2) { results.classList.add('hidden'); return; }
      var matches = allProducts
        .filter(function(p) { return !selected.includes(p.slug) && (p.name.toLowerCase().includes(q) || p.brand.toLowerCase().includes(q)); })
        .slice(0, 8);
      if (matches.length === 0) { results.classList.add('hidden'); return; }
      results.classList.remove('hidden');
      results.innerHTML = matches.map(function(p) {
        return '<button type="button" data-add-slug="' + escapeHtml(p.slug) + '" class="search-add-btn w-full flex items-center gap-3 px-4 py-2.5 text-left text-sm hover:bg-muted/50 transition border-b border-border last:border-0">' +
          (p.imageUrl ? '<img src="' + escapeHtml(p.imageUrl) + '" alt="" class="w-8 h-8 rounded-full object-cover shrink-0" />' : '<div class="w-8 h-8 rounded-full bg-muted/30 shrink-0"></div>') +
          '<div class="flex-1 min-w-0"><p class="font-medium text-foreground truncate">' + escapeHtml(p.name) + '</p><p class="text-xs text-muted-foreground">' + escapeHtml(p.brand) + ' · ' + escapeHtml(p.nicotineContent) + 'mg</p></div>' +
        '</button>';
      }).join('');
      results.querySelectorAll('.search-add-btn').forEach(function(btn) {
        btn.addEventListener('click', function() { window.__addCompare(btn.getAttribute('data-add-slug')); });
      });
    });

    // Close results on outside click
    document.addEventListener('click', function(e) {
      if (!input.contains(e.target) && !results.contains(e.target)) {
        results.classList.add('hidden');
      }
    });

    window.__addCompare = function(slug) {
      if (selected.length >= 4 || selected.includes(slug)) return;
      selected.push(slug);
      input.value = '';
      results.classList.add('hidden');
      render();
    };
    window.__removeCompare = function(slug) {
      selected = selected.filter(function(s) { return s !== slug; });
      render();
    };
    window.__clearCompare = function() {
      selected = [];
      render();
    };
  });
  </script>
</Shop>
