---
export const prerender = true;
import Shop from '@/layouts/Shop.astro';
import Breadcrumb from '@/components/astro/Breadcrumb.astro';
import JsonLd from '@/components/astro/JsonLd.astro';
import SpinWheelIsland from '@/components/react/SpinWheelIsland';
import PointsRedemptionIsland from '@/components/react/PointsRedemptionIsland';
import { buildAbsoluteUrl } from '@/config/site';
import { tenant } from '@/config/tenant';
import { rewards } from '@/config/rewards';
const loyaltyCurrencyName = tenant.loyaltyCurrencyName;

const tierColors = [
  'from-zinc-500/20 to-zinc-600/10',
  'from-blue-500/20 to-blue-600/10',
  'from-emerald-500/20 to-emerald-600/10',
  'from-purple-500/20 to-purple-600/10',
  'from-amber-500/20 to-amber-600/10',
];
const tierBorders = [
  'border-l-zinc-400',
  'border-l-blue-400',
  'border-l-emerald-400',
  'border-l-purple-400',
  'border-l-amber-400',
];
const tierPerks: Record<string, string[]> = {
  Explorer: [`${rewards.earnRatePerEur} ${loyaltyCurrencyName} per EUR spent`, 'Welcome spin bonus', 'Member-only newsletter'],
  Member: ['Community posting', 'Review reactions', 'Birthday bonus'],
  Connoisseur: ['Custom avatar border', 'Early sale access'],
  Specialist: ['Double mission rewards', 'Exclusive polls', 'Priority customer support'],
  Founder: ['Gold badge', 'VIP support', 'Founder-only vouchers'],
};
const tiers = rewards.tiers.map((t, i) => ({
  name: t.name,
  points: t.threshold.toLocaleString(),
  perks: tierPerks[t.name] ?? [],
  color: tierColors[i] ?? tierColors[0],
  border: tierBorders[i] ?? tierBorders[0],
}));
---

<Shop
  title={`The Vault — Earn ${loyaltyCurrencyName} & Perks | ${tenant.name}`}
  description={`Earn ${loyaltyCurrencyName} on every purchase and redeem them for discounts, free products, and exclusive perks. Level up from Explorer to Founder with ${tenant.name} Rewards.`}
>
  <section class="bg-background text-foreground">
    <div class="max-w-4xl mx-auto px-4 py-12">
      <Breadcrumb items={[{ label: 'Rewards' }]} />

      <!-- Rewards hero — gamified, destination feel -->
      <div id="rewards-preview-hero" class="rewards-hero relative overflow-hidden rounded-3xl border border-primary/25 mb-12">
        <!-- Layered ambient background -->
        <div class="rewards-hero-bg absolute inset-0" aria-hidden="true">
          <div class="absolute inset-0 bg-gradient-to-br from-primary/15 via-card/60 to-background" />
          <div class="absolute -top-40 -right-32 h-96 w-96 rounded-full bg-amber-400/15 blur-3xl" />
          <div class="absolute -bottom-32 -left-24 h-80 w-80 rounded-full bg-primary/25 blur-3xl" />
          <!-- Coin dots pattern -->
          <div class="absolute inset-0 opacity-[0.08]" style="background-image: radial-gradient(circle at 1px 1px, currentColor 1px, transparent 0); background-size: 22px 22px; color: hsl(var(--primary));" />
        </div>

        <div class="relative px-6 sm:px-12 pt-10 pb-8">
          <!-- Eyebrow -->
          <div class="flex items-center justify-center gap-2 mb-4">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-amber-400/20 border border-amber-400/40">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-amber-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
              </svg>
            </span>
            <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-amber-600 dark:text-amber-400">The Vault &middot; {tenant.loyaltyProgramName}</span>
          </div>

          <!-- Headline -->
          <h1 class="text-center text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight mb-4 text-foreground">
            Every pouch. <span class="text-primary">More back.</span>
          </h1>
          <p class="text-center text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto mb-8">
            Every order, review, and daily spin drops {loyaltyCurrencyName} into your Vault. Spend them on real products, not dusty punch cards.
          </p>

          <!-- Logged-in balance slot (populated by client script, hidden by default) -->
          <div id="rewards-balance-slot" class="hidden mx-auto max-w-md mb-6 rounded-2xl border border-primary/30 bg-card/60 backdrop-blur px-6 py-4 text-center">
            <p class="text-[10px] uppercase tracking-widest text-muted-foreground mb-1">Your Vault</p>
            <p class="text-3xl font-black text-primary tabular-nums">
              <span id="rewards-balance-value">0</span>
              <span class="ml-1 text-base font-medium text-muted-foreground">{loyaltyCurrencyName}</span>
            </p>
            <p id="rewards-next-tier" class="mt-1 text-xs text-muted-foreground"></p>
          </div>

          <!-- CTA row -->
          <div id="rewards-cta-row" class="flex flex-col sm:flex-row gap-3 justify-center items-center mb-10">
            <a
              href="/register?redirect=/rewards"
              class="inline-flex items-center justify-center rounded-xl bg-primary px-8 h-12 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 transition hover:bg-primary/90 hover:scale-[1.02]"
            >
              Start earning free
              <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a
              href="#how-it-works"
              class="inline-flex items-center justify-center rounded-xl border border-border bg-card/50 px-6 h-12 text-base font-medium text-foreground transition hover:bg-muted"
            >
              How it works
            </a>
          </div>

          <!-- Stat strip -->
          <div class="grid grid-cols-3 gap-3 sm:gap-6 max-w-3xl mx-auto mb-8">
            <div class="rounded-xl border border-border/60 bg-card/40 backdrop-blur p-3 sm:p-4 text-center">
              <p class="text-2xl sm:text-3xl font-black text-foreground tabular-nums">{rewards.earnRatePerEur}<span class="text-base font-medium text-muted-foreground">/\u20AC</span></p>
              <p class="text-[10px] sm:text-xs uppercase tracking-wider text-muted-foreground mt-1">{loyaltyCurrencyName} per euro</p>
            </div>
            <div class="rounded-xl border border-border/60 bg-card/40 backdrop-blur p-3 sm:p-4 text-center">
              <p class="text-2xl sm:text-3xl font-black text-foreground tabular-nums">{rewards.tiers.length}</p>
              <p class="text-[10px] sm:text-xs uppercase tracking-wider text-muted-foreground mt-1">Circle tiers</p>
            </div>
            <div class="rounded-xl border border-border/60 bg-card/40 backdrop-blur p-3 sm:p-4 text-center">
              <p class="text-2xl sm:text-3xl font-black text-foreground tabular-nums">{rewards.dailyDropMin}&ndash;{rewards.dailyDropMax}</p>
              <p class="text-[10px] sm:text-xs uppercase tracking-wider text-muted-foreground mt-1">Daily Drop range</p>
            </div>
          </div>

          <!-- Tier ladder preview -->
          <div class="max-w-3xl mx-auto">
            <div class="flex items-center justify-between text-[10px] sm:text-xs font-semibold text-muted-foreground mb-2">
              {rewards.tiers.map((t) => (
                <span class="truncate px-1" title={`${t.threshold.toLocaleString()} ${loyaltyCurrencyName}`}>{t.name}</span>
              ))}
            </div>
            <div class="relative h-2 rounded-full bg-muted/40 overflow-hidden">
              <div class="absolute inset-y-0 left-0 w-full bg-gradient-to-r from-zinc-400 via-blue-400 via-emerald-400 via-purple-400 to-amber-400 opacity-70" />
              {rewards.tiers.map((_, i) => (
                <span
                  class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 h-3 w-3 rounded-full bg-background border-2 border-primary"
                  style={`left: ${(i / (rewards.tiers.length - 1)) * 100}%;`}
                />
              ))}
            </div>
            <p class="text-center text-[11px] text-muted-foreground mt-3">
              Climb tiers by earning lifetime coins. Spending doesn't lower your tier.
            </p>
          </div>
        </div>
      </div>

      <script is:inline>
        // Hydrate the logged-in balance slot from window.__AUTH_STATE__ once it's set.
        // Uses the sessionStorage cache written by useSnusPointsLite (header badge)
        // so the number appears instantly without a new Supabase roundtrip.
        document.addEventListener('astro:page-load', function () {
          var TIER_THRESHOLDS = [
            { name: 'Explorer', threshold: 0 },
            { name: 'Member', threshold: 100 },
            { name: 'Connoisseur', threshold: 500 },
            { name: 'Specialist', threshold: 2000 },
            { name: 'Founder', threshold: 5000 },
          ];

          function readBalance(userId) {
            try {
              var raw = sessionStorage.getItem('snuspoints-balance:' + userId);
              if (!raw) return null;
              var parsed = JSON.parse(raw);
              return typeof parsed.balance === 'number' ? parsed.balance : null;
            } catch (e) { return null; }
          }

          function nextTierHint(balance) {
            for (var i = 0; i < TIER_THRESHOLDS.length; i++) {
              var t = TIER_THRESHOLDS[i];
              if (balance < t.threshold) {
                return (t.threshold - balance).toLocaleString() +
                  ` ${loyaltyCurrencyName} to ` + t.name + '.';
              }
            }
            return 'You\u2019ve hit the top tier. Legend.';
          }

          var trySwap = function () {
            var auth = window.__AUTH_STATE__;
            if (!auth || !auth.id) return false;
            var slot = document.getElementById('rewards-balance-slot');
            var cta = document.getElementById('rewards-cta-row');
            var balEl = document.getElementById('rewards-balance-value');
            var nextEl = document.getElementById('rewards-next-tier');
            if (!slot || !cta) return true;

            slot.classList.remove('hidden');

            var bal = readBalance(auth.id);
            if (balEl) balEl.textContent = bal != null ? bal.toLocaleString() : '\u2014';
            if (nextEl) nextEl.textContent = bal != null ? nextTierHint(bal) : 'Spin the Daily Drop to start climbing.';

            cta.innerHTML =
              '<a href="#redemption" class="inline-flex items-center justify-center rounded-xl bg-primary px-8 h-12 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 transition hover:bg-primary/90">' +
              `Redeem ${loyaltyCurrencyName}` +
              '<svg xmlns="http://www.w3.org/2000/svg" class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>' +
              '</a>' +
              '<a href="#daily-drop" class="inline-flex items-center justify-center rounded-xl border border-border bg-card/50 px-6 h-12 text-base font-medium text-foreground transition hover:bg-muted">' +
              'Spin today' +
              '</a>';
            return true;
          };
          if (!trySwap()) {
            var tries = 0;
            var timer = setInterval(function () {
              if (trySwap() || ++tries > 20) clearInterval(timer);
            }, 200);
          }
        });
      </script>

      <h2 class="text-4xl font-bold tracking-tight mb-3">{tenant.loyaltyProgramName}</h2>
      <p class="text-lg text-muted-foreground mb-10">
        Every purchase earns you {loyaltyCurrencyName}. Redeem them for discounts, free products, and exclusive perks.
      </p>

      <!-- How it works — inline numbered list -->
      <h2 id="how-it-works" class="text-2xl font-bold tracking-tight mb-6">How It Works</h2>
      <ol class="mb-12 space-y-4 text-sm">
        <li class="flex items-start gap-4">
          <span class="flex-shrink-0 flex h-8 w-8 items-center justify-center rounded-full bg-primary text-sm font-bold text-primary-foreground">1</span>
          <div>
            <p class="font-semibold text-foreground">Earn {loyaltyCurrencyName}</p>
            <p class="text-muted-foreground">Get {loyaltyCurrencyName} on every order. Bonus rewards from reviews, referrals, and missions.</p>
          </div>
        </li>
        <li class="flex items-start gap-4">
          <span class="flex-shrink-0 flex h-8 w-8 items-center justify-center rounded-full bg-primary text-sm font-bold text-primary-foreground">2</span>
          <div>
            <p class="font-semibold text-foreground">Redeem Rewards</p>
            <p class="text-muted-foreground">Spend your {loyaltyCurrencyName} on discounts, free products, or limited-edition drops.</p>
          </div>
        </li>
        <li class="flex items-start gap-4">
          <span class="flex-shrink-0 flex h-8 w-8 items-center justify-center rounded-full bg-primary text-sm font-bold text-primary-foreground">3</span>
          <div>
            <p class="font-semibold text-foreground">Level Up</p>
            <p class="text-muted-foreground">The more you earn, the higher your Circle — unlocking better multipliers and perks.</p>
          </div>
        </li>
      </ol>

      <p class="text-sm text-muted-foreground mb-8">
        Create a free account and you're automatically enrolled. {loyaltyCurrencyName} accumulate from your first order — no minimums, no activation required. Earn extra through reviews, daily spins, missions, and referrals. {loyaltyCurrencyName} never expire.
      </p>

      <!-- Earning rates table -->
      <div class="mt-8 overflow-x-auto mb-12">
        <table class="w-full text-sm border border-border rounded-lg overflow-hidden">
          <thead class="bg-muted/30">
            <tr>
              <th class="text-left px-4 py-3 text-foreground font-semibold">Action</th>
              <th class="text-left px-4 py-3 text-foreground font-semibold">{loyaltyCurrencyName} Earned</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <tr class="odd:bg-muted/20"><td class="px-4 py-2.5 text-muted-foreground">Per €1 spent on orders</td><td class="px-4 py-2.5 text-foreground font-medium">{rewards.earnRatePerEur} {loyaltyCurrencyName}</td></tr>
            <tr class="odd:bg-muted/20"><td class="px-4 py-2.5 text-muted-foreground">Write a product review</td><td class="px-4 py-2.5 text-foreground font-medium">{rewards.verifiedReview} {loyaltyCurrencyName}</td></tr>
            <tr class="odd:bg-muted/20"><td class="px-4 py-2.5 text-muted-foreground">Daily Drop spin</td><td class="px-4 py-2.5 text-foreground font-medium">{rewards.dailyDropMin}–{rewards.dailyDropMax} {loyaltyCurrencyName}</td></tr>
            <tr class="odd:bg-muted/20"><td class="px-4 py-2.5 text-muted-foreground">Complete a Mission</td><td class="px-4 py-2.5 text-foreground font-medium">{rewards.missionMin}–{rewards.missionMax} {loyaltyCurrencyName}</td></tr>
            <tr class="odd:bg-muted/20"><td class="px-4 py-2.5 text-muted-foreground">Refer a friend (you receive)</td><td class="px-4 py-2.5 text-foreground font-medium">{rewards.referralSelf} {loyaltyCurrencyName}</td></tr>
            <tr class="odd:bg-muted/20"><td class="px-4 py-2.5 text-muted-foreground">Refer a friend (friend receives)</td><td class="px-4 py-2.5 text-foreground font-medium">{rewards.referralFriend} {loyaltyCurrencyName}</td></tr>
            <tr class="odd:bg-muted/20"><td class="px-4 py-2.5 text-muted-foreground">Welcome bonus (first order)</td><td class="px-4 py-2.5 text-foreground font-medium">{rewards.welcomeBonus} {loyaltyCurrencyName}</td></tr>
          </tbody>
        </table>
        <p class="mt-3 text-sm text-muted-foreground">All earning is automatic — {loyaltyCurrencyName} appear in your Vault within minutes of the qualifying action. There's no need to activate offers or clip coupons.</p>
      </div>

      <!-- Tier cards -->
      <h2 class="text-2xl font-bold tracking-tight mb-6">Tier Overview</h2>
      <div class="grid gap-6 sm:grid-cols-2 mb-12">
        {tiers.map((tier, i) => (
          <div class={`rounded-xl border border-border ${i === tiers.length - 1 ? 'border-l-[4px] sm:col-span-2' : 'border-l-[3px]'} ${tier.border} bg-card/80 overflow-hidden`}>
            <div class={`bg-gradient-to-r ${tier.color} px-6 py-4`}>
              <h3 class="text-lg font-bold text-foreground">{i === tiers.length - 1 ? '🏆 ' : ''}{tier.name}</h3>
              <p class="text-sm text-foreground/80">{tier.points === '0' ? 'Starting tier — everyone begins here' : `${tier.points} ${loyaltyCurrencyName} to unlock`}</p>
            </div>
            <ul class="p-6 space-y-2">
              {tier.perks.map((perk) => (
                <li class="flex items-start gap-2 text-sm text-muted-foreground">
                  <span class="mt-0.5 text-primary">&#10003;</span>
                  <span>{perk}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Tier summary — full details on /membership -->
      <p class="text-sm text-muted-foreground mb-2">
        Tiers are based on lifetime {loyaltyCurrencyName} earned — spending them doesn't lower your tier.
      </p>
      <p class="mb-12">
        <a href="/membership" class="text-sm font-medium text-primary hover:underline">
          See full tier details and perks &rarr;
        </a>
      </p>

      <!-- Daily Drop -->
      <section id="daily-drop" class="mb-12 scroll-mt-24">
        <h2 class="text-2xl font-bold tracking-tight mb-6">Daily Drop</h2>
        <SpinWheelIsland client:visible />
      </section>

      <!-- Redeem Points -->
      <section id="redemption" class="mb-12 scroll-mt-24">
        <h2 class="text-2xl font-bold tracking-tight mb-6">Redeem Your {loyaltyCurrencyName}</h2>
        <PointsRedemptionIsland client:idle />
      </section>

      <!-- FAQ -->
      <section class="mt-12 mb-12">
        <h2 class="text-2xl font-bold text-foreground mb-6">Frequently Asked Questions</h2>
        <div class="space-y-3">
          <details class="group rounded-xl border border-border bg-card/80 overflow-hidden">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 text-foreground font-medium">
              How do I earn {loyaltyCurrencyName}?
              <svg class="h-5 w-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-4 text-sm text-muted-foreground">
              {loyaltyCurrencyName} are earned automatically on every order, by writing product reviews, spinning the Daily Drop wheel daily, completing Missions, and referring friends. No activation required — just shop, review, and engage.
            </div>
          </details>
          <details class="group rounded-xl border border-border bg-card/80 overflow-hidden">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 text-foreground font-medium">
              Do {loyaltyCurrencyName} expire?
              <svg class="h-5 w-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-4 text-sm text-muted-foreground">
              No. Your {loyaltyCurrencyName} never expire as long as your {tenant.name} account remains active. If your account has been inactive for 24 months, we'll send a reminder email before any expiration takes effect.
            </div>
          </details>
          <details class="group rounded-xl border border-border bg-card/80 overflow-hidden">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 text-foreground font-medium">
              What can I redeem {loyaltyCurrencyName} for?
              <svg class="h-5 w-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-4 text-sm text-muted-foreground">
              You can redeem {loyaltyCurrencyName} for store credit (applied at checkout), percentage discounts on individual orders, free shipping upgrades, and curated mystery boxes. Redemption rates and available options are shown in the Vault dashboard.
            </div>
          </details>
          <details class="group rounded-xl border border-border bg-card/80 overflow-hidden">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 text-foreground font-medium">
              How do I check my balance?
              <svg class="h-5 w-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-4 text-sm text-muted-foreground">
              Your {loyaltyCurrencyName} balance is visible at the top of the Vault page when logged in. It's also shown in the header bar next to the cart icon, and in your account dashboard. You'll receive email notifications when {loyaltyCurrencyName} are earned or when you're close to a Circle upgrade.
            </div>
          </details>
          <details class="group rounded-xl border border-border bg-card/80 overflow-hidden">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 text-foreground font-medium">
              Can I earn coins on every order?
              <svg class="h-5 w-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-4 text-sm text-muted-foreground">
              Yes, every order earns {loyaltyCurrencyName} with no minimum purchase. Even a single can order earns coins. Subscribe & Save orders earn coins too — applied automatically to each delivery.
            </div>
          </details>
        </div>
      </section>

      <!-- Terms summary -->
      <div class="mb-12">
        <p class="text-xs text-muted-foreground leading-relaxed">
          {loyaltyCurrencyName} are a non-transferable reward currency issued by {tenant.legalName}. They have no cash value and cannot be exchanged for money. {tenant.name} reserves the right to modify the earning rates, redemption options, and Circle thresholds with 30 days' notice to members. Circle status is determined by lifetime earned {loyaltyCurrencyName} — spending or redeeming coins does not affect your Circle tier. Full terms are available in our <a href="/terms" class="underline hover:text-foreground">Terms of Service</a>.
        </p>
      </div>

      <!-- CTA -->
      <div class="rounded-xl border border-border bg-card/80 p-8 text-center">
        <h2 class="text-xl font-semibold mb-2">Start Earning Today</h2>
        <p class="text-muted-foreground text-sm max-w-md mx-auto mb-6">
          Every purchase earns {loyaltyCurrencyName}. Write reviews, spin the wheel, and complete missions for bonus rewards.
        </p>
        <a
          href="/products"
          class="inline-flex items-center justify-center rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
        >
          Start Shopping
        </a>
      </div>
    </div>
  </section>

  <JsonLd
    items={[
      {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: `${tenant.loyaltyProgramName} — Earn ${loyaltyCurrencyName} & Perks`,
        description: `Earn ${loyaltyCurrencyName} on every purchase and redeem them for discounts, free products, and exclusive perks with ${tenant.name} Rewards.`,
        url: buildAbsoluteUrl('/rewards'),
        mainEntity: {
          '@type': 'Service',
          name: tenant.loyaltyProgramName,
          provider: {
            '@type': 'Organization',
            name: tenant.name,
            url: buildAbsoluteUrl('/'),
          },
          description: `Free loyalty rewards program. Earn ${loyaltyCurrencyName} on purchases, reviews, and community activities. Redeem for discounts and exclusive perks.`,
          offers: tiers.map((t) => ({
            '@type': 'Offer',
            name: `${t.name} Tier`,
