---
export const prerender = true;
import Shop from '@/layouts/Shop.astro';
import Breadcrumb from '@/components/astro/Breadcrumb.astro';
import SpinWheelIsland from '@/components/react/SpinWheelIsland';
import PointsRedemptionIsland from '@/components/react/PointsRedemptionIsland';
import { tenant } from '@/config/tenant';
import { rewards } from '@/config/rewards';

const tierColors = [
  'from-zinc-500/20 to-zinc-600/10',
  'from-blue-500/20 to-blue-600/10',
  'from-emerald-500/20 to-emerald-600/10',
  'from-purple-500/20 to-purple-600/10',
  'from-amber-500/20 to-amber-600/10',
];
const tierPerks: Record<string, string[]> = {
  Explorer: [`${rewards.earnRatePerEur} SnusCoin per EUR spent`, 'Welcome spin bonus', 'Member-only newsletter'],
  Member: ['Community posting', 'Review reactions', 'Birthday bonus'],
  Connoisseur: ['Custom avatar border', 'Early sale access'],
  Specialist: ['Double mission rewards', 'Exclusive polls', 'Priority customer support'],
  Founder: ['Gold badge', 'VIP support', 'Founder-only vouchers'],
};
const tiers = rewards.tiers.map((t, i) => ({
  name: t.name,
  points: t.threshold.toLocaleString(),
  perks: tierPerks[t.name] ?? [],
  color: tierColors[i] ?? tierColors[0],
}));
---

<Shop
  title={`The Vault — Earn SnusCoins & Perks | ${tenant.name}`}
  description={`Earn SnusCoins on every purchase and redeem them for discounts, free products, and exclusive perks. Level up from Explorer to Founder with ${tenant.name} Rewards.`}
>
  <section class="bg-background text-foreground">
    <div class="max-w-4xl mx-auto px-4 py-12">
      <Breadcrumb items={[{ label: 'Rewards' }]} />

      <!-- Logged-out preview hero -->
      <div class="rounded-2xl border border-border bg-gradient-to-br from-primary/5 via-card/60 to-background p-8 sm:p-10 mb-12" id="rewards-preview-hero">
        <div class="text-center mb-8">
          <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4">Every pouch earns you something back.</h1>
          <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
            SnusFriend Rewards turns your orders, reviews, and discoveries into coins you can actually spend. Free products, exclusive discounts, and perks that get better the longer you stay.
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-3 mb-8">
          <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm p-6 text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-amber-500/15 text-2xl">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Earn on Everything</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Every order earns SnusCoins. Write a review, refer a friend, or complete a mission — they all count. Your coins never expire.
            </p>
          </div>

          <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm p-6 text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-emerald-500/15 text-2xl">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Five Circles, Better Perks</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Start as an Explorer, rise to Founder. Each circle unlocks multipliers, early access, and rewards you can't buy. Your taste builds your status.
            </p>
          </div>

          <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm p-6 text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-purple-500/15 text-2xl">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/></svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Daily Drop</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              One free spin every day, whether you buy or not. Bonus coins, surprise discounts, and the occasional free tin. Show up, claim it.
            </p>
          </div>
        </div>

        <div class="text-center">
          <a
            href="/register?redirect=/rewards"
            class="inline-flex items-center justify-center rounded-lg bg-primary px-8 h-12 text-base font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
          >
            Create your free account to start earning
            <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
          <p class="mt-3 text-xs text-muted-foreground">No credit card required. Start earning instantly.</p>
        </div>
      </div>

      <h2 class="text-4xl font-bold tracking-tight mb-3">{tenant.loyaltyProgramName}</h2>
      <p class="text-lg text-muted-foreground mb-10">
        Every purchase earns you SnusCoins. Redeem them for discounts, free products, and exclusive perks.
      </p>

      <!-- How it works -->
      <h2 class="text-2xl font-bold tracking-tight mb-6">How It Works</h2>
      <div class="grid gap-6 sm:grid-cols-3 mb-12">
        {[
          { step: '1', title: 'Earn SnusCoins', desc: 'Get SnusCoins on every order. Bonus coins for reviews, referrals, and missions.' },
          { step: '2', title: 'Redeem Rewards', desc: 'Spend your SnusCoins on discounts, free products, or limited-edition drops.' },
          { step: '3', title: 'Level Up', desc: 'The more you earn, the higher your tier — unlocking better multipliers and perks.' },
        ].map((item) => (
          <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm p-6 text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary text-lg font-bold text-primary-foreground">
              {item.step}
            </div>
            <h3 class="text-lg font-semibold mb-2">{item.title}</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="prose prose-sm max-w-none text-muted-foreground mb-4">
        <p>
          The Vault is your personal rewards dashboard at SnusFriend — where every order, review, and interaction earns you SnusCoins that translate into real discounts, free shipping, and exclusive perks.
        </p>
        <p class="mt-3">
          Getting started takes 30 seconds. Create a free SnusFriend account and you're automatically enrolled. From your very first order, SnusCoins start accumulating in your Vault. There are no minimum purchase thresholds, no complicated tiers to unlock before earning begins — if you buy a single can, you earn coins.
        </p>
        <p class="mt-3">
          Here's how it works in practice: place an order, and you earn SnusCoins for every euro you spend — automatically. Write a review for a product you've tried, and you'll earn bonus coins. Spin the Daily Drop wheel each day for a chance at extra coins. Complete Missions — small challenges like "Try 3 brands this month" or "Rate your last 5 orders" — and earn coins per Mission completed. Refer a friend who places their first order, and you both get rewarded.
        </p>
        <p class="mt-3">
          Once you've accumulated coins, redeem them for store credit, percentage discounts on your next order, free shipping upgrades, or mystery boxes curated by our editorial team. Your coins never expire as long as your account remains active.
        </p>
      </div>

      <!-- Earning rates table -->
      <div class="mt-8 overflow-x-auto mb-12">
        <table class="w-full text-sm border border-border rounded-lg overflow-hidden">
          <thead class="bg-muted/30">
            <tr>
              <th class="text-left px-4 py-3 text-foreground font-semibold">Action</th>
              <th class="text-left px-4 py-3 text-foreground font-semibold">SnusCoins Earned</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <tr><td class="px-4 py-2.5 text-muted-foreground">Per €1 spent on orders</td><td class="px-4 py-2.5 text-foreground font-medium">{rewards.earnRatePerEur} SnusCoin</td></tr>
            <tr><td class="px-4 py-2.5 text-muted-foreground">Write a product review</td><td class="px-4 py-2.5 text-foreground font-medium">{rewards.verifiedReview} SnusCoins</td></tr>
            <tr><td class="px-4 py-2.5 text-muted-foreground">Daily Drop spin</td><td class="px-4 py-2.5 text-foreground font-medium">{rewards.dailyDropMin}–{rewards.dailyDropMax} SnusCoins</td></tr>
            <tr><td class="px-4 py-2.5 text-muted-foreground">Complete a Mission</td><td class="px-4 py-2.5 text-foreground font-medium">{rewards.missionMin}–{rewards.missionMax} SnusCoins</td></tr>
            <tr><td class="px-4 py-2.5 text-muted-foreground">Refer a friend (you receive)</td><td class="px-4 py-2.5 text-foreground font-medium">{rewards.referralSelf} SnusCoins</td></tr>
            <tr><td class="px-4 py-2.5 text-muted-foreground">Refer a friend (friend receives)</td><td class="px-4 py-2.5 text-foreground font-medium">{rewards.referralFriend} SnusCoins</td></tr>
            <tr><td class="px-4 py-2.5 text-muted-foreground">Welcome bonus (first order)</td><td class="px-4 py-2.5 text-foreground font-medium">{rewards.welcomeBonus} SnusCoins</td></tr>
          </tbody>
        </table>
        <p class="mt-3 text-sm text-muted-foreground">All earning is automatic — coins appear in your Vault within minutes of the qualifying action. There's no need to activate offers or clip coupons.</p>
      </div>

      <!-- Tier cards -->
      <h2 class="text-2xl font-bold tracking-tight mb-6">Tier Overview</h2>
      <div class="grid gap-6 sm:grid-cols-2 mb-12">
        {tiers.map((tier) => (
          <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm overflow-hidden">
            <div class={`bg-gradient-to-r ${tier.color} px-6 py-4`}>
              <h3 class="text-lg font-bold text-foreground">{tier.name}</h3>
              <p class="text-sm text-foreground/80">{tier.points} SnusCoins to unlock</p>
            </div>
            <ul class="p-6 space-y-2">
              {tier.perks.map((perk) => (
                <li class="flex items-start gap-2 text-sm text-muted-foreground">
                  <span class="mt-0.5 text-primary">&#10003;</span>
                  <span>{perk}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Tier descriptions -->
      <div class="prose prose-sm max-w-none text-muted-foreground mb-12">
        <p>
          As you earn lifetime SnusCoins, you progress through five membership Circles. Each Circle unlocks increasingly better perks. Your Circle is based on total lifetime coins earned, not your current balance — spending coins doesn't lower your tier.
        </p>

        <h3 class="text-lg font-semibold text-foreground mt-6 mb-2">Explorer ({rewards.tiers[0].threshold} SnusCoins)</h3>
        <p>
          Your starting point. Every new member begins as an Explorer. You get full access to earning on orders, the Daily Drop wheel, and your first welcome bonus. Think of this as your orientation — you're here, you're earning, and the journey has started.
        </p>
        <p class="mt-1"><strong class="text-foreground">Perks:</strong> Welcome bonus, Daily Drop access, member-only newsletter with early access to new product announcements.</p>

        <h3 class="text-lg font-semibold text-foreground mt-6 mb-2">Member ({rewards.tiers[1].threshold} SnusCoins)</h3>
        <p>
          After your first order or two, you'll cross into the Member Circle. This is where community features unlock — you can post in the SnusFriend community, react to other users' reviews, and your reviews carry a "Verified Member" badge.
        </p>
        <p class="mt-1"><strong class="text-foreground">Perks:</strong> Community posting, review reactions, Verified Member badge, birthday bonus.</p>

        <h3 class="text-lg font-semibold text-foreground mt-6 mb-2">Connoisseur ({rewards.tiers[2].threshold} SnusCoins)</h3>
        <p>
          You know what you like, and your purchase history proves it. Connoisseurs get early access to flash sales (typically 24 hours before the general public), a custom avatar border in the community, and access to limited-edition products when they drop.
        </p>
        <p class="mt-1"><strong class="text-foreground">Perks:</strong> Custom avatar border, early sale access, limited-edition product access.</p>

        <h3 class="text-lg font-semibold text-foreground mt-6 mb-2">Specialist ({rewards.tiers[3].threshold.toLocaleString()} SnusCoins)</h3>
        <p>
          Your taste is your credential. Specialists are the serious enthusiasts — they've tried enough brands and flavours to have genuine expertise. Specialist reviews are highlighted in the community, and you earn double coins on all Missions.
        </p>
        <p class="mt-1"><strong class="text-foreground">Perks:</strong> Double Mission rewards, exclusive polls (vote on which products we stock next), priority customer support.</p>

        <h3 class="text-lg font-semibold text-foreground mt-6 mb-2">Founder ({rewards.tiers[4].threshold.toLocaleString()} SnusCoins)</h3>
        <p>
          The inner circle. Founders helped build this community through consistent engagement and purchasing. The Founder badge is gold, your name appears on The Board's hall of fame, and you get access to Founder-only voucher codes that aren't available to any other tier.
        </p>
        <p class="mt-1"><strong class="text-foreground">Perks:</strong> Gold badge, VIP support, Founder-only voucher codes, early access to everything, community recognition on The Board.</p>
      </div>

      <!-- Daily Drop -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold tracking-tight mb-6">Daily Drop</h2>
        <SpinWheelIsland client:visible />
      </section>

      <!-- Redeem Points -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold tracking-tight mb-6">Redeem Your SnusCoins</h2>
        <PointsRedemptionIsland client:idle />
      </section>

      <!-- FAQ -->
      <section class="mt-12 mb-12">
        <h2 class="text-2xl font-bold text-foreground mb-6">Frequently Asked Questions</h2>
        <div class="space-y-3">
          <details class="group rounded-xl border border-border bg-card/60 backdrop-blur-sm overflow-hidden">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 text-foreground font-medium">
              How do I earn SnusCoins?
              <svg class="h-5 w-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-4 text-sm text-muted-foreground">
              SnusCoins are earned automatically on every order, by writing product reviews, spinning the Daily Drop wheel daily, completing Missions, and referring friends. No activation required — just shop, review, and engage.
            </div>
          </details>
          <details class="group rounded-xl border border-border bg-card/60 backdrop-blur-sm overflow-hidden">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 text-foreground font-medium">
              Do SnusCoins expire?
              <svg class="h-5 w-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-4 text-sm text-muted-foreground">
              No. Your SnusCoins never expire as long as your SnusFriend account remains active. If your account has been inactive for 24 months, we'll send a reminder email before any expiration takes effect.
            </div>
          </details>
          <details class="group rounded-xl border border-border bg-card/60 backdrop-blur-sm overflow-hidden">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 text-foreground font-medium">
              What can I redeem SnusCoins for?
              <svg class="h-5 w-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-4 text-sm text-muted-foreground">
              You can redeem SnusCoins for store credit (applied at checkout), percentage discounts on individual orders, free shipping upgrades, and curated mystery boxes. Redemption rates and available options are shown in the Vault dashboard.
            </div>
          </details>
          <details class="group rounded-xl border border-border bg-card/60 backdrop-blur-sm overflow-hidden">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 text-foreground font-medium">
              How do I check my balance?
              <svg class="h-5 w-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-4 text-sm text-muted-foreground">
              Your SnusCoin balance is visible at the top of the Vault page when logged in. It's also shown in the header bar next to the cart icon, and in your account dashboard. You'll receive email notifications when coins are earned or when you're close to a Circle upgrade.
            </div>
          </details>
          <details class="group rounded-xl border border-border bg-card/60 backdrop-blur-sm overflow-hidden">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 text-foreground font-medium">
              Can I earn coins on every order?
              <svg class="h-5 w-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-4 text-sm text-muted-foreground">
              Yes, every order earns SnusCoins with no minimum purchase. Even a single can order earns coins. Subscribe & Save orders earn coins too — applied automatically to each delivery.
            </div>
          </details>
        </div>
      </section>

      <!-- Terms summary -->
      <div class="mb-12">
        <p class="text-xs text-muted-foreground leading-relaxed">
          SnusCoins are a non-transferable reward currency issued by SnusFriend (Nordic Express AB). They have no cash value and cannot be exchanged for money. SnusFriend reserves the right to modify the earning rates, redemption options, and Circle thresholds with 30 days' notice to members. Circle status is determined by lifetime earned SnusCoins — spending or redeeming coins does not affect your Circle tier. Full terms are available in our <a href="/terms" class="underline hover:text-foreground">Terms of Service</a>.
        </p>
      </div>

      <!-- CTA -->
      <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm p-8 text-center">
        <h2 class="text-xl font-semibold mb-2">Start Earning Today</h2>
        <p class="text-muted-foreground text-sm max-w-md mx-auto mb-6">
          Every purchase earns SnusCoins. Write reviews, spin the wheel, and complete missions for bonus rewards.
        </p>
        <a
          href="/products"
          class="inline-flex items-center justify-center rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
        >
          Start Shopping
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `${tenant.loyaltyProgramName} — Earn SnusCoins & Perks`,
    description: `Earn SnusCoins on every purchase and redeem them for discounts, free products, and exclusive perks with ${tenant.name} Rewards.`,
    url: 'https://snusfriends.com/rewards',
    mainEntity: {
      '@type': 'Service',
      name: tenant.loyaltyProgramName,
      provider: {
        '@type': 'Organization',
        name: tenant.name,
        url: 'https://snusfriends.com',
      },
      description: 'Free loyalty rewards program. Earn SnusCoins on purchases, reviews, and community activities. Redeem for discounts and exclusive perks.',
      offers: tiers.map((t) => ({
        '@type': 'Offer',
        name: `${t.name} Tier`,
        description: t.perks.join(', '),
      })),
    },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://snusfriends.com' },
        { '@type': 'ListItem', position: 2, name: 'Rewards', item: 'https://snusfriends.com/rewards' },
      ],
    },
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How do I earn SnusCoins?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'SnusCoins are earned automatically on every order, by writing product reviews, spinning the Daily Drop wheel daily, completing Missions, and referring friends. No activation required — just shop, review, and engage.',
        },
      },
      {
        '@type': 'Question',
        name: 'Do SnusCoins expire?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. Your SnusCoins never expire as long as your SnusFriend account remains active. If your account has been inactive for 24 months, we\'ll send a reminder email before any expiration takes effect.',
        },
      },
      {
        '@type': 'Question',
        name: 'What can I redeem SnusCoins for?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'You can redeem SnusCoins for store credit (applied at checkout), percentage discounts on individual orders, free shipping upgrades, and curated mystery boxes. Redemption rates and available options are shown in the Vault dashboard.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do I check my balance?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Your SnusCoin balance is visible at the top of the Vault page when logged in. It\'s also shown in the header bar next to the cart icon, and in your account dashboard. You\'ll receive email notifications when coins are earned or when you\'re close to a Circle upgrade.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I earn coins on every order?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes, every order earns SnusCoins with no minimum purchase. Even a single can order earns coins. Subscribe & Save orders earn coins too — applied automatically to each delivery.',
        },
      },
    ],
  })} />
</Shop>
