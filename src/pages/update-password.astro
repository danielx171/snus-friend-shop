---
export const prerender = false;

import Shop from '@/layouts/Shop.astro';
import { actions } from 'astro:actions';
import { tenant } from '@/config/tenant';

const result = Astro.getActionResult(actions.auth.updatePassword);

const errorMessage = result?.error?.message;
const success = result?.data?.success;
---

<Shop
  title={`Update Password | ${tenant.name}`}
  description="Set a new password for your account."
  noindex={true}
>
  <section class="min-h-[80vh] flex items-center bg-background text-foreground">
    <div class="w-full max-w-md mx-auto px-4 py-12">

      <!-- Brand mark -->
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2 text-primary font-black text-xl tracking-tight">
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-primary text-primary-foreground text-base font-black">S</span>
          {tenant.name}
        </a>
        <h1 class="mt-5 text-2xl font-bold tracking-tight text-foreground">Set a new password</h1>
        <p class="mt-1 text-sm text-muted-foreground">Choose something strong — at least 8 characters</p>
      </div>

      <div class="rounded-2xl border border-border bg-card/80 p-7 shadow-sm">

        {errorMessage && (
          <div role="alert" aria-live="assertive" class="mb-5 rounded-lg border border-destructive/30 bg-destructive/5 p-3.5 text-center">
            <p class="text-sm text-destructive font-medium">{errorMessage}</p>
          </div>
        )}

        {success ? (
          <div class="py-4 text-center">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary/10">
              <svg class="h-7 w-7 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
            </div>
            <h2 class="text-lg font-semibold text-foreground mb-1">Password updated!</h2>
            <p class="text-sm text-muted-foreground">Redirecting you to your account&hellip;</p>
          </div>
        ) : (
          <form method="POST" action={actions.auth.updatePassword} class="space-y-4" id="update-pw-form">

            <div>
              <label for="password" class="block text-sm font-medium text-foreground mb-1.5">New password</label>
              <div class="relative">
                <input
                  type="password"
                  id="password"
                  name="password"
                  required
                  autofocus
                  autocomplete="new-password"
                  minlength="8"
                  placeholder="At least 8 characters"
                  class="w-full rounded-lg border border-border bg-background px-4 py-2.5 pr-11 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
                />
                <button type="button" id="toggle-pw1" aria-label="Toggle password visibility"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition p-0.5">
                  <svg id="eye1-open" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  <svg id="eye1-closed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
                </button>
              </div>
            </div>

            <div>
              <label for="confirmPassword" class="block text-sm font-medium text-foreground mb-1.5">Confirm new password</label>
              <div class="relative">
                <input
                  type="password"
                  id="confirmPassword"
                  name="confirmPassword"
                  required
                  autocomplete="new-password"
                  minlength="8"
                  placeholder="Repeat your new password"
                  class="w-full rounded-lg border border-border bg-background px-4 py-2.5 pr-11 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
                />
                <button type="button" id="toggle-pw2" aria-label="Toggle confirm password visibility"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition p-0.5">
                  <svg id="eye2-open" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  <svg id="eye2-closed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
                </button>
              </div>
              <p id="pw-mismatch" class="mt-1.5 text-xs text-destructive hidden">Passwords do not match</p>
            </div>

            <button
              type="submit"
              id="update-btn"
              class="w-full flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition focus:outline-none focus:ring-2 focus:ring-primary/50 disabled:opacity-60 disabled:cursor-not-allowed mt-2"
            >
              <svg id="update-spinner" class="hidden animate-spin" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4l3-3-3-3v4a8 8 0 00-8 8h4z"/>
              </svg>
              <span id="update-btn-text">Update Password</span>
            </button>
          </form>
        )}
      </div>

      <p class="mt-5 text-center text-sm text-muted-foreground">
        <a href="/login" class="text-primary font-medium hover:underline">Back to sign in</a>
      </p>
    </div>
  </section>

  {success && (
    <script is:inline>
      setTimeout(function() { window.location.href = '/account'; }, 2000);
    </script>
  )}

  <script>
    // Password visibility toggles
    function makeToggle(btnId: string, inputId: string, openId: string, closedId: string) {
      const btn = document.getElementById(btnId);
      const input = document.getElementById(inputId) as HTMLInputElement | null;
      const open = document.getElementById(openId);
      const closed = document.getElementById(closedId);
      if (!btn || !input || !open || !closed) return;
      btn.addEventListener('click', () => {
        const isText = input.type === 'text';
        input.type = isText ? 'password' : 'text';
        open.classList.toggle('hidden', !isText);
        closed.classList.toggle('hidden', isText);
      });
    }
    makeToggle('toggle-pw1', 'password', 'eye1-open', 'eye1-closed');
    makeToggle('toggle-pw2', 'confirmPassword', 'eye2-open', 'eye2-closed');

    // Match indicator + submit guard
    const pw = document.getElementById('password') as HTMLInputElement | null;
    const confirm = document.getElementById('confirmPassword') as HTMLInputElement | null;
    const mismatch = document.getElementById('pw-mismatch');
    const form = document.getElementById('update-pw-form') as HTMLFormElement | null;
    const btn = document.getElementById('update-btn') as HTMLButtonElement | null;
    const spinner = document.getElementById('update-spinner');
    const btnText = document.getElementById('update-btn-text');

    if (confirm && pw && mismatch) {
      confirm.addEventListener('input', () => {
        mismatch.classList.toggle('hidden', confirm.value === '' || confirm.value === pw.value);
      });
    }

    if (form && btn && spinner && btnText) {
      form.addEventListener('submit', (e) => {
        if (pw && confirm && pw.value !== confirm.value) {
          e.preventDefault();
          mismatch?.classList.remove('hidden');
          confirm.focus();
          return;
        }
        btn.disabled = true;
        spinner.classList.remove('hidden');
        btnText.textContent = 'Updating\u2026';
      });
    }
  </script>
</Shop>
