---
export const prerender = false;

import Shop from '@/layouts/Shop.astro';
import Breadcrumb from '@/components/astro/Breadcrumb.astro';
import CheckoutFormIsland from '@/components/react/CheckoutFormIsland';
import { tenant } from '@/config/tenant';

const user = Astro.locals.user;
const isGuest = !user;
const lastAddress = user?.user_metadata?.last_address ?? null;
---

<Shop title={`Checkout | ${tenant.name}`} description="Complete your purchase securely." noindex={true}>
  <section class="bg-background text-foreground">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <Breadcrumb items={[{ label: 'Cart', href: '/cart' }, { label: 'Checkout' }]} />
      <CheckoutFormIsland client:load userEmail={user?.email ?? ''} userId={user?.id ?? null} isGuest={isGuest} lastAddress={lastAddress} />
    </div>
  </section>
</Shop>
