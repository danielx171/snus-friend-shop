---
export const prerender = true;
import Shop from '@/layouts/Shop.astro';
import Breadcrumb from '@/components/astro/Breadcrumb.astro';
import { countries } from '@/data/countries';
import { getCollection } from 'astro:content';
import { getEditorialFacts } from '@/data/editorial-facts';

export async function getStaticPaths() {
  return countries.map((c) => ({ params: { slug: c.slug }, props: { country: c } }));
}

const { country } = Astro.props;
const allBrands = await getCollection('brands');
const popularBrands = country.popularBrands
  .map((slug) => allBrands.find((b) => b.id === slug))
  .filter(Boolean);

// Replace editorial-fact tokens ({{productCount}}, {{productCountLabel}},
// {{brandCount}}, {{brandCountLabel}}) in country prose with live values
// so catalog growth does not drift against blog/country copy.
const facts = await getEditorialFacts();
const tokenMap: Record<string, string> = {
  productCount: String(facts.productCount),
  productCountLabel: facts.productCountLabel,
  brandCount: String(facts.brandCount),
  brandCountLabel: facts.brandCountLabel,
};
const withFacts = (s: string | undefined): string | undefined =>
  s?.replace(/\{\{(productCount|productCountLabel|brandCount|brandCountLabel)\}\}/g, (_, k) => tokenMap[k]);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: country.h1,
  description: country.metaDescription,
  url: `https://snusfriends.com/countries/${country.slug}`,
  ...(country.faq ? {
    mainEntity: {
      '@type': 'FAQPage',
      mainEntity: country.faq.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  } : {}),
};
---

<Shop title={`${country.h1} | SnusFriend`} description={country.metaDescription} canonical={`/countries/${country.slug}`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumb items={[
      { label: 'Nicotine Pouches', href: '/nicotine-pouches' },
      { label: country.name },
    ]} />

    <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-6">
      {country.h1}
    </h1>

    <div class="space-y-8 text-base leading-relaxed text-muted-foreground max-w-3xl">

      <!-- Intro paragraph (enriched if available) -->
      <p class="text-lg">{withFacts(country.enrichedIntro ?? country.intro)}</p>

      <!-- Legal Status -->
      <div>
        <h2 class="text-xl font-semibold text-foreground mb-3">Legal Status</h2>
        <div class="rounded-xl border border-border bg-card/60 p-6">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">{country.flag}</span>
            <span class={`inline-flex rounded-full px-3 py-1 text-xs font-semibold ${
              country.legalStatus === 'legal' ? 'bg-emerald-500/10 text-emerald-600' :
              country.legalStatus === 'restricted' ? 'bg-amber-500/10 text-amber-600' :
              'bg-red-500/10 text-red-600'
            }`}>
              {country.legalStatus === 'legal' ? 'Legal' : country.legalStatus === 'restricted' ? 'Restricted' : 'Banned'}
            </span>
            <span class="text-sm text-muted-foreground">Age limit: {country.ageLimit}+</span>
          </div>
          <p class="text-sm text-muted-foreground">{country.legalNote}</p>
        </div>
      </div>

      <!-- Market Context (enriched only) -->
      {country.marketContext && (
        <div>
          <h2 class="text-xl font-semibold text-foreground mb-3">{country.marketContextHeading ?? `The ${country.name} Market`}</h2>
          <p>{withFacts(country.marketContext)}</p>
        </div>
      )}

      <!-- Popular Brands -->
      <div>
        <h2 class="text-xl font-semibold text-foreground mb-3">Popular Brands in {country.name}</h2>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {popularBrands.map((brand) => brand && (
            <a href={`/brands/${brand.id}`} class="flex items-center gap-3 rounded-xl border border-border bg-card/60 p-4 transition hover:border-primary/30">
              <span class="font-medium text-foreground">{brand.data.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Why SnusFriend (enriched only) -->
      {country.whySnusFriend && (
        <div class="rounded-xl border border-primary/20 bg-primary/5 p-6">
          <h2 class="text-xl font-semibold text-foreground mb-3">Why Order from SnusFriend?</h2>
          <p>{withFacts(country.whySnusFriend)}</p>
        </div>
      )}

      <!-- Shipping -->
      <div>
        <h2 class="text-xl font-semibold text-foreground mb-3">Shipping to {country.name}</h2>
        <p>{country.shippingNote}</p>
      </div>

      <!-- Buying Tips (enriched only) -->
      {country.buyingTips && (
        <div>
          <h2 class="text-xl font-semibold text-foreground mb-3">Buying Tips for {country.name}</h2>
          <p>{withFacts(country.buyingTips)}</p>
        </div>
      )}

      <!-- FAQ (enriched only) -->
      {country.faq && country.faq.length > 0 && (
        <div>
          <h2 class="text-xl font-semibold text-foreground mb-4">Frequently Asked Questions</h2>
          <div class="space-y-3">
            {country.faq.map(({ q, a }) => (
              <details class="group rounded-xl border border-border bg-card/60">
                <summary class="flex cursor-pointer items-center justify-between px-5 py-4 text-sm font-medium text-foreground">
                  {q}
                  <svg class="h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </summary>
                <div class="px-5 pb-4 text-sm text-muted-foreground">{a}</div>
              </details>
            ))}
          </div>
        </div>
      )}

      <!-- Buying Guide Link -->
      {['austria', 'denmark', 'norway', 'finland', 'poland'].includes(country.slug) && (
        <div class="mt-8 p-6 rounded-xl border border-border bg-card/60">
          <h3 class="text-lg font-semibold mb-2">Read the Full Buying Guide</h3>
          <p class="text-sm text-muted-foreground mb-4">
            Get detailed advice on regulations, pricing, popular brands, and how to order to {country.name}.
          </p>
          <a href={`/blog/buying-nicotine-pouches-${country.slug}-2026`} class="text-sm font-medium text-primary hover:underline">
            Read: Buying Nicotine Pouches in {country.name} →
          </a>
        </div>
      )}

      <!-- CTA -->
      <div>
        <h2 class="text-xl font-semibold text-foreground mb-4">Start Shopping</h2>
        <div class="flex flex-wrap gap-3">
          <a href="/nicotine-pouches" class="rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition hover:bg-primary/90">Browse All Pouches</a>
          <a href="/brands" class="rounded-lg border border-border px-6 py-3 text-sm font-medium text-foreground transition hover:border-primary/30">View All Brands</a>
          <a href="/blog/best-nicotine-pouches-for-beginners-2026" class="rounded-lg border border-border px-6 py-3 text-sm font-medium text-foreground transition hover:border-primary/30">Beginner's Guide</a>
        </div>
      </div>

    </div>
  </div>
</Shop>
