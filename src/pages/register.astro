---
export const prerender = false;

import Shop from '@/layouts/Shop.astro';
import { actions } from 'astro:actions';
import { tenant } from '@/config/tenant';
import { rewards } from '@/config/rewards';

const result = Astro.getActionResult(actions.auth.register);

const errorMessage = result?.error?.message;
const successMessage = result?.data?.message;
const refCode = Astro.url.searchParams.get('ref') ?? '';
---

<Shop
  title={`Create Account | ${tenant.name}`}
  description={`Join ${tenant.name} to earn rewards, track orders, and get exclusive offers on nicotine pouches.`}
  noindex={true}
>
  <section class="min-h-[80vh] flex items-center bg-background text-foreground">
    <div class="w-full max-w-md mx-auto px-4 py-12">

      <!-- Brand mark -->
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2 text-primary font-black text-xl tracking-tight">
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-primary text-primary-foreground text-base font-black">S</span>
          {tenant.name}
        </a>
        <h1 class="mt-5 text-2xl font-bold tracking-tight text-foreground">Create your account</h1>
        <p class="mt-1 text-sm text-muted-foreground">Join and start earning SnusCoins on every order</p>
      </div>

      <div class="rounded-2xl border border-border bg-card/80 p-7 shadow-sm">

        {errorMessage && (
          <div role="alert" aria-live="assertive" class="mb-5 rounded-lg border border-destructive/30 bg-destructive/5 p-3.5 text-center">
            <p class="text-sm text-destructive font-medium">{errorMessage}</p>
          </div>
        )}

        {successMessage ? (
          <!-- Success state -->
          <div class="py-6 text-center">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary/10">
              <svg class="h-7 w-7 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
            </div>
            <h2 class="text-lg font-semibold text-foreground mb-1">Check your inbox</h2>
            <p class="text-sm text-muted-foreground">{successMessage}</p>
            <a href="/login" class="mt-5 inline-flex items-center text-sm text-primary hover:underline font-medium">
              Back to sign in
            </a>
          </div>
        ) : (
          <form method="POST" action={actions.auth.register} class="space-y-4" id="register-form">

            <div>
              <label for="fullName" class="block text-sm font-medium text-foreground mb-1.5">Full name</label>
              <input
                type="text"
                id="fullName"
                name="fullName"
                required
                autofocus
                autocomplete="name"
                placeholder="Your full name"
                class="w-full rounded-lg border border-border bg-background px-4 py-2.5 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-foreground mb-1.5">Email address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
                class="w-full rounded-lg border border-border bg-background px-4 py-2.5 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
              />
            </div>

            <div>
              <label for="password" class="block text-sm font-medium text-foreground mb-1.5">Password</label>
              <div class="relative">
                <input
                  type="password"
                  id="password"
                  name="password"
                  required
                  autocomplete="new-password"
                  minlength="8"
                  placeholder="At least 8 characters"
                  class="w-full rounded-lg border border-border bg-background px-4 py-2.5 pr-11 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
                />
                <button type="button" id="toggle-pw1" aria-label="Toggle password visibility"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition p-0.5">
                  <svg id="eye1-open" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  <svg id="eye1-closed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
                </button>
              </div>
              <div id="password-strength" class="mt-2 space-y-1" aria-live="polite" style="display:none">
                <div class="flex gap-1">
                  <div class="h-1 flex-1 rounded-full bg-muted transition-colors" data-segment="1"></div>
                  <div class="h-1 flex-1 rounded-full bg-muted transition-colors" data-segment="2"></div>
                  <div class="h-1 flex-1 rounded-full bg-muted transition-colors" data-segment="3"></div>
                  <div class="h-1 flex-1 rounded-full bg-muted transition-colors" data-segment="4"></div>
                </div>
                <p id="strength-label" class="text-xs text-muted-foreground"></p>
              </div>
            </div>

            <div>
              <label for="confirm-password" class="block text-sm font-medium text-foreground mb-1.5">Confirm password</label>
              <div class="relative">
                <input
                  type="password"
                  id="confirm-password"
                  name="confirm-password"
                  required
                  autocomplete="new-password"
                  minlength="8"
                  placeholder="Repeat your password"
                  class="w-full rounded-lg border border-border bg-background px-4 py-2.5 pr-11 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
                />
                <button type="button" id="toggle-pw2" aria-label="Toggle confirm password visibility"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition p-0.5">
                  <svg id="eye2-open" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  <svg id="eye2-closed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
                </button>
              </div>
              <p id="pw-mismatch" class="mt-1.5 text-xs text-destructive hidden">Passwords do not match</p>
            </div>

            {refCode && (
              <input type="hidden" name="referralCode" value={refCode} />
            )}

            {!refCode && (
              <div>
                <label for="referralCode" class="block text-sm font-medium text-foreground mb-1.5">
                  Referral code <span class="text-muted-foreground font-normal">(optional)</span>
                </label>
                <input
                  type="text"
                  id="referralCode"
                  name="referralCode"
                  placeholder="e.g. SF-A1B2C3D4"
                  class="w-full rounded-lg border border-border bg-background px-4 py-2.5 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
                />
                <p class="text-xs text-muted-foreground mt-1">Have a friend's code? Enter it for {rewards.referralFriend} bonus SnusCoins.</p>
              </div>
            )}

            <div class="space-y-3 pt-1">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="ageVerified" required
                  class="mt-0.5 h-4 w-4 rounded border-border text-primary focus:ring-primary/50" />
                <span class="text-sm text-muted-foreground">
                  I confirm I am <strong class="text-foreground">18 years or older</strong>
                </span>
              </label>

              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="termsAccepted" required
                  class="mt-0.5 h-4 w-4 rounded border-border text-primary focus:ring-primary/50" />
                <span class="text-sm text-muted-foreground">
                  I agree to the
                  <a href="/terms" class="text-primary hover:underline">Terms of Service</a>
                  and
                  <a href="/privacy" class="text-primary hover:underline">Privacy Policy</a>
                </span>
              </label>
            </div>

            <button
              type="submit"
              id="register-btn"
              class="w-full flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition focus:outline-none focus:ring-2 focus:ring-primary/50 disabled:opacity-60 disabled:cursor-not-allowed mt-2"
            >
              <svg id="register-spinner" class="hidden animate-spin" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4l3-3-3-3v4a8 8 0 00-8 8h4z"/>
              </svg>
              <span id="register-btn-text">Create Account</span>
            </button>
          </form>
        )}
      </div>

      <p class="mt-5 text-center text-sm text-muted-foreground">
        Already have an account?
        <a href="/login" class="text-primary font-medium hover:underline">Sign in</a>
      </p>
    </div>
  </section>

  <script>
    // Password strength meter
    const pw = document.getElementById('password') as HTMLInputElement | null;
    const meter = document.getElementById('password-strength');
    const label = document.getElementById('strength-label');
    const segments = meter?.querySelectorAll('[data-segment]') as NodeListOf<HTMLElement> | undefined;

    if (pw && meter && label && segments) {
      pw.addEventListener('input', () => {
        const v = pw.value;
        if (!v) { meter.style.display = 'none'; return; }
        meter.style.display = '';
        let score = 0;
        if (v.length >= 8) score++;
        if (/[A-Z]/.test(v)) score++;
        if (/[0-9]/.test(v)) score++;
        if (/[^A-Za-z0-9]/.test(v)) score++;
        if (v.length >= 12) score++;
        const levels = [
          { fill: 1, color: 'hsl(var(--color-error))',   text: 'Weak' },
          { fill: 2, color: 'hsl(var(--color-warning))', text: 'Fair' },
          { fill: 3, color: 'hsl(var(--color-success))', text: 'Good' },
          { fill: 4, color: 'hsl(var(--color-success))', text: 'Strong' },
        ];
        const level = levels[Math.min(score <= 1 ? 0 : score === 2 ? 1 : score === 3 ? 2 : 3, 3)];
        segments.forEach((seg, i) => {
          seg.style.backgroundColor = i < level.fill ? level.color : '';
        });
        label.textContent = level.text;
        label.style.color = level.color;
      });
    }

    // Password match indicator
    const confirm = document.getElementById('confirm-password') as HTMLInputElement | null;
    const mismatch = document.getElementById('pw-mismatch');
    if (confirm && pw && mismatch) {
      confirm.addEventListener('input', () => {
        mismatch.classList.toggle('hidden', confirm.value === '' || confirm.value === pw.value);
      });
    }

    // Password visibility toggles
    function makeToggle(btnId: string, inputId: string, openId: string, closedId: string) {
      const btn = document.getElementById(btnId);
      const input = document.getElementById(inputId) as HTMLInputElement | null;
      const open = document.getElementById(openId);
      const closed = document.getElementById(closedId);
      if (!btn || !input || !open || !closed) return;
      btn.addEventListener('click', () => {
        const isText = input.type === 'text';
        input.type = isText ? 'password' : 'text';
        open.classList.toggle('hidden', !isText);
        closed.classList.toggle('hidden', isText);
      });
    }
    makeToggle('toggle-pw1', 'password', 'eye1-open', 'eye1-closed');
    makeToggle('toggle-pw2', 'confirm-password', 'eye2-open', 'eye2-closed');

    // Loading state on submit
    const form = document.getElementById('register-form') as HTMLFormElement | null;
    const btn = document.getElementById('register-btn') as HTMLButtonElement | null;
    const spinner = document.getElementById('register-spinner');
    const btnText = document.getElementById('register-btn-text');
    if (form && btn && spinner && btnText) {
      form.addEventListener('submit', (e) => {
        // Client-side password match check before submitting
        if (pw && confirm && pw.value !== confirm.value) {
          e.preventDefault();
          mismatch?.classList.remove('hidden');
          confirm.focus();
          return;
        }
        btn.disabled = true;
        spinner.classList.remove('hidden');
        btnText.textContent = 'Creating account\u2026';
      });
    }
  </script>
</Shop>
