---
export const prerender = false;

import Shop from '@/layouts/Shop.astro';
import { actions } from 'astro:actions';
import { tenant } from '@/config/tenant';

const result = Astro.getActionResult(actions.auth.forgotPassword);

const errorMessage = result?.error?.message;
const submitted = result?.data?.success;
---

<Shop
  title={`Forgot Password | ${tenant.name}`}
  description="Reset your password to regain access to your account."
  noindex={true}
>
  <section class="min-h-[80vh] flex items-center bg-background text-foreground">
    <div class="w-full max-w-md mx-auto px-4 py-12">

      <!-- Brand mark -->
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2 text-primary font-black text-xl tracking-tight">
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-primary text-primary-foreground text-base font-black">S</span>
          {tenant.name}
        </a>
        <h1 class="mt-5 text-2xl font-bold tracking-tight text-foreground">Reset your password</h1>
        <p class="mt-1 text-sm text-muted-foreground">We'll send a reset link to your inbox</p>
      </div>

      <div class="rounded-2xl border border-border bg-card/60 backdrop-blur-sm p-7 shadow-sm">

        {errorMessage && (
          <div role="alert" aria-live="assertive" class="mb-5 rounded-lg border border-destructive/30 bg-destructive/5 p-3.5 text-center">
            <p class="text-sm text-destructive font-medium">{errorMessage}</p>
          </div>
        )}

        {submitted ? (
          <div class="py-4 text-center">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary/10">
              <svg class="h-7 w-7 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            </div>
            <h2 class="text-lg font-semibold text-foreground mb-1">Check your inbox</h2>
            <p class="text-sm text-muted-foreground">If an account exists with that email, we've sent a password reset link.</p>
            <a href="/login" class="mt-5 inline-flex items-center text-sm text-primary hover:underline font-medium">
              Back to sign in
            </a>
          </div>
        ) : (
          <form method="POST" action={actions.auth.forgotPassword} class="space-y-4" id="forgot-form">
            <div>
              <label for="email" class="block text-sm font-medium text-foreground mb-1.5">Email address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autofocus
                autocomplete="email"
                placeholder="you@example.com"
                class="w-full rounded-lg border border-border bg-background px-4 py-2.5 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
              />
            </div>

            <button
              type="submit"
              id="forgot-btn"
              class="w-full flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition focus:outline-none focus:ring-2 focus:ring-primary/50 disabled:opacity-60 disabled:cursor-not-allowed mt-2"
            >
              <svg id="forgot-spinner" class="hidden animate-spin" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4l3-3-3-3v4a8 8 0 00-8 8h4z"/>
              </svg>
              <span id="forgot-btn-text">Send Reset Link</span>
            </button>
          </form>
        )}
      </div>

      <p class="mt-5 text-center text-sm text-muted-foreground">
        Remember your password?
        <a href="/login" class="text-primary font-medium hover:underline">Sign in</a>
      </p>
    </div>
  </section>

  <script>
    const form = document.getElementById('forgot-form') as HTMLFormElement | null;
    const btn = document.getElementById('forgot-btn') as HTMLButtonElement | null;
    const spinner = document.getElementById('forgot-spinner');
    const btnText = document.getElementById('forgot-btn-text');
    if (form && btn && spinner && btnText) {
      form.addEventListener('submit', () => {
        btn.disabled = true;
        spinner.classList.remove('hidden');
        btnText.textContent = 'Sending\u2026';
      });
    }
  </script>
</Shop>
