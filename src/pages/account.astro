---
export const prerender = false;

import Shop from '@/layouts/Shop.astro';
import Breadcrumb from '@/components/astro/Breadcrumb.astro';
import ProfileCardIsland from '@/components/react/ProfileCardIsland';
import AvatarSelectorIsland from '@/components/react/AvatarSelectorIsland';
import AchievementGridIsland from '@/components/react/AchievementGridIsland';
import { actions } from 'astro:actions';
import { tenant } from '@/config/tenant';

// Auth check
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login?redirect=/account');
}

const supabase = Astro.locals.supabase;

// Tab selection via query param (default: orders)
const tab = Astro.url.searchParams.get('tab') || 'orders';

// Fetch all independent queries in parallel (referral_codes moved here to unblock the waterfall)
const [
  { data: orders },
  { data: pointsBalance },
  { count: reviewsCount },
  { data: subscriptions },
  { data: referralCode },
  { data: referralCodeRow },
] = await Promise.all([
  supabase.from('orders').select('*').eq('user_id', user.id).order('created_at', { ascending: false }).limit(20),
  supabase.from('points_balances').select('*').eq('user_id', user.id).single(),
  supabase.from('product_reviews').select('id', { count: 'exact', head: true }).eq('user_id', user.id),
  supabase.from('subscriptions').select('*').eq('user_id', user.id).order('created_at', { ascending: false }),
  supabase.rpc('get_or_create_referral_code', { p_user_id: user.id }),
  supabase.from('referral_codes').select('id').eq('user_id', user.id).single(),
]);

// Fast follow-up: referral redemption count (single indexed WHERE, ~50ms)
const { count: referralCount } = await supabase
  .from('referral_redemptions')
  .select('id', { count: 'exact', head: true })
  .eq('referral_code_id', referralCodeRow?.id ?? '00000000-0000-0000-0000-000000000000');

// User metadata + nickname
import { generateNickname } from '@/lib/nickname';
const fullName = user.user_metadata?.full_name || '';
const phone = user.user_metadata?.phone || '';
const nickname = user.user_metadata?.nickname || generateNickname(user.id);

// Check action results
const profileResult = Astro.getActionResult(actions.account.updateProfile);
const passwordResult = Astro.getActionResult(actions.account.changePassword);
const logoutResult = Astro.getActionResult(actions.auth.logout);

if (logoutResult && !logoutResult.error) {
  return Astro.redirect('/');
}

// Status badge color helper
function statusColor(status: string): string {
  switch (status) {
    case 'paid': case 'completed': return 'bg-primary/20 text-primary';
    case 'shipped': return 'bg-accent/20 text-accent-foreground';
    case 'pending': return 'bg-muted text-muted-foreground';
    case 'cancelled': case 'refunded': return 'bg-destructive/20 text-destructive';
    default: return 'bg-muted text-muted-foreground';
  }
}

// Tier calculation
const balance = pointsBalance?.balance ?? 0;
const lifetime = pointsBalance?.lifetime_earned ?? 0;
function getTier(pts: number) {
  if (pts >= 5000) return { name: 'Legend', next: null, threshold: 5000 };
  if (pts >= 2000) return { name: 'Expert', next: 'Legend', threshold: 5000 };
  if (pts >= 500) return { name: 'Enthusiast', next: 'Expert', threshold: 2000 };
  if (pts >= 100) return { name: 'Regular', next: 'Enthusiast', threshold: 500 };
  return { name: 'Newcomer', next: 'Regular', threshold: 100 };
}
const tier = getTier(lifetime);
const progress = tier.next ? Math.min(100, Math.round((lifetime / tier.threshold) * 100)) : 100;
---

<Shop
  title={`Account | ${tenant.name}`}
  description="Manage your account, orders, and membership."
  noindex={true}
>
  <section class="bg-background text-foreground">
    <div class="max-w-4xl mx-auto px-4 py-12">
      <Breadcrumb items={[{ label: 'Account' }]} />

      <h1 class="text-3xl font-bold tracking-tight mb-2">My Account</h1>
      <p class="text-muted-foreground mb-6">Welcome back, <span class="font-semibold text-foreground">{nickname}</span></p>

      <!-- Gamification Profile Card -->
      <div class="mb-8">
        <ProfileCardIsland
          client:visible
          ordersCount={orders?.length ?? 0}
          reviewsCount={reviewsCount ?? 0}
          snusPoints={balance}
        />
      </div>

      <!-- Avatar Selector -->
      <div class="mb-8 rounded-xl border border-border bg-card/60 backdrop-blur-sm p-6">
        <AvatarSelectorIsland client:visible />
      </div>

      <!-- Tab Navigation -->
      <div class="flex gap-1 border-b border-border mb-8">
        <a
          href="/account?tab=orders"
          class:list={[
            'px-4 py-2.5 text-sm font-medium rounded-t-lg transition',
            tab === 'orders'
              ? 'bg-card/60 text-foreground border border-border border-b-transparent -mb-px'
              : 'text-muted-foreground hover:text-foreground',
          ]}
        >
          Orders
        </a>
        <a
          href="/account?tab=settings"
          class:list={[
            'px-4 py-2.5 text-sm font-medium rounded-t-lg transition',
            tab === 'settings'
              ? 'bg-card/60 text-foreground border border-border border-b-transparent -mb-px'
              : 'text-muted-foreground hover:text-foreground',
          ]}
        >
          Settings
        </a>
        <a
          href="/account?tab=membership"
          class:list={[
            'px-4 py-2.5 text-sm font-medium rounded-t-lg transition',
            tab === 'membership'
              ? 'bg-card/60 text-foreground border border-border border-b-transparent -mb-px'
              : 'text-muted-foreground hover:text-foreground',
          ]}
        >
          Membership
        </a>
        <a
          href="/account?tab=subscriptions"
          class:list={[
            'px-4 py-2.5 text-sm font-medium rounded-t-lg transition',
            tab === 'subscriptions'
              ? 'bg-card/60 text-foreground border border-border border-b-transparent -mb-px'
              : 'text-muted-foreground hover:text-foreground',
          ]}
        >
          Subscriptions
        </a>
      </div>

      <!-- Orders Tab -->
      {tab === 'orders' && (
        <div class="space-y-4">
          {(!orders || orders.length === 0) ? (
            <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm p-8 text-center">
              <p class="text-muted-foreground mb-4">You have not placed any orders yet.</p>
              <a href="/products" class="inline-flex items-center justify-center rounded-lg bg-primary px-6 py-2.5 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition">
                Browse Cans
              </a>
            </div>
          ) : (
            orders.map((order: any) => {
              const canCancel = ['pending', 'confirmed', 'open', 'approved'].includes(order.checkout_status);
              return (
                <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm p-5">
                  <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                    <div>
                      <span class="text-sm text-muted-foreground">Order</span>
                      <span class="ml-1.5 font-mono text-sm font-medium">
                        #{order.nyehandel_order_id || order.id.slice(0, 8)}
                      </span>
                    </div>
                    <span class:list={['px-2.5 py-0.5 rounded-full text-xs font-medium', statusColor(order.checkout_status)]}>
                      {order.checkout_status}
                    </span>
                  </div>
                  <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
                    <span>{new Date(order.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                    <span>{order.currency} {order.total_price.toFixed(2)}</span>
                    {order.tracking_url && (
                      <a href={order.tracking_url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                        Track shipment
                      </a>
                    )}
                    {canCancel && (
                      <button
                        type="button"
                        class="text-destructive/70 hover:text-destructive transition text-sm"
                        data-cancel-order={order.id}
                        data-order-display={order.nyehandel_order_id || order.id.slice(0, 8)}
                        data-order-amount={`${order.currency} ${order.total_price.toFixed(2)}`}
                      >
                        Cancel Order
                      </button>
                    )}
                    {order.line_items_snapshot && (
                      <button
                        type="button"
                        class="text-primary/70 hover:text-primary transition text-sm"
                        data-reorder={JSON.stringify(order.line_items_snapshot)}
                      >
                        Reorder
                      </button>
                    )}
                  </div>
                </div>
              );
            })
          )}
        </div>
      )}

      <!-- Settings Tab -->
      {tab === 'settings' && (
        <div class="space-y-8">
          {/* Profile Form */}
          <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm p-6">
            <h2 class="text-lg font-semibold mb-4">Profile</h2>

            {profileResult?.error && (
              <div class="rounded-lg bg-destructive/10 border border-destructive/30 p-3 mb-4 text-sm text-destructive">
                {profileResult.error.message}
              </div>
            )}
            {profileResult?.data?.success && (
              <div class="rounded-lg bg-emerald-500/10 border border-emerald-500/30 p-3 mb-4 text-sm text-emerald-400">
                Profile updated successfully.
              </div>
            )}

            <form method="POST" action={actions.account.updateProfile} class="space-y-4">
              <div>
                <label for="email" class="block text-sm font-medium text-muted-foreground mb-1.5">Email</label>
                <input
                  type="email"
                  id="email"
                  value={user.email}
                  disabled
                  class="w-full rounded-lg border border-border bg-muted/30 px-3 py-2 text-sm text-muted-foreground cursor-not-allowed"
                />
              </div>
              <div>
                <label for="fullName" class="block text-sm font-medium text-muted-foreground mb-1.5">Full Name</label>
                <input
                  type="text"
                  id="fullName"
                  name="fullName"
                  value={fullName}
                  required
                  class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary/50"
                />
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium text-muted-foreground mb-1.5">Phone (optional)</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  value={phone}
                  class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary/50"
                />
              </div>
              <button
                type="submit"
                class="rounded-lg bg-primary px-5 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition"
              >
                Save Changes
              </button>
            </form>
          </div>

          {/* Change Password Form */}
          <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm p-6">
            <h2 class="text-lg font-semibold mb-4">Change Password</h2>

            {passwordResult?.error && (
              <div class="rounded-lg bg-destructive/10 border border-destructive/30 p-3 mb-4 text-sm text-destructive">
                {passwordResult.error.message}
              </div>
            )}
            {passwordResult?.data?.success && (
              <div class="rounded-lg bg-emerald-500/10 border border-emerald-500/30 p-3 mb-4 text-sm text-emerald-400">
                Password changed successfully.
              </div>
            )}

            <form method="POST" action={actions.account.changePassword} class="space-y-4" id="change-password-form">
              <div>
                <label for="newPassword" class="block text-sm font-medium text-muted-foreground mb-1.5">New Password</label>
                <input
                  type="password"
                  id="newPassword"
                  name="newPassword"
                  required
                  minlength="8"
                  class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary/50"
                />
              </div>
              <div>
                <label for="confirmPassword" class="block text-sm font-medium text-muted-foreground mb-1.5">Confirm Password</label>
                <input
                  type="password"
                  id="confirmPassword"
                  name="confirmPassword"
                  required
                  minlength="8"
                  class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary/50"
                />
                <p id="pw-mismatch" class="text-sm text-destructive mt-1 hidden">Passwords do not match</p>
              </div>
              <button
                type="submit"
                class="rounded-lg bg-primary px-5 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition"
              >
                Change Password
              </button>
            </form>
          </div>

          {/* Logout */}
          <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm p-6">
            <h2 class="text-lg font-semibold mb-4">Sign Out</h2>
            <p class="text-sm text-muted-foreground mb-4">Sign out of your account on this device.</p>
            <form method="POST" action={actions.auth.logout}>
              <button
                type="submit"
                class="rounded-lg border border-border px-5 py-2 text-sm font-medium text-foreground hover:bg-muted/50 transition"
              >
                Sign Out
              </button>
            </form>
          </div>
        </div>
      )}

      <!-- Membership Tab -->
      {tab === 'membership' && (
        <div class="space-y-6">
          <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm p-6">
            <div class="flex items-center justify-between mb-6">
              <h2 class="text-lg font-semibold">{tenant.loyaltyProgramName}</h2>
              <span class="px-3 py-1 rounded-full bg-primary/20 text-primary text-sm font-medium">
                {tier.name}
              </span>
            </div>

            <div class="grid grid-cols-2 gap-4 mb-6">
              <div class="rounded-lg bg-background/50 p-4 text-center">
                <p class="text-2xl font-bold text-primary">{balance.toLocaleString()}</p>
                <p class="text-xs text-muted-foreground mt-1">Available Points</p>
              </div>
              <div class="rounded-lg bg-background/50 p-4 text-center">
                <p class="text-2xl font-bold">{lifetime.toLocaleString()}</p>
                <p class="text-xs text-muted-foreground mt-1">Lifetime Earned</p>
              </div>
            </div>

            {tier.next && (
              <div>
                <div class="flex justify-between text-xs text-muted-foreground mb-1.5">
                  <span>{tier.name}</span>
                  <span>{tier.next} ({tier.threshold.toLocaleString()} pts)</span>
                </div>
                <div class="w-full h-2 bg-background/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-primary rounded-full transition-all"
                    style={`width: ${progress}%`}
                  />
                </div>
                <p class="text-xs text-muted-foreground mt-2">
                  {(tier.threshold - lifetime).toLocaleString()} points to {tier.next}
                </p>
              </div>
            )}

            {!tier.next && (
              <p class="text-sm text-primary">
                You have reached the highest tier. Thank you for your loyalty!
              </p>
            )}
          </div>

          <!-- Achievements -->
          <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm p-6">
            <AchievementGridIsland client:visible />
          </div>

          <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm p-6">
            <h3 class="text-sm font-semibold mb-3">How to Earn Points</h3>
            <ul class="space-y-2 text-sm text-muted-foreground">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
                Place orders — earn 1 point per EUR spent
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
                Write product reviews — earn 50 points each
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
                Complete quests and challenges for bonus points
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
                Refer a friend — both earn points
              </li>
            </ul>
          </div>

          <!-- Referral Program -->
          {referralCode && (
            <div class="rounded-xl border border-primary/20 bg-primary/5 backdrop-blur-sm p-6">
              <h3 class="text-sm font-semibold mb-3">Refer a Friend</h3>
              <p class="text-sm text-muted-foreground mb-4">
                Share your code with friends. They get 50 SnusPoints, you get 100 — everyone wins.
              </p>
              <div class="flex items-center gap-2 mb-4">
                <div class="flex-1 rounded-lg border border-border bg-background px-4 py-2.5 font-mono text-sm text-foreground select-all">
                  {referralCode}
                </div>
                <button
                  type="button"
                  id="copy-referral-btn"
                  data-code={referralCode}
                  class="shrink-0 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition"
                >
                  Copy
                </button>
              </div>
              <div class="flex items-center gap-4 text-xs text-muted-foreground">
                <span>{referralCount ?? 0} friend{(referralCount ?? 0) !== 1 ? 's' : ''} referred</span>
                <span>{((referralCount ?? 0) * 100).toLocaleString()} points earned</span>
              </div>
              <div class="flex gap-2 mt-4">
                <a
                  href={`https://wa.me/?text=${encodeURIComponent(`Join SnusFriend and get 50 bonus points! Use my code: ${referralCode} — https://snusfriends.com/register?ref=${referralCode}`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 rounded-lg border border-border bg-background px-3 py-2 text-center text-xs font-medium text-foreground hover:bg-muted transition"
                >
                  WhatsApp
                </a>
                <a
                  href={`mailto:?subject=Join SnusFriend&body=${encodeURIComponent(`Hey! Join SnusFriend and get 50 bonus points. Use my referral code: ${referralCode}\n\nhttps://snusfriends.com/register?ref=${referralCode}`)}`}
                  class="flex-1 rounded-lg border border-border bg-background px-3 py-2 text-center text-xs font-medium text-foreground hover:bg-muted transition"
                >
                  Email
                </a>
              </div>
            </div>
          )}
        </div>
      )}

      <!-- Subscriptions Tab -->
      {tab === 'subscriptions' && (
        <div class="space-y-4">
          {(!subscriptions || subscriptions.length === 0) ? (
            <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm p-8 text-center">
              <p class="text-muted-foreground mb-2">No active subscriptions.</p>
              <p class="text-sm text-muted-foreground mb-4">
                Subscribe to your favourite products and save up to 15% on every delivery.
              </p>
              <a href="/products" class="inline-flex items-center justify-center rounded-lg bg-primary px-6 py-2.5 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition">
                Browse Products
              </a>
            </div>
          ) : (
            subscriptions.map((sub: any) => (
              <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm p-5">
                <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                  <div>
                    <a href={`/products/${sub.product_slug}`} class="text-sm font-semibold text-foreground hover:text-primary transition">
                      {sub.product_name || sub.product_slug}
                    </a>
                    <div class="flex items-center gap-2 mt-1 text-xs text-muted-foreground">
                      <span>{sub.interval === 'monthly' ? 'Monthly' : 'Every 6 months'}</span>
                      <span class="text-primary font-medium">{sub.discount_pct}% off</span>
                    </div>
                  </div>
                  <span class:list={[
                    'px-2.5 py-0.5 rounded-full text-xs font-medium',
                    sub.status === 'active' ? 'bg-primary/20 text-primary' :
                    sub.status === 'paused' ? 'bg-muted text-muted-foreground' :
                    'bg-destructive/20 text-destructive'
                  ]}>
                    {sub.status}
                  </span>
                </div>
                <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
                  {sub.status === 'active' && sub.next_order_at && (
                    <span>Next delivery: {new Date(sub.next_order_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                  )}
                  {sub.status === 'active' && (
                    <button type="button" class="text-muted-foreground hover:text-foreground transition text-sm" data-sub-action="pause" data-sub-id={sub.id}>
                      Pause
                    </button>
                  )}
                  {sub.status === 'paused' && (
                    <button type="button" class="text-primary hover:text-primary/80 transition text-sm" data-sub-action="resume" data-sub-id={sub.id}>
                      Resume
                    </button>
                  )}
                  {sub.status !== 'cancelled' && (
                    <button type="button" class="text-destructive/70 hover:text-destructive transition text-sm" data-sub-action="cancel" data-sub-id={sub.id}>
                      Cancel
                    </button>
                  )}
                </div>
              </div>
            ))
          )}
        </div>
      )}
    </div>
  </section>
</Shop>

<!-- Cancel Order Confirmation Dialog -->
<dialog id="cancel-dialog" class="bg-card border border-border rounded-xl shadow-xl p-6 max-w-md w-full backdrop:bg-black/50 text-foreground">
  <h2 class="text-lg font-semibold mb-2" id="cancel-dialog-title">Cancel Order?</h2>
  <p class="text-sm text-muted-foreground mb-4" id="cancel-dialog-body">
    Are you sure you want to cancel this order? If it hasn't been picked and packed yet, we'll cancel it right away and start your refund.
  </p>
  <p class="text-sm text-muted-foreground mb-4">
    <strong class="text-foreground">Refund timeline:</strong> Once cancelled, your refund will be processed within 3–5 business days back to your original payment method.
  </p>
  <div class="mb-4">
    <label for="cancel-reason" class="block text-sm font-medium text-muted-foreground mb-1">Why are you cancelling? (optional)</label>
    <input
      type="text"
      id="cancel-reason"
      placeholder="Changed my mind, ordered the wrong item…"
      class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary/50"
    />
  </div>
  <div id="cancel-error" class="hidden rounded-lg bg-destructive/10 border border-destructive/30 p-3 mb-4 text-sm text-destructive"></div>
  <div id="cancel-success" class="hidden rounded-lg bg-emerald-500/10 border border-emerald-500/30 p-3 mb-4 text-sm text-emerald-400"></div>
  <div class="flex gap-3 justify-end" id="cancel-dialog-actions">
    <button type="button" id="cancel-dialog-close" class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground hover:bg-muted/50 transition">
      Keep My Order
    </button>
    <button type="button" id="cancel-dialog-confirm" class="rounded-lg bg-destructive px-4 py-2 text-sm font-medium text-destructive-foreground hover:bg-destructive/90 transition">
      Yes, Cancel My Order
    </button>
  </div>
</dialog>

<!-- Progressive enhancement: client-side interactions -->
<script>
  // Copy referral code
  const copyBtn = document.getElementById('copy-referral-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const code = copyBtn.dataset.code ?? '';
      try {
        await navigator.clipboard.writeText(code);
        copyBtn.textContent = 'Copied!';
        setTimeout(() => { copyBtn.textContent = 'Copy'; }, 2000);
      } catch {
        copyBtn.textContent = 'Failed';
        setTimeout(() => { copyBtn.textContent = 'Copy'; }, 2000);
      }
    });
  }

  // Password match check
  const form = document.getElementById('change-password-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      const pw = (document.getElementById('newPassword') as HTMLInputElement)?.value;
      const cpw = (document.getElementById('confirmPassword') as HTMLInputElement)?.value;
      const msg = document.getElementById('pw-mismatch');
      if (pw !== cpw) {
        e.preventDefault();
        msg?.classList.remove('hidden');
      } else {
        msg?.classList.add('hidden');
      }
    });
  }

  // Cancel order dialog
  const dialog = document.getElementById('cancel-dialog') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('cancel-dialog-close');
  const confirmBtn = document.getElementById('cancel-dialog-confirm');
  const titleEl = document.getElementById('cancel-dialog-title');
  const errorEl = document.getElementById('cancel-error');
  const successEl = document.getElementById('cancel-success');
  const actionsEl = document.getElementById('cancel-dialog-actions');
  const reasonInput = document.getElementById('cancel-reason') as HTMLInputElement | null;
  let currentOrderId = '';

  document.querySelectorAll('[data-cancel-order]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const orderId = (btn as HTMLElement).dataset.cancelOrder ?? '';
      const orderDisplay = (btn as HTMLElement).dataset.orderDisplay ?? '';
      const orderAmount = (btn as HTMLElement).dataset.orderAmount ?? '';
      currentOrderId = orderId;
      if (titleEl) titleEl.textContent = `Cancel Order #${orderDisplay}?`;
      if (errorEl) { errorEl.classList.add('hidden'); errorEl.textContent = ''; }
      if (successEl) successEl.classList.add('hidden');
      if (actionsEl) actionsEl.classList.remove('hidden');
      if (reasonInput) reasonInput.value = '';
      if (confirmBtn) { confirmBtn.textContent = 'Yes, Cancel My Order'; (confirmBtn as HTMLButtonElement).disabled = false; }
      dialog?.showModal();
    });
  });

  closeBtn?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

  confirmBtn?.addEventListener('click', async () => {
    if (!currentOrderId) return;
    const btn = confirmBtn as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Cancelling…';
    if (errorEl) { errorEl.classList.add('hidden'); errorEl.textContent = ''; }

    try {
      const supabaseUrl = (document.querySelector('meta[name="supabase-url"]') as HTMLMetaElement)?.content
        || import.meta.env.PUBLIC_SUPABASE_URL;
      const token = document.cookie.split(';').map(c => c.trim()).find(c => c.startsWith('sb-access-token='))?.split('=')[1] ?? '';

      const res = await fetch(`${supabaseUrl}/functions/v1/cancel-nyehandel-order`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`,
        },
        body: JSON.stringify({
          order_id: currentOrderId,
          reason: reasonInput?.value || undefined,
        }),
      });

      if (res.ok) {
        if (actionsEl) actionsEl.classList.add('hidden');
        if (successEl) {
          successEl.textContent = 'Order cancelled. Your refund will be processed within 3–5 business days. Reloading…';
          successEl.classList.remove('hidden');
        }
        setTimeout(() => window.location.reload(), 2000);
      } else {
        const data = await res.json().catch(() => ({}));
        const msg = data.message || data.error || 'Could not cancel this order. Please contact support.';
        if (errorEl) { errorEl.textContent = msg; errorEl.classList.remove('hidden'); }
        btn.disabled = false;
        btn.textContent = 'Yes, Cancel My Order';
      }
    } catch {
      if (errorEl) { errorEl.textContent = 'Network error. Please try again.'; errorEl.classList.remove('hidden'); }
      btn.disabled = false;
      btn.textContent = 'Yes, Cancel My Order';
    }
  });

  // Reorder buttons
  document.querySelectorAll('[data-reorder]').forEach((btn) => {
    btn.addEventListener('click', () => {
      try {
        const raw = (btn as HTMLElement).dataset.reorder;
        if (!raw) return;
        const snapshot = typeof raw === 'string' ? JSON.parse(raw) : raw;
        if (!Array.isArray(snapshot) || snapshot.length === 0) return;

        // Read existing cart from localStorage
        const cartKey = 'snusfriend_cart';
        const existing = JSON.parse(localStorage.getItem(cartKey) || '[]');

        for (const item of snapshot) {
          // SKU format: "{productSlug}-{packSize}" e.g. "zyn-cool-mint-6mg-pack3"
          const sku = item.sku || '';
          const lastDash = sku.lastIndexOf('-');
          if (lastDash === -1) continue;
          const slug = sku.slice(0, lastDash);
          const packSize = sku.slice(lastDash + 1);
          if (!slug || !packSize.startsWith('pack')) continue;

          const qty = item.quantity ?? 1;
          const price = item.unit_price ?? 0;
          const name = item.product_name ?? 'Product';

          // Build minimal product for the cart store
          const cartItem = {
            product: {
              id: slug,
              name: name,
              brand: '',
              categoryKey: 'nicotinePouches',
              flavorKey: 'mint',
              strengthKey: 'normal',
              formatKey: 'slim',
              nicotineContent: 0,
              portionsPerCan: 20,
              descriptionKey: '',
              image: '',
              ratings: 0,
              badgeKeys: [],
              prices: { [packSize]: price, pack1: price, pack3: 0, pack5: 0, pack10: 0, pack30: 0 },
              manufacturer: '',
              stock: 99,
            },
            packSize: packSize,
            quantity: qty,
          };

          // Check if already in cart
          const existingIdx = existing.findIndex(
            (c: any) => c.product?.id === slug && c.packSize === packSize
          );
          if (existingIdx >= 0) {
            existing[existingIdx].quantity += qty;
          } else {
            existing.push(cartItem);
          }
        }

        localStorage.setItem(cartKey, JSON.stringify(existing));
        window.location.href = '/cart';
      } catch (e) {
        console.error('Reorder failed:', e);
      }
    });
  });

  // Subscription management buttons
  document.querySelectorAll('[data-sub-action]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const action = (btn as HTMLElement).dataset.subAction;
      const subId = (btn as HTMLElement).dataset.subId;
      if (!action || !subId) return;

      const confirmed = action === 'cancel'
        ? confirm('Cancel this subscription? You can always create a new one later.')
        : true;
      if (!confirmed) return;

      (btn as HTMLButtonElement).disabled = true;
      (btn as HTMLButtonElement).textContent = action === 'pause' ? 'Pausing...' : action === 'resume' ? 'Resuming...' : 'Cancelling...';

      try {
        const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
        const cookies = document.cookie.split(';');
        const authCookies = cookies.filter(c => c.trim().match(/^sb-.*-auth-token/));
        const token = authCookies.length > 0 ? authCookies[0].split('=').slice(1).join('=').trim() : '';

        const res = await fetch(`${supabaseUrl}/functions/v1/manage-subscription`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ action, subscription_id: subId }),
        });

        if (res.ok) {
          window.location.reload();
        } else {
          alert('Something went wrong. Please try again.');
          (btn as HTMLButtonElement).disabled = false;
          (btn as HTMLButtonElement).textContent = action.charAt(0).toUpperCase() + action.slice(1);
        }
      } catch {
        alert('Network error. Please try again.');
        (btn as HTMLButtonElement).disabled = false;
      }
    });
  });
</script>
