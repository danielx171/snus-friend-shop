---
import { ClientRouter } from 'astro:transitions';
import { tenant, validThemes } from '@/config/tenant';
import SEO from '@/components/astro/SEO.astro';
import Analytics from '@/components/astro/Analytics.astro';
import '@/index.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  noindex?: boolean;
  class?: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang={'en'} class={tenant.theme.darkModeClass}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/png" href={tenant.assets.favicon} />
  <link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />
  <!-- Only preload the primary body font — others load async via @font-face -->
  <link rel="preload" href="/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preconnect" href="https://bozdnoctcszbhemdjsek.supabase.co" crossorigin />
  <link rel="alternate" type="application/rss+xml" title="SnusFriend Blog" href="/rss.xml" />
  <link rel="preconnect" href="https://nycdn.nyehandel.se" />
  <link rel="author" type="text/plain" href="/llms.txt" />
  <link rel="alternate" hreflang="en" href={`https://snusfriends.com${Astro.url.pathname}`} />
  <link rel="alternate" hreflang="x-default" href={`https://snusfriends.com${Astro.url.pathname}`} />
  <meta name="theme-color" content="#f5f3ef" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#161622" media="(prefers-color-scheme: dark)" />

  <SEO
    title={props.title}
    description={props.description}
    ogImage={props.ogImage}
    ogType={props.ogType}
    canonical={props.canonical}
    noindex={props.noindex}
  />

  <Analytics />
  <ClientRouter />

  <!-- Guard against Chrome 146+ InvalidStateError in View Transitions (Sentry SNUSFRIENDS-3) -->
  <script is:inline>
    (function() {
      var origReplaceState = history.replaceState;
      history.replaceState = function() {
        try { return origReplaceState.apply(this, arguments); }
        catch(e) { if (e.name !== 'InvalidStateError') throw e; }
      };
    })();
  </script>

  <script is:inline define:vars={{ storageKey: tenant.storage.themeKey, defaultTheme: tenant.theme.darkModeClass, validThemeList: validThemes }}>
    (function() {
      try {
        var raw = localStorage.getItem(storageKey);
        try { var stored = raw ? JSON.parse(raw) : null; } catch(e) { var stored = raw; }
        var theme = (stored && validThemeList.indexOf(stored) !== -1) ? stored : defaultTheme;
        document.documentElement.classList.add(theme);
        window.__validThemes = validThemeList;
      } catch(e) {
        document.documentElement.classList.add(defaultTheme);
      }
    })();
  </script>
  <script is:inline>
    window.addEventListener('error',function(e){if(e.message&&e.message.includes('Importing a module script failed')){if(!sessionStorage.getItem('sf_reload')){sessionStorage.setItem('sf_reload','1');window.location.reload()}}});sessionStorage.removeItem('sf_reload');
  </script>
</head>
<body class:list={['min-h-screen bg-background text-foreground antialiased', props.class]}>
  <slot />

  <script>
    import { $theme } from '@/stores/theme';

    document.addEventListener('astro:page-load', () => {
      const theme = $theme.get();
      const root = document.documentElement;
      root.classList.remove(...(window.__validThemes ?? ['forest', 'copper']));
      root.classList.add(theme);

      // Fire PostHog page view on SPA-style navigations (View Transitions)
      if (window.posthog) {
        window.posthog.capture('$pageview');
      }
    });
  </script>
</body>
</html>
