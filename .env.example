# Frontend — Astro public env vars (PUBLIC_ prefix)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_TENANT_ID=             # Preferred public tenant selector for white-label storefront deploys
PUBLIC_SITE_URL=
PUBLIC_SENTRY_DSN=             # Sentry DSN (only active in production)
PUBLIC_POSTHOG_KEY=            # Required per storefront if PostHog pageview/product analytics should boot
PUBLIC_POSTHOG_HOST=           # Required PostHog host for that storefront (default: https://us.i.posthog.com)
PUBLIC_GA_MEASUREMENT_ID=      # Google Analytics 4 measurement ID (G-XXXXXXXXXX)
PUBLIC_GOOGLE_SITE_VERIFICATION= # Search Console URL-prefix verification token (optional)

# Server-only (Astro build + SSR, no prefix)
TENANT_ID=                    # Canonical tenant selector for Astro + Supabase functions
SITE_URL=                      # Shared canonical site URL for Astro + Supabase functions (preferred for white-label deploys)
SITE_NAME=                     # Shared storefront name for email/ops branding (e.g. SnusFriend)
JURISDICTION=                  # Optional legal jurisdiction label (default: Sweden)
DPA_NAME=                      # Optional supervisory authority label (default: Swedish Authority for Privacy Protection (IMY))
DPA_URL=                       # Optional supervisory authority URL (default: https://www.imy.se)
FOUNDER_NAME=                  # Optional founder name for /about and organization schema
DEFAULT_AUTHOR_NAME=           # Optional default editorial byline name
DEFAULT_AUTHOR_JOB_TITLE=      # Optional default editorial role/title
DEFAULT_AUTHOR_BIO=            # Optional short author bio for editorial surfaces
DEFAULT_AUTHOR_SAME_AS=        # Optional comma-separated author social/profile URLs
DEFAULT_AUTHOR_SLUG=           # Optional default author slug for /authors/[slug]
DEFAULT_AUTHOR_CREDENTIALS=    # Optional comma-separated editorial credentials
LOYALTY_CURRENCY_NAME=         # Optional customer-facing loyalty currency label (default: SnusCoins)
ORDER_PREFIX=                  # Optional order reference prefix for this storefront (default: NB)
ORDER_LOCALE=                  # Optional Nyehandel locale string for this storefront (default: en-gb)
STOREFRONT_HOSTS=              # Comma-separated storefront hosts/origins allowed for this deployment
TENANT_STORAGE_PREFIX=         # Optional client-storage prefix override if multiple storefronts share a browser
SUPABASE_URL=                  # Same value as PUBLIC_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=     # Service role key for Content Layer build-time fetch
PAGESPEED_API_KEY=             # Server-safe Google PageSpeed Insights API key for local audits + sync scripts
GOOGLE_APPLICATION_CREDENTIALS= # Local path to a read-only Google credential JSON for GA4/GSC scripts
GOOGLE_SERVICE_ACCOUNT_KEY_PATH= # Optional explicit override for the credential file path
GA4_PROPERTY_ID=               # Numeric GA4 property id (e.g. 123456789)
SEARCH_CONSOLE_PROPERTY=       # Search Console property id (e.g. sc-domain:example.com)
DATAFORSEO_LOGIN=              # DataForSEO API login for proactive SERP snapshots in `bun run audit:rank` (paid SaaS account)
DATAFORSEO_PASSWORD=           # DataForSEO API password for proactive SERP snapshots in `bun run audit:rank` (paid SaaS account)
DATAFORSEO_LOCATION_CODE=2752  # Optional Google location code override for DataForSEO rank snapshots (default: Sweden)
DATAFORSEO_LANGUAGE_CODE=en    # Optional language code override for DataForSEO rank snapshots (default: English)
GOOGLE_CUSTOM_SEARCH_API_KEY=  # Legacy — no longer read by `audit:rank` after the DataForSEO migration

# Legacy VITE_ vars (kept during migration, remove after Phase 6)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TENANT_ID=
VITE_SITE_URL=
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Anything sensitive should NOT go here.
# Keep secrets ONLY in Supabase Edge Function secrets (Dashboard → Settings → Vault):
# - SUPABASE_SERVICE_ROLE_KEY        # service role for all edge functions
# - SUPABASE_ANON_KEY                # anon key for verify-admin, ops-users, ops-set-role, nyehandel-proxy
# - NYEHANDEL_API_URL                # Nyehandel API base URL (e.g. https://api.nyehandel.se)
# - NYEHANDEL_API_TOKEN              # Nyehandel Bearer token
# - NYEHANDEL_X_IDENTIFIER           # Nyehandel account identifier header
# - NYEHANDEL_WEBHOOK_SECRET         # x-api-key for nyehandel-webhook auth
# - DELIVERY_WEBHOOK_SECRET          # shared secret for nyehandel-delivery-callback auth (REQUIRED — without it all delivery callbacks are accepted)
# - ALLOWED_ORIGINS                  # Comma-separated storefront origins for checkout/discount CORS (preferred for multi-domain)
# - ALLOWED_ORIGIN                   # Legacy single-origin fallback if ALLOWED_ORIGINS is not set
# - TENANT_ID                        # Shared tenant selector used by Astro + Supabase functions
# - PUBLIC_TENANT_ID                 # Public tenant selector fallback for the storefront deployment
# - STOREFRONT_HOSTS                 # Canonical storefront host/origin allowlist for white-label deploys
# - TENANT_STORAGE_PREFIX            # Optional browser-storage prefix for multi-store same-browser usage
# - SITE_URL                         # Canonical storefront URL for Supabase functions (preferred over PUBLIC_/VITE_ inside functions)
# - SITE_NAME                        # Storefront brand name used by transactional emails + ops hooks
# - JURISDICTION                     # Optional legal jurisdiction label for tenant-specific legal copy
# - DPA_NAME                         # Optional supervisory authority label for privacy/legal copy
# - DPA_URL                          # Optional supervisory authority URL for privacy/legal copy
# - FOUNDER_NAME                     # Optional founder name for /about + Organization schema
# - DEFAULT_AUTHOR_NAME              # Optional default author name for editorial surfaces
# - DEFAULT_AUTHOR_JOB_TITLE         # Optional default author role/title
# - DEFAULT_AUTHOR_BIO               # Optional default author bio
# - DEFAULT_AUTHOR_SAME_AS           # Optional comma-separated social/profile URLs for the default author
# - DEFAULT_AUTHOR_SLUG              # Optional default author slug for /authors/[slug]
# - DEFAULT_AUTHOR_CREDENTIALS       # Optional comma-separated default author credentials
# - LOYALTY_CURRENCY_NAME            # Optional customer-facing loyalty currency label (default: SnusCoins)
# - ORDER_PREFIX                     # Optional order reference prefix for the storefront (default: NB)
# - ORDER_LOCALE                     # Optional Nyehandel locale string for the storefront (default: en-gb)
# - EMAIL_FROM_NAME                  # Friendly sender name for Resend mail (defaults to SITE_NAME)
# - EMAIL_FROM_ADDRESS               # Sender mailbox for Resend mail (defaults to noreply@<site host>)
# - SUPPORT_EMAIL                    # Customer-facing support inbox used in transactional mail + contact form
# - SYNC_CRON_SECRET                 # auth for pg_cron auto-sync invocations
# - INTERNAL_FUNCTIONS_SECRET        # x-internal-function-secret for push-order-to-nyehandel
# - RETRY_FAILED_ORDERS_SECRET       # x-cron-secret for retry-failed-nyehandel-orders
# - OPS_ALERTS_CRON_SECRET           # x-cron-secret for ops-b2b-queues
# - PAYMENT_METHOD_NAME              # Exact checkout/payment method label required by this Nyehandel merchant
# - DISCORD_WEBHOOK_REVIEWS          # Discord webhook URL for #reviews notifications
# - DISCORD_WEBHOOK_ACHIEVEMENTS     # Discord webhook URL for #achievements notifications
# - DEEPSEEK_API_KEY                 # DeepSeek API key for generate-review-summary AI summaries
#
# Also seed sync_config table after migration:
#   INSERT INTO sync_config (key, value) VALUES
#     ('supabase_project_url', 'https://<ref>.supabase.co'),
#     ('sync_cron_secret', '<same-as-SYNC_CRON_SECRET>');
